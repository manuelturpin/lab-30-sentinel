{
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "hooks": {
    "FileChanged": [
      {
        "matcher": "",
        "if": "Edit(package.json|package-lock.json|requirements.txt|Dockerfile|go.mod|Gemfile.lock|Cargo.lock|pom.xml|pyproject.toml)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️ Dependencies changed — consider running /sentinel-security'",
            "description": "Sentinel: alert when dependency files change"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.sentinel/logs && echo \"[$(date '+%Y-%m-%d %H:%M:%S')] Agent failed — reason: ${CLAUDE_STOP_REASON:-unknown}\" >> ~/.sentinel/logs/agent-failures.log",
            "description": "Sentinel: log agent failures for diagnostics"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p ~/.sentinel/logs && echo \"[$(date '+%Y-%m-%d %H:%M:%S')] Session compacted — partial scan results may need re-collection\" >> ~/.sentinel/logs/compaction.log",
            "description": "Sentinel: log compaction events for scan resilience"
          }
        ]
      }
    ]
  }
}
