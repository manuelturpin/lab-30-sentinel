for rid,rel in files.items():
 data=json.loads(subprocess.check_output([\"git\",\"-C\",\"../..\",\"show\",\"de4c554:\"+rel],text=True)); rule=next(x for x in data if x[\"id\"]==rid); d=rule[\"detect\"]
 pos=[re.compile(p) for p in d[\"patterns\"]]; neg=[re.compile(p) for p in d.get(\"negative_patterns\",[])]
 print(rid,\"compiled_pos\",len(pos),\"compiled_neg\",len(neg))
 for name,text in cases.items():
  raw=sum(1 for line in text.splitlines() for rx in pos if rx.search(line)); sup=any(rx.search(text) for rx in neg)
  print(name,\"raw_matches\",raw,\"file_suppressed\",sup,\"effective_matches\",0 if sup else raw)
