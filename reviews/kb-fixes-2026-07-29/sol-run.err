    14	// SAFE: TLS with proper certificate verification
    15	func secureClient() *http.Client {
    16		caCert, _ := os.ReadFile("/etc/ssl/certs/ca-certificates.crt")
    17		caCertPool := x509.NewCertPool()
    18		caCertPool.AppendCertsFromPEM(caCert)
    19	
    20		transport := &http.Transport{
    21			TLSClientConfig: &tls.Config{
    22				RootCAs:    caCertPool,
    23				MinVersion: tls.VersionTLS12,
    24			},
    25		}
    26		return &http.Client{Transport: transport}
    27	}
    28	
    29	// SAFE: Strong TLS configuration
    30	func secureTLS() *tls.Config {
    31		return &tls.Config{
    32			MinVersion: tls.VersionTLS12,
    33			CipherSuites: []uint16{
    34				tls.TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,
    35				tls.TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,
    36			},
    37		}
    38	}
    39	
    40	// SAFE: Authentication middleware present
    41	func requireAuthMiddleware(next http.Handler) http.Handler {
    42		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
    43			token := r.Header.Get("Authorization")
    44			if !verifyToken(token) {
    45				http.Error(w, "Unauthorized", http.StatusUnauthorized)
    46				return
    47			}
    48			next.ServeHTTP(w, r)
    49		})
    50	}
    51	
