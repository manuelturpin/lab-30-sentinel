{
  "id": "WEB-AC-001",
  "severity": "CRITICAL",
  "cvss_v4": 9.1,
  "category": "web-app",
  "subcategory": "access-control",
  "title": "Missing authorization check on route handler",
  "description": "Route handler processes requests without verifying the user's authorization level. Any authenticated (or unauthenticated) user may access protected resources.",
  "detect": {
    "patterns": [],
    "negative_patterns": [
      "isAuthenticated",
      "requireAuth",
      "authorize",
      "checkPermission",
      "protect",
      "guard",
      "middleware.*auth"
    ],
    "file_types": [
      "*.js",
      "*.ts",
      "*.mjs"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build",
      "test",
      "__test__"
    ]
  },
  "remediation": {
    "description": "Add authentication and authorization middleware to all route handlers. Use role-based or attribute-based access control.",
    "code_example": "router.get('/admin/users', requireAuth, requireRole('admin'), async (req, res) => { ... })",
    "references": [
      "https://cheatsheetseries.owasp.org/cheatsheets/Authorization_Cheat_Sheet.html"
    ]
  },
  "standards": [
    "CWE-862",
    "OWASP-A01:2025"
  ],
  "ai_specific": false,
  "frameworks": [
    "express",
    "fastify",
    "koa",
    "hono"
  ],
  "detection_method": "semantic",
  "detection_note": "Une absence de contrôle ne se détecte pas par un motif de présence : ces patterns matchaient toute route Express, sécurisée ou non, soit 100 % de faux positifs sur du code sain. Patterns vidés le 2026-07-29 ; la règle reste comme consigne pour la passe sémantique de l'agent, qui peut, lui, constater qu'aucun middleware d'auth n'est monté sur la route."
}
{
  "id": "WEB-CRYPTO-002",
  "severity": "HIGH",
  "cvss_v4": 7.4,
  "category": "web-app",
  "subcategory": "cryptographic-failures",
  "title": "Insecure cookie configuration",
  "description": "Session cookies set without HttpOnly, Secure, or SameSite flags, making them vulnerable to XSS theft or CSRF attacks.",
  "detect": {
    "patterns": [
      "(postgres|postgresql|mysql|mongodb(\\+srv)?|redis|amqp|mssql)://[A-Za-z0-9._%-]+:[^@/\\s'\"$]+@",
      "connectionString\\s*[:=]\\s*['\"][a-z+]+://[A-Za-z0-9._%-]+:[^@'\"$]+@"
    ],
    "file_types": [
      "*.js",
      "*.ts",
      "*.mjs"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build"
    ],
    "negative_patterns": [
      "# local only",
      "# example only"
    ]
  },
  "remediation": {
    "description": "Set HttpOnly, Secure, and SameSite flags on all session cookies.",
    "code_example": "res.cookie('session', token, { httpOnly: true, secure: true, sameSite: 'strict', maxAge: 3600000 });",
    "references": [
      "https://cheatsheetseries.owasp.org/cheatsheets/Session_Management_Cheat_Sheet.html"
    ]
  },
  "standards": [
    "CWE-614",
    "CWE-1004",
    "OWASP-A02:2025"
  ],
  "ai_specific": false,
  "frameworks": [
    "express",
    "fastify",
    "koa"
  ],
  "detection_note": "Les negative_patterns sont volontairement minimaux : le moteur les applique au FICHIER ENTIER, donc un motif large comme `\\$\\{` supprimerait la règle sur tout fichier contenant un template literal. L'exclusion de l'interpolation est portée par le motif positif lui-même ([^@/\\s'\"$]+ interdit le $ dans le segment mot de passe). Corrigé le 2026-07-29 après avoir reproduit ce bug de neutralisation croisée."
}
{
  "id": "WEB-INJ-008",
  "severity": "HIGH",
  "cvss_v4": 7.1,
  "category": "web-app",
  "subcategory": "xss",
  "title": "Reflected XSS — user input interpolated into an HTML response",
  "description": "User-controlled input is interpolated into an HTML string and returned in the response without escaping. Distinct from WEB-INJ-001, which only covers DOM-based sinks (innerHTML/outerHTML): this is the server-side reflected variant, where the payload never touches a DOM API on the server. Added 2026-07-29 after a benchmark showed the KB had no rule for this vector.",
  "detect": {
    "patterns": [
      "res\\.send\\(\\s*`[^`]*\\$\\{\\s*req\\.(query|params|body)",
      "`<[^`]*\\$\\{\\s*req\\.(query|params|body)[^`]*`",
      "res\\.(send|write|end)\\(\\s*['\"`][^'\"`]*\\+\\s*req\\.(query|params|body)"
    ],
    "negative_patterns": [
      "escapeHtml",
      "sanitize",
      "DOMPurify",
      "# local only"
    ],
    "file_types": [
      "*.js",
      "*.ts",
      "*.jsx",
      "*.tsx",
      "*.mjs"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "test"
    ]
  },
  "remediation": {
    "description": "Escape on output. Use a template engine with contextual auto-escaping, or an explicit escaper before interpolation. Setting Content-Type correctly and adding a Content-Security-Policy limits impact but does not fix the injection.",
    "code_example": "// WRONG\nres.send(`<div>${req.query.q}</div>`);\n\n// RIGHT\nimport escapeHtml from 'escape-html';\nres.send(`<div>${escapeHtml(req.query.q)}</div>`);",
    "references": [
      "https://owasp.org/Top10/A03_2021-Injection/"
    ]
  },
  "standards": [
    "CWE-79",
    "OWASP-A03:2021"
  ],
  "ai_specific": false,
  "frameworks": [
    "express",
    "fastify",
    "koa"
  ]
}
{
  "id": "WEB-CRYPTO-004",
  "severity": "CRITICAL",
  "cvss_v4": 9.1,
  "category": "web-app",
  "subcategory": "secrets",
  "title": "Hardcoded credentials inside a database connection string",
  "description": "A connection URI carries a username and password as literals in the source. WEB-CRYPTO-001 catches `key = \"...\"` assignments but not credentials embedded in a URI, which is how most database drivers are configured. Added 2026-07-29 after a benchmark miss.",
  "detect": {
    "patterns": [
      "(postgres|postgresql|mysql|mongodb(\\+srv)?|redis|amqp|mssql)://[A-Za-z0-9._%-]+:[^@/\\s'\"$]+@",
      "connectionString\\s*[:=]\\s*['\"][a-z+]+://[A-Za-z0-9._%-]+:[^@'\"$]+@"
    ],
    "negative_patterns": [
      "# local only",
      "# example only"
    ],
    "file_types": [
      "*.js",
      "*.ts",
      "*.py",
      "*.go",
      "*.rb",
      "*.java",
      "*.yaml",
      "*.yml",
      "*.json"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "test"
    ]
  },
  "remediation": {
    "description": "Move the URI to an environment variable and inject it at runtime. Rotate any credential that has been committed — removing it from the working tree does not remove it from git history.",
    "code_example": "// WRONG\nnew Pool({ connectionString: 'postgres://admin:password123@localhost:5432/mydb' });\n\n// RIGHT\nnew Pool({ connectionString: process.env.DATABASE_URL });",
    "references": [
      "https://cwe.mitre.org/data/definitions/798.html"
    ]
  },
  "standards": [
    "CWE-798",
    "CWE-259",
    "OWASP-A07:2021"
  ],
  "ai_specific": false,
  "frameworks": [],
  "detection_note": "Les negative_patterns sont volontairement minimaux : le moteur les applique au FICHIER ENTIER, donc un motif large comme `\\$\\{` supprimerait la règle sur tout fichier contenant un template literal. L'exclusion de l'interpolation est portée par le motif positif lui-même ([^@/\\s'\"$]+ interdit le $ dans le segment mot de passe). Corrigé le 2026-07-29 après avoir reproduit ce bug de neutralisation croisée. ID initialement attribué à WEB-CRYPTO-002, déjà pris par « Insecure cookie configuration » — collision détectée au contrôle d'intégrité et corrigée."
}
{
  "id": "DP-SECRET-002",
  "severity": "CRITICAL",
  "cvss_v4": 9.1,
  "category": "data-privacy",
  "subcategory": "secrets-at-rest",
  "title": "Secrets in a committed .env file",
  "description": "A .env file carries live-looking secret assignments and is present in the working tree. If it is tracked by git, every value is in the repository history and must be treated as compromised — deleting the file does not remove it from history. Added 2026-07-29 after a benchmark showed no rule covered .env contents; WEB-CRYPTO-001 only matched secrets embedded in source files.",
  "detect": {
    "patterns": [
      "(?im)^\\s*[A-Z0-9_]*(SECRET|PASSWORD|PASSWD|TOKEN|API[_-]?KEY|PRIVATE[_-]?KEY|CREDENTIAL)[A-Z0-9_]*\\s*=\\s*\\S{8,}",
      "(?im)^\\s*DATABASE_URL\\s*=\\s*[a-z+]+://[^:@\\s]+:[^@\\s]+@"
    ],
    "negative_patterns": [
      "(?im)=\\s*(changeme|your[_-]|xxx+|<[a-z_]+>|dummy|example|placeholder|\\$\\{)",
      "# local only"
    ],
    "file_types": [
      ".env",
      ".env.*",
      "*.env"
    ],
    "exclude": [
      "node_modules",
      "dist"
    ]
  },
  "remediation": {
    "description": "Add .env to .gitignore, remove it from tracking with `git rm --cached .env`, and rotate every value it held — the history still contains them. Ship a .env.example with placeholder values instead. Purge history with git-filter-repo if the repository is or was public.",
    "code_example": "# .gitignore\n.env\n.env.*\n!.env.example\n\n# rotation\n$ git rm --cached .env && git commit -m 'remove tracked .env'\n# puis faire tourner chaque secret : ils restent dans l'historique",
    "references": [
      "https://cwe.mitre.org/data/definitions/540.html"
    ]
  },
  "standards": [
    "CWE-540",
    "CWE-798",
    "OWASP-A05:2021"
  ],
  "ai_specific": false,
  "frameworks": []
}
{
