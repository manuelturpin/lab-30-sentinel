{
  "total_cost_usd": 1.7534185000000002,
  "duration_ms": 346330,
  "duration_api_ms": 344760,
  "num_turns": 20,
  "modelUsage": {
    "claude-opus-5[1m]": {
      "inputTokens": 386,
      "outputTokens": 27121,
      "cacheReadInputTokens": 829667,
      "cacheCreationInputTokens": 65863,
