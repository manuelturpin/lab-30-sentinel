    for pat in rule.get(\"detect\",{}).get(\"patterns\",[]):
        try: re.compile(pat); compiled+=1
        except re.error as e: invalid.append((rule[\"id\"],pat,str(e)))
    for pat in rule.get(\"detect\",{}).get(\"negative_patterns\",[]):
        try: re.compile(pat)
        except re.error as e: neginvalid.append((rule[\"id\"],pat,str(e)))
print(\"positive_patterns_compiled\",compiled,\"invalid\",len(invalid))
for x in invalid: print(\"INVALID_POS\",repr(x))
print(\"invalid_negative\",len(neginvalid))
for x in neginvalid: print(\"INVALID_NEG\",repr(x))
targets=[root/\"tests/vulnerable-app/src/server.js\",root/\"tests/vulnerable-app/.env\"]
def type_match(name,types): return not types or any(fnmatch.fnmatch(name,p) for p in types)
def excluded(path,ex): return any(e in path.parts for e in ex)
def scan(negmode):
    hits=[]
    for path in targets:
        content=path.read_text(errors=\"replace\"); lines=content.splitlines(); rel=path.relative_to(root/\"tests/vulnerable-app\")
        for rule in rules:
            d=rule.get(\"detect\",{})
            if not type_match(path.name,d.get(\"file_types\",[])) or excluded(rel,d.get(\"exclude\",[])): continue
            negs=[]
            for n in d.get(\"negative_patterns\",[]):
                try: negs.append(re.compile(n))
                except re.error: pass
            if negmode==\"file\" and any(n.search(content) for n in negs): continue
            pats=[]
            for p in d.get(\"patterns\",[]):
                try: pats.append((p,re.compile(p)))
                except re.error: pass
            for num,line in enumerate(lines,1):
                if negmode==\"line\" and any(n.search(line) for n in negs): continue
                if negmode==\"context\":
                    ctx=\"\\n\".join(lines[max(0,num-6):min(len(lines),num+5)])
                    if any(n.search(ctx) for n in negs): continue
                for p,rx in pats:
                    if rx.search(line): hits.append((rule[\"id\"],str(rel),num,p,line.strip()))
    return hits
for mode in (\"file\",\"context\",\"line\"):
    hits=scan(mode)
    print(\"\\nMODE\",mode,\"HITS\",len(hits),\"UNIQUE_RULE_LOC\",len(set((a,b,c) for a,b,c,_,_ in hits)))
    for h in hits: print(\"\\t\".join(map(str,h[:3])),repr(h[4]))
