     1	#!/usr/bin/env python3
     2	"""
     3	Sentinel Rule Tester — validates LLM-generated detection patterns.
     4	
     5	Tests untested CVE rules against a corpus of known-vulnerable and known-safe
     6	code fixtures. Rules passing the precision gate (>=70%) are promoted to "active".
     7	
     8	Usage:
     9	    python3 scripts/rule-tester.py                  # Test all untested rules
    10	    python3 scripts/rule-tester.py --domain api     # Test one domain
    11	    python3 scripts/rule-tester.py --dry-run        # Preview without status changes
    12	    python3 scripts/rule-tester.py --verbose         # Show match details
    13	    python3 scripts/rule-tester.py --precision 0.8   # Custom precision gate
    14	"""
    15	from __future__ import annotations
    16	
    17	
    18	import argparse
    19	import glob
    20	import json
    21	import os
    22	import re
    23	import signal
    24	import sys
    25	import time
    26	from datetime import datetime, timezone
    27	from pathlib import Path
    28	
    29	SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
    30	PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
    31	KB_DIR = os.path.join(PROJECT_ROOT, "knowledge-base")
    32	DOMAINS_DIR = os.path.join(KB_DIR, "domains")
    33	FIXTURES_DIR = os.path.join(PROJECT_ROOT, "tests", "fixtures")
    34	VULN_APP_DIR = os.path.join(PROJECT_ROOT, "tests", "vulnerable-app", "src")
    35	
    36	DEFAULT_PRECISION_GATE = 0.70
    37	BACKTRACK_TIMEOUT_S = 2.0  # Max seconds for a single regex test
    38	
    39	
    40	# ---------------------------------------------------------------------------
    41	# Corpus loading
    42	# ---------------------------------------------------------------------------
    43	
    44	def load_files_from_dir(directory):
    45	    """Load all source files from a directory tree."""
    46	    files = []
    47	    if not os.path.isdir(directory):
    48	        return files
    49	    for root, _, filenames in os.walk(directory):
    50	        for fname in filenames:
    51	            fpath = os.path.join(root, fname)
    52	            try:
    53	                with open(fpath, encoding="utf-8", errors="replace") as f:
    54	                    content = f.read()
    55	                files.append({
    56	                    "path": fpath,
    57	                    "filename": fname,
    58	                    "content": content,
    59	                    "lines": content.splitlines(),
    60	                })
    61	            except IOError:
    62	                pass
    63	    return files
    64	
    65	
    66	def load_corpus():
    67	    """Load the full test corpus: vulnerable + safe files."""
    68	    vulnerable = load_files_from_dir(os.path.join(FIXTURES_DIR, "vulnerable"))
    69	    vulnerable += load_files_from_dir(VULN_APP_DIR)
    70	    safe = load_files_from_dir(os.path.join(FIXTURES_DIR, "safe"))
    71	    return {"vulnerable": vulnerable, "safe": safe}
    72	
    73	
    74	# ---------------------------------------------------------------------------
    75	# Rule loading
    76	# ---------------------------------------------------------------------------
    77	
    78	def load_untested_rules(domain_filter=None):
    79	    """Load all CVE rules with status='untested'."""
    80	    rules = []
    81	    pattern = os.path.join(DOMAINS_DIR, domain_filter or "*", "cve-rules.json")
    82	    for path in sorted(glob.glob(pattern)):
    83	        domain = os.path.basename(os.path.dirname(path))
    84	        with open(path) as f:
    85	            domain_rules = json.load(f)
    86	        for r in domain_rules:
    87	            if r.get("status") == "untested":
    88	                r["_source_path"] = path
    89	                r["_domain"] = domain
    90	                rules.append(r)
    91	    return rules
    92	
    93	
    94	# ---------------------------------------------------------------------------
    95	# Pattern validation
    96	# ---------------------------------------------------------------------------
    97	
    98	def validate_pattern(pattern_str):
    99	    """Validate a regex pattern: compilation and backtracking safety."""
   100	    # Compile check
   101	    try:
   102	        compiled = re.compile(pattern_str)
   103	    except re.error as e:
   104	        return {"valid": False, "error": f"compile: {e}"}
   105	
   106	    # Backtracking check with adversarial inputs
   107	    adversarial_inputs = [
   108	        "a" * 200,
   109	        "a" * 100 + "!" * 100,
   110	        " " * 200,
   111	        "x" * 50 + "\n" * 50 + "y" * 50,
   112	        "aaaa@aaaa.aaaa.aaaa.aaaa.aaaa.aaaa",
   113	    ]
   114	
   115	    for test_input in adversarial_inputs:
   116	        start = time.time()
   117	        try:
   118	            compiled.search(test_input)
   119	        except Exception:
   120	            pass
   121	        elapsed = time.time() - start
   122	        if elapsed > BACKTRACK_TIMEOUT_S:
   123	            return {"valid": False, "error": f"backtracking ({elapsed:.1f}s)"}
   124	
   125	    return {"valid": True, "compiled": compiled}
   126	
   127	
   128	# ---------------------------------------------------------------------------
   129	# File type matching
   130	# ---------------------------------------------------------------------------
   131	
   132	def file_matches_types(filename, file_types):
   133	    """Check if filename matches any of the rule's file_types globs."""
   134	    if not file_types:
   135	        return True  # No filter = match all source files
   136	
   137	    for ft in file_types:
   138	        if ft.startswith("*."):
   139	            ext = ft[1:]  # .js, .py, etc.
   140	            if filename.endswith(ext):
   141	                return True
   142	        elif ft == filename:
   143	            return True
   144	    return False
   145	
   146	
   147	# ---------------------------------------------------------------------------
   148	# Pattern matching engine
   149	# ---------------------------------------------------------------------------
   150	
   151	def scan_file(file_info, patterns, negative_patterns, file_types):
   152	    """Scan a single file with a rule's patterns. Returns list of matches."""
   153	    if not file_matches_types(file_info["filename"], file_types):
   154	        return []
   155	
   156	    matches = []
   157	    for line_num, line in enumerate(file_info["lines"], 1):
   158	        for pattern in patterns:
   159	            try:
   160	                if re.search(pattern, line):
   161	                    # Check negative patterns (mitigations)
   162	                    mitigated = False
   163	                    for neg in negative_patterns:
   164	                        try:
   165	                            if re.search(neg, line):
   166	                                mitigated = True
   167	                                break
   168	                        except re.error:
   169	                            pass
   170	
   171	                    if not mitigated:
   172	                        matches.append({
   173	                            "file": file_info["filename"],
   174	                            "line": line_num,
   175	                            "pattern": pattern,
   176	                            "text": line.strip()[:120],
   177	                        })
   178	            except re.error:
   179	                pass
   180	
   181	    return matches
   182	
   183	
   184	def run_rule_against_corpus(rule, corpus_files):
   185	    """Run a rule's patterns against a list of files."""
   186	    patterns = rule.get("detect", {}).get("patterns", [])
   187	    negative_patterns = rule.get("detect", {}).get("negative_patterns", [])
   188	    file_types = rule.get("detect", {}).get("file_types", [])
   189	
   190	    all_matches = []
   191	    for file_info in corpus_files:
   192	        matches = scan_file(file_info, patterns, negative_patterns, file_types)
   193	        all_matches.extend(matches)
   194	
   195	    return all_matches
   196	
   197	
   198	# ---------------------------------------------------------------------------
   199	# Rule testing
   200	# ---------------------------------------------------------------------------
   201	
   202	def test_rule(rule, corpus, precision_gate=DEFAULT_PRECISION_GATE, verbose=False):
   203	    """Test a single rule. Returns a result dict with scores."""
   204	    rule_id = rule["id"]
   205	    patterns = rule.get("detect", {}).get("patterns", [])
   206	
   207	    result = {
   208	        "id": rule_id,
   209	        "domain": rule.get("_domain"),
   210	        "title": rule.get("title", "")[:60],
   211	        "confidence": rule.get("confidence", 0),
   212	        "pattern_count": len(patterns),
   213	        "patterns_valid": 0,
   214	        "patterns_invalid": [],
   215	        "tp_count": 0,
   216	        "fp_count": 0,
   217	        "tp_matches": [],
   218	        "fp_matches": [],
   219	        "precision": None,
   220	        "verdict": "inconclusive",
   221	    }
   222	
   223	    # Step 1: Validate patterns
   224	    valid_patterns = []
   225	    for p in patterns:
   226	        check = validate_pattern(p)
   227	        if check["valid"]:
   228	            result["patterns_valid"] += 1
   229	            valid_patterns.append(p)
   230	        else:
   231	            result["patterns_invalid"].append({"pattern": p, "error": check["error"]})
   232	
   233	    if result["patterns_valid"] == 0:
   234	        result["verdict"] = "invalid"
   235	        return result
   236	
   237	    # Step 2: True positives — matches in vulnerable corpus
   238	    tp_matches = run_rule_against_corpus(rule, corpus["vulnerable"])
   239	    result["tp_matches"] = tp_matches
   240	    result["tp_count"] = len(tp_matches)
   140	# Subcommand: seed
   141	# ===========================================================================
   142	
   143	def cmd_seed(args):
   144	    """Auto-seed feedback from rule-tester.py Phase 3 test results.
   145	
   146	    Re-runs the pattern matching against the test corpus and records
   147	    each match as TP (vulnerable corpus) or FP (safe corpus).
   148	    """
   149	    feedback = load_feedback()
   150	    existing_count = len(feedback["entries"])
   151	
   152	    rules = load_all_cve_rules()
   153	    now = datetime.now(timezone.utc).isoformat()
   154	
   155	    # Load corpus files
   156	    vuln_files = _load_files(os.path.join(FIXTURES_DIR, "vulnerable"))
   157	    vuln_files += _load_files(VULN_APP_DIR)
   158	    safe_files = _load_files(os.path.join(FIXTURES_DIR, "safe"))
   159	
   160	    added = 0
   161	    # Only seed for rules that have been tested (have test_precision)
   162	    for rule_id, rule in rules.items():
   163	        if "test_precision" not in rule:
   164	            continue
   165	
   166	        patterns = rule.get("detect", {}).get("patterns", [])
   167	        negative_patterns = rule.get("detect", {}).get("negative_patterns", [])
   168	        file_types = rule.get("detect", {}).get("file_types", [])
   169	
   170	        # Scan vulnerable files → TP
   171	        for file_info in vuln_files:
   172	            if not _file_matches(file_info["filename"], file_types):
   173	                continue
   174	            for line_num, line in enumerate(file_info["lines"], 1):
   175	                for pattern in patterns:
   176	                    try:
   177	                        if re.search(pattern, line) and not _is_mitigated(line, negative_patterns):
   178	                            feedback["entries"].append({
   179	                                "rule_id": rule_id,
   180	                                "verdict": "tp",
   181	                                "file": file_info["filename"],
   182	                                "line": line_num,
   183	                                "pattern": pattern,
   184	                                "context": line.strip()[:120],
   185	                                "project": "sentinel-fixtures",
   186	                                "timestamp": now,
   187	                            })
   188	                            added += 1
   189	                    except re.error:
   190	                        pass
   191	
   192	        # Scan safe files → FP
   193	        for file_info in safe_files:
   194	            if not _file_matches(file_info["filename"], file_types):
   195	                continue
   196	            for line_num, line in enumerate(file_info["lines"], 1):
   197	                for pattern in patterns:
   198	                    try:
   199	                        if re.search(pattern, line) and not _is_mitigated(line, negative_patterns):
   200	                            feedback["entries"].append({
   201	                                "rule_id": rule_id,
   202	                                "verdict": "fp",
   203	                                "file": file_info["filename"],
   204	                                "line": line_num,
   205	                                "pattern": pattern,
   206	                                "context": line.strip()[:120],
   207	                                "project": "sentinel-fixtures",
   208	                                "timestamp": now,
   209	                            })
   210	                            added += 1
   211	                    except re.error:
   212	                        pass
   213	
   214	    save_feedback(feedback)
   215	    print(f"Seeded {added} feedback entries from test corpus")
   216	    print(f"Total entries: {len(feedback['entries'])} (was {existing_count})")
   217	
   218	
   219	def _load_files(directory):
   220	    """Load source files from directory."""
   221	    files = []
   222	    if not os.path.isdir(directory):
   223	        return files
   224	    for root, _, filenames in os.walk(directory):
   225	        for fname in filenames:
   226	            fpath = os.path.join(root, fname)
   227	            try:
   228	                with open(fpath, encoding="utf-8", errors="replace") as f:
   229	                    content = f.read()
   230	                files.append({"filename": fname, "lines": content.splitlines()})
   231	            except IOError:
   232	                pass
   233	    return files
   234	
   235	
   236	def _file_matches(filename, file_types):
   237	    """Check if filename matches file_types globs."""
   238	    if not file_types:
   239	        return True
   240	    for ft in file_types:
   241	        if ft.startswith("*.") and filename.endswith(ft[1:]):
   242	            return True
   243	    return False
   244	
   245	
   246	def _is_mitigated(line, negative_patterns):
   247	    """Check if line matches any negative pattern."""
   248	    for neg in negative_patterns:
   249	        try:
   250	            if re.search(neg, line):
   251	                return True
   252	        except re.error:
   253	            pass
   254	    return False
   255	
   256	
   257	# ===========================================================================
   258	# Subcommand: score
   259	# ===========================================================================
   260	
   261	def cmd_score(args):
   262	    """Recalculate confidence scores from accumulated feedback."""
   263	    feedback = load_feedback()
   264	    rules = load_all_cve_rules()
   265	
   266	    if not feedback["entries"]:
   267	        print("No feedback entries. Run 'seed' or 'ingest' first.")
   268	        return
   269	
   270	    # Aggregate feedback per rule
     1	# Execution Protocol (Common)
     2	
     3	This protocol defines how every security audit agent executes its audit. Each agent MUST follow these steps and return findings in the exact format specified below.
     4	
     5	## Finding Schema
     6	
     7	Every finding MUST conform to this TypeScript interface:
     8	
     9	```typescript
    10	interface Finding {
    11	  id: string;                // Agent-specific format: "WEB-INJ-001", "API-AUTH-002", etc.
    12	  severity: "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "INFO";
    13	  title: string;             // Short, descriptive title
    14	  description: string;       // Detailed explanation of the vulnerability
    15	  location: {
    16	    file: string;            // Relative path from project root
    17	    line?: number;           // Line number if applicable
    18	    column?: number;         // Column number if applicable
    19	  };
    20	  standard?: string;         // Primary standard reference (e.g., "CWE-89")
    21	  owasp?: string;            // OWASP reference (e.g., "A03:2025")
    22	  cwe?: string;              // CWE identifier (e.g., "CWE-89")
    23	  remediation: string;       // Actionable fix description
    24	  cvss_v4?: number;          // CVSS v4 base score (0.0-10.0)
    25	  epss?: number;             // EPSS probability (0.0-1.0) if CVE is mapped
    26	}
    27	```
    28	
    29	## Execution Steps
    30	
    31	### Step 1: KB Pattern Scan (Direct)
    32	
    33	For your domain ({domain}), load rules and apply them directly using native tools — **do NOT call `scan-project`, `scan-secrets`, `query-kb`, or `query-cve` via MCP**.
    34	
    35	1. **Read** `/Users/manuelturpin/.sentinel/knowledge-base/domains/{domain}/rules.json`
    36	2. For each rule in the file:
    37	   - Use **Grep** with each `detect.patterns[]` on the project files
    38	     - Filter by `detect.file_types[]` via the `glob` parameter of Grep
    39	     - Exclude directories in `detect.exclude[]`
    40	   - For each Grep match:
    41	     - **Read** 5-10 lines of context around the match
    42	     - Check `negative_patterns[]` — if any match in the context, it's a false positive, skip it
    43	     - Create a Finding using the rule's fields: `id`, `severity`, `cvss_v4`, `standards` (map to `cwe`, `owasp`), `remediation`
    44	3. This replaces `scan-project` — you are doing exactly the same pattern matching natively, without MCP serialization overhead.
    45	
    46	**Available MCP tools** (use ONLY for external network calls):
    47	
    48	| Tool | Purpose | When to Use |
    49	|------|---------|-------------|
    50	| `scan-dependencies` | Analyze dependencies for known CVEs (calls OSV API) | Supply chain agent only |
    51	| `scan-headers` | HTTP GET to check security headers on live URLs | Web, CORS, SSL/TLS, static-site agents |
    52	
    53	**MCP tool inheritance** — as of v2.1.101, subagents automatically inherit MCP tools from dynamically-injected servers in the parent session. You do NOT need to explicitly configure MCP access — `scan-dependencies` and `scan-headers` are available if the parent has the sentinel-scanner MCP server loaded.
    54	
    55	**How to call MCP tools** (only the two above):
    56	```
    57	mcp__sentinel-scanner__scan-dependencies({ projectPath: "/path/to/project" })
    58	mcp__sentinel-scanner__scan-headers({ url: "https://example.com" })
    59	```
    60	
    61	**MCP server env vars** (v2.1.85+) — if sentinel-scanner uses a `headersHelper` script for authentication (e.g., enterprise API gateway), the helper receives `CLAUDE_CODE_MCP_SERVER_NAME=sentinel-scanner` and `CLAUDE_CODE_MCP_SERVER_URL` automatically. This enables one helper script to serve multiple MCP servers with different credentials.
    62	
    63	**Agent hardening** — on Linux, `CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1` enables PID namespace isolation for subprocess sandboxing (v2.1.98+), in addition to credential scrubbing. Set `CLAUDE_CODE_SCRIPT_CAPS` to limit script invocations per session.
    64	
    65	**OTEL tracing** — when `OTEL_EXPORTER_OTLP_ENDPOINT` is set, Bash subprocesses inherit a W3C `TRACEPARENT` env var (v2.1.98+). Combined with `OTEL_LOG_TOOL_DETAILS=1` (v2.1.101+), this provides per-agent performance traces for identifying slow KB queries and bottleneck agents.
    66	
    67	### Step 2: Manual Grep Scan (Domain-Specific Patterns)
    68	
    69	Use the `Grep` tool to search for patterns listed in your `## Detection Patterns` section.
    70	
    71	For each pattern match:
    72	1. Read the surrounding code context (5-10 lines) with the `Read` tool
    73	2. Check against negative patterns to filter false positives
    74	3. If the match is a true positive, create a Finding
    75	
    76	**Important**: Do NOT report a finding from Grep if Step 1 (KB Pattern Scan) already reported the same issue (same file + same line range + same vulnerability type). This avoids duplicates.
    77	
    78	### Step 2b: Live CVE Enrichment (Optional)
    79	
    80	If any finding from Steps 1-2 references a CVE ID (CVE-YYYY-NNNNN) and lacks an EPSS score or has no exploit context, use WebSearch to check for active exploits:
    81	
    82	1. **WebSearch**: `"{CVE-ID} exploit proof of concept"` — check if a public PoC exists
    83	2. If an exploit is found, increase the finding's severity appropriately and note it in the description
    84	3. **Limit**: Maximum 3 WebSearch calls per agent to avoid slowing the scan
    85	
    86	This provides real-time intelligence beyond the cached CVE data.
    87	
    88	### Step 3: KB Enrichment (Direct)
    89	
    90	For findings from Step 1, enrichment is already done — the rule's `cvss_v4`, `standards`, and `remediation` fields were used directly when creating the Finding.
    91	
    92	For findings from Step 2 (manual Grep) that don't have a KB rule match, enrich them:
    93	1. **Bash**: `python3 /Users/manuelturpin/Desktop/bonsai974/claude/lab/lab-30-sentinel/rag/query.py --query "{finding.title}" --domain {domain} --limit 3`
    94	2. Parse the JSON output to get CVSS score, CWE/OWASP references, and remediation
    95	3. If the RAG returns no match, use your own judgment for severity and remediation but keep scores conservative.
    96	
    97	**Do NOT call `query-kb` via MCP** — the Bash call above does the same thing without MCP serialization overhead.
    98	
    99	### Step 3b: Live Vulnerability Verification (web-audit, cors-audit, ssl-tls-audit, static-site-audit)
   100	
   101	If a live URL is provided in the audit config, use **browser automation** to dynamically verify web vulnerabilities found in Steps 1-3:
   102	
   103	1. **XSS verification**: Navigate to the affected URL with a safe test payload (e.g., `<img src=x onerror=console.log('xss-test')>`) and check console for execution
   104	2. **Open redirect verification**: Follow redirect chains and verify the final destination matches the expected domain
   105	3. **CSRF verification**: Check forms for missing CSRF tokens by reading page HTML
   106	4. **Security headers**: Use `mcp__claude-in-chrome__read_network_requests` to inspect response headers (CSP, HSTS, X-Frame-Options)
   107	
   108	**Rules for browser verification:**
   109	- Only verify findings already identified by static analysis — do NOT use browser as a scanner
   110	- Maximum 5 browser verifications per agent to avoid slowing the audit
   111	- Mark verified findings with `"verified": true` in the description
   112	- Findings that fail dynamic verification should be downgraded to INFO with note "Static analysis only — not confirmed dynamically"
   113	
   114	### Step 4: Deduplicate and Return
   115	
   116	1. **Deduplicate**: Remove findings with identical `location.file` + `location.line` + same vulnerability type
   117	2. **Sort**: Order by `cvss_v4` descending (most critical first)
   118	3. **Redact secrets**: If a finding contains an actual secret value (API key, password, token), replace it with `[REDACTED]` in the description
   119	4. **Return**: Output a single JSON code block with the Finding[] array
   120	
