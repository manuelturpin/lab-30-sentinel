      "*.js",
      "*.ts",
      "*.mjs"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build"
    ],
    "negative_patterns": [
      "# local only",
      "# example only"
    ]
  },
  "remediation": {
    "description": "Set HttpOnly, Secure, and SameSite flags on all session cookies.",
    "code_example": "res.cookie('session', token, { httpOnly: true, secure: true, sameSite: 'strict', maxAge: 3600000 });",
    "references": [
      "https://cheatsheetseries.owasp.org/cheatsheets/Session_Management_Cheat_Sheet.html"
    ]
  },
  "standards": [
    "CWE-614",
    "CWE-1004",
    "OWASP-A02:2025"
  ],
  "ai_specific": false,
  "frameworks": [
    "express",
    "fastify",
    "koa"
  ],
  "detection_note": "Les negative_patterns sont volontairement minimaux : le moteur les applique au FICHIER ENTIER, donc un motif large comme `\\$\\{` supprimerait la règle sur tout fichier contenant un template literal. L'exclusion de l'interpolation est portée par le motif positif lui-même ([^@/\\s'\"$]+ interdit le $ dans le segment mot de passe). Corrigé le 2026-07-29 après avoir reproduit ce bug de neutralisation croisée."
}
{
  "id": "WEB-CRYPTO-004",
  "severity": "CRITICAL",
  "cvss_v4": 9.1,
  "category": "web-app",
  "subcategory": "secrets",
  "title": "Hardcoded credentials inside a database connection string",
  "description": "A connection URI carries a username and password as literals in the source. WEB-CRYPTO-001 catches `key = \"...\"` assignments but not credentials embedded in a URI, which is how most database drivers are configured. Added 2026-07-29 after a benchmark miss.",
  "detect": {
    "patterns": [
      "(postgres|postgresql|mysql|mongodb(\\+srv)?|redis|amqp|mssql)://[A-Za-z0-9._%-]+:[^@/\\s'\"$]+@",
      "connectionString\\s*[:=]\\s*['\"][a-z+]+://[A-Za-z0-9._%-]+:[^@'\"$]+@"
    ],
    "negative_patterns": [
      "# local only",
      "# example only"
    ],
    "file_types": [
      "*.js",
      "*.ts",
      "*.py",
      "*.go",
      "*.rb",
      "*.java",
      "*.yaml",
      "*.yml",
      "*.json"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "test"
    ]
  },
  "remediation": {
    "description": "Move the URI to an environment variable and inject it at runtime. Rotate any credential that has been committed — removing it from the working tree does not remove it from git history.",
    "code_example": "// WRONG\nnew Pool({ connectionString: 'postgres://admin:password123@localhost:5432/mydb' });\n\n// RIGHT\nnew Pool({ connectionString: process.env.DATABASE_URL });",
    "references": [
      "https://cwe.mitre.org/data/definitions/798.html"
    ]
  },
  "standards": [
    "CWE-798",
    "CWE-259",
    "OWASP-A07:2021"
  ],
  "ai_specific": false,
  "frameworks": [],
  "detection_note": "Les negative_patterns sont volontairement minimaux : le moteur les applique au FICHIER ENTIER, donc un motif large comme `\\$\\{` supprimerait la règle sur tout fichier contenant un template literal. L'exclusion de l'interpolation est portée par le motif positif lui-même ([^@/\\s'\"$]+ interdit le $ dans le segment mot de passe). Corrigé le 2026-07-29 après avoir reproduit ce bug de neutralisation croisée. ID initialement attribué à WEB-CRYPTO-002, déjà pris par « Insecure cookie configuration » — collision détectée au contrôle d'intégrité et corrigée."
}

