      "*.py",
      "*.rb",
      "*.go"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build"
    ]
  },
  "detection_method": null,
  "detection_note": null
}
{
  "id": "CORS-ORIGIN-001",
  "title": "Wildcard Access-Control-Allow-Origin on authenticated endpoint",
  "description": "CORS configured with wildcard origin (*) on endpoints that handle authenticated requests. This allows any website to make cross-origin requests to the API.",
  "detect": {
    "patterns": [
      "Access-Control-Allow-Origin.*\\*",
      "origin:\\s*['\"]\\*['\"]",
      "origin:\\s*true",
      "cors\\(\\)\\s*(?!\\{)"
    ],
    "negative_patterns": [
      "origin:\\s*\\[",
      "allowlist",
      "whitelist",
      "origin.*function"
    ],
    "file_types": [
      "*.js",
      "*.ts",
      "*.mjs",
      "*.py",
      "*.rb",
      "*.conf"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build"
    ]
  },
  "detection_method": null,
  "detection_note": null
}
{
  "id": "DB-INJECT-002",
  "title": "SQL Injection via String Concatenation or Template Literals",
  "description": "SQL queries are constructed by concatenating or interpolating user-controlled input directly into query strings, allowing attackers to inject arbitrary SQL commands to read, modify, or delete data, or escalate privileges.",
  "detect": {
    "patterns": [
      "query\\s*\\(\\s*['\"`]\\s*SELECT\\s+.*['\"`]\\s*\\+\\s*req\\.",
      "query\\s*\\(\\s*['\"`]\\s*(INSERT|UPDATE|DELETE|SELECT).*['\"`]\\s*\\+\\s*(req\\.|user|input|param)",
      "query\\s*\\(\\s*`[^`]*(INSERT|UPDATE|DELETE|SELECT)[^`]*\\$\\{\\s*req\\.",
      "execute\\s*\\(\\s*['\"`].*['\"`]\\s*\\+\\s*req\\.",
      "query\\s*\\(\\s*f?['\"].*\\{.*req\\.(body|query|params)",
      "cursor\\.execute\\s*\\(\\s*f?['\"]\\s*(SELECT|INSERT|UPDATE|DELETE).*\\{",
      "cursor\\.execute\\s*\\(\\s*['\"].*['\"]\\s*%\\s*\\(?(req|request|user_input|param)"
    ],
    "negative_patterns": [
      "\\?\\s*,\\s*\\[",
      "\\$\\d+\\s*,\\s*\\[",
      "parameterized",
      "prepared_statement",
      "sqlalchemy\\.text\\(",
      "bindParam"
    ],
    "file_types": [
      "*.js",
      "*.ts",
      "*.py",
      "*.php",
      "*.java",
      "*.rb",
      "*.go"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build",
      "test",
      "__tests__",
      "__pycache__",
      "vendor"
    ]
  },
  "detection_method": null,
  "detection_note": null
}
{
  "id": "LLM-AGENCY-002",
  "title": "AI agent with network access and no egress restrictions",
  "description": "An AI agent can make arbitrary HTTP requests or network connections without domain allowlisting or egress controls. This enables data exfiltration, SSRF, and communication with attacker-controlled servers.",
  "detect": {
    "patterns": [
      "requests_tool",
      "RequestsTool\\(",
      "WebBrowserTool\\(",
      "fetch\\(.*(?:url|endpoint).*\\)",
      "httpx?\\.(?:get|post)\\(.*(?:url|endpoint)"
    ],
    "negative_patterns": [
      "allowed_domains\\s*=",
      "domain_allowlist",
      "egress_filter\\("
    ],
    "file_types": [
      "*.py",
      "*.ts",
      "*.js"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "test"
    ]
  },
  "detection_method": null,
  "detection_note": null
}
{
  "id": "TLS-HSTS-001",
  "title": "Missing or weak HSTS configuration",
  "description": "HTTP Strict Transport Security header is missing or has a max-age below the recommended 1 year (31536000 seconds), leaving users vulnerable to SSL stripping attacks.",
  "detect": {
    "patterns": [
      "app\\.listen",
      "server\\.listen",
      "createServer",
      "http\\.createServer"
    ],
    "negative_patterns": [
      "Strict-Transport-Security",
      "hsts",
      "helmet"
    ],
    "file_types": [
      "*.js",
      "*.ts",
      "*.mjs",
      "*.conf"
    ],
    "exclude": [
      "node_modules",
      "dist",
      "build"
    ]
  },
  "detection_method": null,
  "detection_note": null
}
{
  "id": "TLS-PIN-001",
  "title": "Missing certificate pinning for mobile/critical applications",
  "description": "Application connecting to backend APIs does not implement certificate pinning, making it susceptible to man-in-the-middle attacks with rogue CA certificates.",
  "detect": {
