        "export\\s+OTEL_LOG_RAW_API_BODIES",
        "OTEL_LOG_TOOL_DETAILS\\s*=\\s*1",
        "OTEL_LOG_TOOL_DETAILS\\s*=\\s*true",
        "OTEL_LOG_TOOL_DETAILS:\\s*['\"]?1",
        "export\\s+OTEL_LOG_TOOL_DETAILS",
        "OTEL_LOG_TOOL_CONTENT\\s*=\\s*1",
        "OTEL_LOG_TOOL_CONTENT\\s*=\\s*true",
        "OTEL_LOG_TOOL_CONTENT:\\s*['\"]?1",
        "export\\s+OTEL_LOG_TOOL_CONTENT",
        "OTEL_LOG_USER_PROMPTS\\s*=\\s*1",
        "OTEL_LOG_USER_PROMPTS\\s*=\\s*true",
        "OTEL_LOG_USER_PROMPTS:\\s*['\"]?1",
        "export\\s+OTEL_LOG_USER_PROMPTS",
        "OTEL_LOG_ASSISTANT_RESPONSES\\s*=\\s*1",
        "OTEL_LOG_ASSISTANT_RESPONSES\\s*=\\s*true",
        "OTEL_LOG_ASSISTANT_RESPONSES:\\s*['\"]?1",
        "export\\s+OTEL_LOG_ASSISTANT_RESPONSES",
        "CLAUDE_CODE_OTEL_CONTENT_MAX_LENGTH\\s*=\\s*[0-9]{7,}",
        "export\\s+CLAUDE_CODE_OTEL_CONTENT_MAX_LENGTH"
      ],
      "negative_patterns": [
        "OTEL_LOG_RAW_API_BODIES\\s*=\\s*0",
        "OTEL_LOG_TOOL_DETAILS\\s*=\\s*0",
        "OTEL_LOG_TOOL_CONTENT\\s*=\\s*0",
        "OTEL_LOG_USER_PROMPTS\\s*=\\s*0",
        "# debug only",
        "# local only",
        "OTEL_LOG_ASSISTANT_RESPONSES\\s*=\\s*0"
      ],
      "file_types": [
        ".env",
        ".env.*",
        "Dockerfile",
        "docker-compose.*",
        "*.yaml",
        "*.yml",
        "*.sh",
        "*.md"
      ],
      "exclude": [
        "node_modules",
        "dist",
        "test",
        "knowledge-base/",
        "anthropic-intel/",
        "knowledge/sources/",
        "reports/archive/",
        "CHANGELOG",
        "changelog"
      ]
    },
    "remediation": {
      "description": "Never enable OTEL_LOG_RAW_API_BODIES, OTEL_LOG_TOOL_DETAILS, or OTEL_LOG_TOOL_CONTENT in production, CI, or any environment exporting telemetry to a shared backend — they leak prompts, tool parameters (command lines, file paths, secrets), and tool results. Use them only in local debugging with ephemeral logs. If needed for incident response, scope to a specific session via a command-line export and scrub logs immediately after. Note: Sentinel's own performance-tracing guidance uses OTEL_LOG_TOOL_DETAILS=1 in a trusted local/ephemeral context only — annotate such usage with `# local only`. Since v2.1.193 also treat OTEL_LOG_ASSISTANT_RESPONSES as prompt-grade sensitive: it emits the assistant's own output, and it defaults to following OTEL_LOG_USER_PROMPTS when unset — so audit both together. Leave CLAUDE_CODE_OTEL_CONTENT_MAX_LENGTH at its 60 KB default.",
      "code_example": "# WRONG — committed to repo or CI config\nOTEL_LOG_RAW_API_BODIES=1\nOTEL_LOG_TOOL_DETAILS=1\nOTEL_LOG_TOOL_CONTENT=1\n\n# RIGHT — local debug only, ephemeral shell\n$ OTEL_LOG_TOOL_DETAILS=1 claude --bare -p '/my-skill' 2>debug.log  # local only\n$ shred -u debug.log  # scrub after",
      "references": [
