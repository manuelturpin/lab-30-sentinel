        "dist"
      ]
    },
    "remediation": {
      "description": "Add sandbox.failIfUnavailable: true to settings.json whenever sandbox mode is configured. This ensures that sandboxed execution is enforced — if the sandbox cannot start, the process exits with an error rather than silently running without isolation.",
      "code_example": "// In settings.json\n{\n  \"sandbox\": {\n    \"enabled\": true,\n    \"failIfUnavailable\": true\n  }\n}",
