  {
    "id": "LLM-CCHARDEN-001",
    "severity": "MEDIUM",
    "cvss_v4": 5.9,
    "category": "llm-ai",
    "subcategory": "control-bypass",
    "title": "Claude Code defensive controls disabled (safe-mode / bundled-skills / idle-timeout)",
    "description": "Claude Code settings that weaken the agent's own security posture, dangerous when set in shared, CI, or committed environments rather than ad-hoc local troubleshooting. CLAUDE_CODE_SAFE_MODE=1 (or --safe-mode, v2.1.169+) starts Claude Code with ALL customizations disabled — CLAUDE.md, plugins, skills, hooks, and MCP servers — which silently bypasses any hook-based audit, guardrail skill, or MCP policy control. CLAUDE_CODE_DISABLE_BUNDLED_SKILLS=1 (or disableBundledSkills) hides bundled skills, workflows, and built-in slash commands from the model, shrinking the defensive surface. API_FORCE_IDLE_TIMEOUT=0 (v2.1.163+) disables the 5-minute idle-stream timeout, allowing indefinite stream hangs (DoS / slow data exfiltration). These belong in an ephemeral local shell, never in .env, CI config, Dockerfiles, or managed settings. autoMode.classifyAllShell=false (v2.1.193+) narrows the auto-mode classifier back to arbitrary-code-execution patterns only, so ordinary Bash/PowerShell commands run unreviewed in auto mode.",
    "detect": {
      "patterns": [
        "CLAUDE_CODE_SAFE_MODE\\s*=\\s*1",
        "CLAUDE_CODE_SAFE_MODE\\s*=\\s*true",
        "export\\s+CLAUDE_CODE_SAFE_MODE",
        "--safe-mode\\b",
        "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS\\s*=\\s*1",
        "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS\\s*=\\s*true",
        "export\\s+CLAUDE_CODE_DISABLE_BUNDLED_SKILLS",
        "\"disableBundledSkills\"\\s*:\\s*true",
        "API_FORCE_IDLE_TIMEOUT\\s*=\\s*0",
        "\"classifyAllShell\"\\s*:\\s*false"
      ],
      "negative_patterns": [
        "CLAUDE_CODE_SAFE_MODE\\s*=\\s*0",
        "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS\\s*=\\s*0",
        "\"disableBundledSkills\"\\s*:\\s*false",
        "# troubleshooting only",
        "# local only",
        "\"classifyAllShell\"\\s*:\\s*true"
      ],
      "file_types": [
        ".env",
        ".env.*",
        "Dockerfile",
        "docker-compose.*",
        "*.yaml",
        "*.yml",
        "*.sh",
        "settings.json",
        "managed-settings.json",
        "*.md"
      ],
      "exclude": [
        "node_modules",
        "dist",
        "test",
        "knowledge-base/",
        "anthropic-intel/",
        "knowledge/sources/",
        "reports/archive/",
        "CHANGELOG",
        "changelog"
      ]
    },
    "remediation": {
      "description": "Never persist CLAUDE_CODE_SAFE_MODE, CLAUDE_CODE_DISABLE_BUNDLED_SKILLS, or API_FORCE_IDLE_TIMEOUT=0 in committed config, CI, Dockerfiles, or managed settings — they disable hooks/MCP/skill-based controls and idle-timeout protections that your security posture relies on. Use --safe-mode only as an interactive, one-off troubleshooting flag in a local shell. If a hook or MCP server misbehaves, fix or scope it rather than globally disabling all customizations. For managed deployments, enforce policy via requiredMinimumVersion and glob deny rules instead of safe-mode.",
      "code_example": "# WRONG — committed / CI / Docker: silently disables hooks, MCP, skills\nENV CLAUDE_CODE_SAFE_MODE=1\nAPI_FORCE_IDLE_TIMEOUT=0\n\n# RIGHT — interactive, local, one-off troubleshooting only\n$ claude --safe-mode   # then exit; never export it",
      "references": [
        "https://github.com/anthropics/claude-code/releases/tag/v2.1.169",
        "https://github.com/anthropics/claude-code/releases/tag/v2.1.163",
        "https://github.com/anthropics/claude-code/releases/tag/v2.1.193"
      ]
    },
    "standards": [
      "CWE-693",
      "CWE-16",
      "CWE-400",
      "OWASP-LLM06:2025"
    ],
    "ai_specific": true,
    "frameworks": [
      "claude-code"
    ]
  },
  {
    "id": "LLM-CCSANDBOX-001",
    "severity": "HIGH",
    "cvss_v4": 7.1,
    "category": "llm-ai",
    "subcategory": "sandbox-weakening",
    "title": "Claude Code sandbox isolation weakened (filesystem / network allowlist / credentials / Apple Events)",
    "description": "Claude Code sandbox settings that reduce the isolation applied to sandboxed commands. sandbox.filesystem.disabled=true (v2.1.216+) skips filesystem isolation entirely while keeping only network egress control, so a sandboxed command regains full read/write access to the host tree. sandbox.network.strictAllowlist=false (v2.1.219+) lets sandboxed commands reach hosts that are not on the allowlist without prompting, defeating egress control and enabling silent exfiltration. sandbox.credentials configured to permit credential access lets sandboxed commands read credential files and secret environment variables (v2.1.187+ added the setting precisely to block this). sandbox.allowAppleEvents=true (v2.1.181+) lets sandboxed commands drive other macOS applications via Apple Events — a sandbox escape by proxy. Each of these is legitimate as a deliberate, scoped, local choice; committed to a repo, a Dockerfile, CI config, or managed settings, they silently strip the isolation that the rest of the posture assumes.",
    "detect": {
      "patterns": [
        "sandbox\\.filesystem\\.disabled\\s*[:=]\\s*true",
        "\"filesystem\"\\s*:\\s*\\{[^}]*\"disabled\"\\s*:\\s*true",
        "sandbox\\.network\\.strictAllowlist\\s*[:=]\\s*false",
        "\"strictAllowlist\"\\s*:\\s*false",
        "sandbox\\.allowAppleEvents\\s*[:=]\\s*true",
        "\"allowAppleEvents\"\\s*:\\s*true",
        "\"sandbox\"\\s*:\\s*\\{[^}]*\"credentials\"\\s*:\\s*(false|\"allow\")"
      ],
      "negative_patterns": [
        "\"disabled\"\\s*:\\s*false",
        "\"strictAllowlist\"\\s*:\\s*true",
        "\"allowAppleEvents\"\\s*:\\s*false",
        "# local only",
        "# troubleshooting only"
      ],
      "file_types": [
        ".env",
        ".env.*",
        "Dockerfile",
        "docker-compose.*",
        "*.yaml",
        "*.yml",
        "*.sh",
        "settings.json",
        "managed-settings.json",
        "*.md"
      ],
      "exclude": [
        "node_modules",
        "dist",
        "test",
        "knowledge-base/",
        "anthropic-intel/",
        "knowledge/sources/",
        "reports/archive/",
        "CHANGELOG",
        "changelog"
      ]
    },
    "remediation": {
      "description": "Keep sandbox isolation at its defaults in anything committed or shared. Prefer narrowing the specific permission that blocks you over disabling a whole isolation layer: add the host to the network allowlist rather than setting strictAllowlist=false; grant a specific path rather than filesystem.disabled=true. Keep sandbox.credentials blocking credential files and secret environment variables — that setting exists to stop a sandboxed command from reading what the sandbox was meant to protect. On macOS, leave allowAppleEvents off unless a named workflow requires driving a specific app, and scope it to a local session. If a setting must be relaxed temporarily, do it in an ephemeral shell and annotate it `# local only`.",
      "code_example": "// WRONG — committed .claude/settings.json: isolation silently removed\n{ \"sandbox\": { \"filesystem\": { \"disabled\": true },\n                \"network\": { \"strictAllowlist\": false },\n                \"allowAppleEvents\": true } }\n\n// RIGHT — isolation kept, exceptions named and scoped\n{ \"sandbox\": { \"network\": { \"strictAllowlist\": true,\n                              \"allowlist\": [\"api.osv.dev\", \"services.nvd.nist.gov\"] } } }",
      "references": [
        "https://github.com/anthropics/claude-code/releases/tag/v2.1.216",
        "https://github.com/anthropics/claude-code/releases/tag/v2.1.219",
        "https://github.com/anthropics/claude-code/releases/tag/v2.1.187",
        "https://github.com/anthropics/claude-code/releases/tag/v2.1.181"
      ]
    },
    "standards": [
      "CWE-693",
      "CWE-653",
      "CWE-923",
      "CWE-522",
      "OWASP-LLM06:2025"
    ],
    "ai_specific": true,
    "frameworks": [
      "claude-code"
    ]
  }
]
