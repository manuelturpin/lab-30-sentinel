/bin/zsh -lc "python3 - <<'PY'
import json,re
p='knowledge-base/domains/llm-ai/rules.json'
rules=json.load(open(p))
ids={'LLM-DEBUG-001','LLM-CCHARDEN-001','LLM-CCSANDBOX-001'}
for r in rules:
    if r['id'] not in ids: continue
    bad=[]
    for kind in ('patterns','negative_patterns'):
        for x in r['detect'][kind]:
            try: re.compile(x)
            except re.error as e: bad.append((kind,x,str(e)))
    print(r['id'], 'compiled', len(r['detect']['patterns'])+len(r['detect']['negative_patterns']), 'bad',bad)

tests={
'LLM-DEBUG-001':[
'export CLAUDE_CODE_OTEL_CONTENT_MAX_LENGTH=60000',
'export OTEL_LOG_ASSISTANT_RESPONSES=0',
'OTEL_LOG_ASSISTANT_RESPONSES=true',
'CLAUDE_CODE_OTEL_CONTENT_MAX_LENGTH=0',
],
'LLM-CCHARDEN-001':[
'{\"autoMode\":{\"classifyAllShell\": false}}',
'{\"autoMode\":{\"classifyAllShell\": true}}',
],
'LLM-CCSANDBOX-001':[
'{\"sandbox\":{\"network\":{\"strictAllowlist\":false}}}',
'{\"sandbox\":{\"network\":{\"strictAllowlist\":true}}}',
'{\"sandbox\":{\"credentials\":false}}',
'{\"sandbox\":{\"credentials\":true}}',
'{\"sandbox\":{\"filesystem\":{\"disabled\":true},\"credentials\":false}}',
'sandbox.filesystem.disabled=true # local only',
]}
for r in rules:
    if r['id'] not in tests: continue
    pats=[re.compile(x) for x in r['detect']['patterns']]
    negs=[re.compile(x) for x in r['detect']['negative_patterns']]
    print('\\n',r['id'])
    for s in tests[r['id']]:
        pos=[i for i,p in enumerate(pats) if p.search(s)]
        neg=[i for i,p in enumerate(negs) if p.search(s)]
        print(repr(s),'pos',pos,'neg',neg,'reported',bool(pos and not neg))
