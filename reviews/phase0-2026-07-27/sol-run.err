    "severity": "HIGH",
    "cvss_v4": 7.5,
    "category": "llm-ai",
    "subcategory": "permission-bypass",
    "title": "PreToolUse hook permissionDecision 'ask' used as security gate",
    "description": "A PreToolUse hook returns permissionDecision: 'ask' to gate dangerous tool calls. Prior to v2.1.101, permissions.deny rules did NOT override this — the hook could downgrade a deny into a prompt, creating a privilege escalation vector. After the fix, deny properly takes precedence, but projects relying on 'ask' as their primary security mechanism should add explicit permissions.deny rules for defense-in-depth.",
    "detect": {
      "patterns": [
        "permissionDecision.*['\"]ask['\"]",
        "permission_decision.*ask",
        "PreToolUse.*ask"
      ],
      "negative_patterns": [
        "permissions\\.deny",
        "permissionDecision.*['\"]deny['\"]"
      ],
      "file_types": [
        "*.json",
        "*.md",
        "*.js",
        "*.ts"
      ],
      "exclude": [
        "node_modules",
        "dist"
      ]
    },
    "remediation": {
      "description": "Add explicit permissions.deny rules alongside PreToolUse hooks. Do not rely solely on hooks returning 'ask' for security gating — use deny rules as the primary enforcement and hooks as supplementary checks.",
      "code_example": "// settings.json — defense-in-depth\n{\n  \"permissions\": {\n    \"deny\": [\"Bash(rm -rf *)\", \"Bash(curl * | bash)\"]\n  },\n  \"hooks\": {\n    \"PreToolUse\": [{\n      \"if\": \"Bash\",\n      \"hooks\": [{ \"type\": \"command\", \"command\": \"echo '{\\\"permissionDecision\\\": \\\"ask\\\"}'\"}]\n    }]\n  }\n}",
      "references": [
        "https://github.com/anthropics/claude-code/releases/tag/v2.1.101"
      ]
    },
    "standards": [
      "CWE-863",
      "OWASP-LLM09:2025"
    ],
    "ai_specific": true,
    "frameworks": [
      "claude-code"
    ]
  },
