        print("  OWASP: using GITHUB_TOKEN")

    updates_found = []
    checked = 0

    for repo_key, repo_config in repos.items():
        repo = repo_config.get("repo", "")
        current_version = repo_config.get("current_version", "")
        standards_file = repo_config.get("standards_file", "")

        if not repo or not current_version or not standards_file:
            print(f"  OWASP: {repo_key} missing required fields, skipping")
            continue

        print(f"  OWASP: checking {repo}...")
        checked += 1

        if dry_run:
            print(f"  OWASP: [dry-run] would check {repo} releases")
            continue

        # Try to fetch latest release first
        release_url = f"https://api.github.com/repos/{repo}/releases/latest"
        resp = api_request(release_url, headers=headers)

        latest_version = None
        if resp is not None and "tag_name" in resp:
            # Extract version from tag (e.g., "v2025" -> "2025", "2025" -> "2025")
            tag = resp.get("tag_name", "")
            latest_version = tag.lstrip("v")
        else:
            # Fallback: fetch latest tag
            tags_url = f"https://api.github.com/repos/{repo}/tags?per_page=1"
            resp = api_request(tags_url, headers=headers)
            if resp is not None and isinstance(resp, list) and len(resp) > 0:
                tag = resp[0].get("name", "")
                latest_version = tag.lstrip("v")

        if latest_version and latest_version != current_version:
            updates_found.append({
                "repo": repo,
                "repo_key": repo_key,
                "standards_file": standards_file,
                "current_version": current_version,
                "latest_version": latest_version,
                "checked_at": datetime.now(timezone.utc).isoformat(),
            })
            print(f"  OWASP: {repo_key}: update available {current_version} → {latest_version}")
        else:
            print(f"  OWASP: {repo_key}: up-to-date ({current_version})")

        time.sleep(1)

    # Write pending updates to standards directory
    if updates_found:
        pending_path = os.path.join(STANDARDS_DIR, "pending-updates.json")
        pending_data = {
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "updates": updates_found,
        }
        if not dry_run:
            with open(pending_path, "w") as f:
                json.dump(pending_data, f, indent=2)
                f.write("\n")
            print(f"  OWASP: wrote {len(updates_found)} updates to pending-updates.json")

