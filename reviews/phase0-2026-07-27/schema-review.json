{
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluateur", "verdict", "synthese", "territoires", "findings", "affirmations_evaluees", "sur_ingenierie", "angle_mort"],
  "properties": {
    "evaluateur": {"type": "string"},
    "verdict": {"type": "string", "enum": ["seal", "revise", "reject"]},
    "synthese": {"type": "string"},
    "territoires": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["nom", "etat", "commentaire"],
        "properties": {
          "nom": {"type": "string", "enum": ["exactitude_factuelle", "doctrine", "trous", "coherence_interne", "proportionnalite", "regressions_du_correctif"]},
          "etat": {"type": "string", "enum": ["propre", "reserves", "defaut"]},
          "commentaire": {"type": "string"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gravite", "territoire", "resume", "citation", "consequence_decisionnelle"],
        "properties": {
          "gravite": {"type": "string", "enum": ["blocker", "majeur", "mineur"]},
          "territoire": {"type": "string"},
          "resume": {"type": "string"},
          "citation": {"type": "string", "description": "fichier + extrait exact, ou NON_VERIFIE"},
          "consequence_decisionnelle": {"type": "string"}
        }
      }
    },
    "affirmations_evaluees": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["numero", "statut", "justification"],
        "properties": {
          "numero": {"type": "integer", "minimum": 1, "maximum": 7},
          "statut": {"type": "string", "enum": ["etabli", "avance_sans_preuve", "faux", "NON_VERIFIE"]},
          "justification": {"type": "string"}
        }
      }
    },
    "sur_ingenierie": {"type": "array", "items": {"type": "string"}},
    "angle_mort": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
