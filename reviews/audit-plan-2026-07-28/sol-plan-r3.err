import glob, importlib.util, json, os, random
root = os.path.realpath(\"../..\")
spec = importlib.util.spec_from_file_location(\"rule_tester\", os.path.join(root, \"scripts\", \"rule-tester.py\"))
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
rng = random.Random(42)
sample = []
by_domain = {}
for file_name in sorted(glob.glob(os.path.join(root, \"knowledge-base\", \"domains\", \"*\", \"cve-rules.json\"))):
    domain = os.path.basename(os.path.dirname(file_name))
    with open(file_name) as handle:
        missing = [rule for rule in json.load(handle) if \"status\" not in rule]
    picked = rng.sample(missing, min(5, len(missing)))
    for rule in picked:
        rule[\"_domain\"] = domain
    sample.extend(picked)
    by_domain[domain] = len(picked)
corpus = mod.load_corpus()
results = [mod.test_rule(rule, corpus) for rule in sample]
counts = {}
for result in results:
    counts[result[\"verdict\"]] = counts.get(result[\"verdict\"], 0) + 1
print(\"sample_count\", len(sample))
print(\"by_domain\", json.dumps(by_domain, sort_keys=True))
print(\"verdicts\", json.dumps(counts, sort_keys=True))
print(\"calculable_precision\", sum(result[\"precision\"] is not None for result in results))
print(\"tp_total\", sum(result[\"tp_count\"] for result in results), \"fp_total\", sum(result[\"fp_count\"] for result in results))
print(\"ids\", \",\".join(rule[\"id\"] for rule in sample))
