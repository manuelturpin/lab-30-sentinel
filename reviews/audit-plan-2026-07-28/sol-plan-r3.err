     1	#!/usr/bin/env python3
     2	"""
     3	Sentinel Rule Tester — validates LLM-generated detection patterns.
     4	
     5	Tests untested CVE rules against a corpus of known-vulnerable and known-safe
     6	code fixtures. Rules passing the precision gate (>=70%) are promoted to "active".
     7	
     8	Usage:
     9	    python3 scripts/rule-tester.py                  # Test all untested rules
    10	    python3 scripts/rule-tester.py --domain api     # Test one domain
    11	    python3 scripts/rule-tester.py --dry-run        # Preview without status changes
    12	    python3 scripts/rule-tester.py --verbose         # Show match details
    13	    python3 scripts/rule-tester.py --precision 0.8   # Custom precision gate
    14	"""
    15	from __future__ import annotations
    16	
    17	
    18	import argparse
    19	import glob
    20	import json
    21	import os
    22	import re
    23	import signal
    24	import sys
    25	import time
    26	from datetime import datetime, timezone
    27	from pathlib import Path
    28	
    29	SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
    30	PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
    31	KB_DIR = os.path.join(PROJECT_ROOT, "knowledge-base")
    32	DOMAINS_DIR = os.path.join(KB_DIR, "domains")
    33	FIXTURES_DIR = os.path.join(PROJECT_ROOT, "tests", "fixtures")
    34	VULN_APP_DIR = os.path.join(PROJECT_ROOT, "tests", "vulnerable-app", "src")
    35	
    36	DEFAULT_PRECISION_GATE = 0.70
    37	BACKTRACK_TIMEOUT_S = 2.0  # Max seconds for a single regex test
    38	
    39	
    40	# ---------------------------------------------------------------------------
    41	# Corpus loading
    42	# ---------------------------------------------------------------------------
    43	
    44	def load_files_from_dir(directory):
    45	    """Load all source files from a directory tree."""
    46	    files = []
    47	    if not os.path.isdir(directory):
    48	        return files
    49	    for root, _, filenames in os.walk(directory):
    50	        for fname in filenames:
    51	            fpath = os.path.join(root, fname)
    52	            try:
    53	                with open(fpath, encoding="utf-8", errors="replace") as f:
    54	                    content = f.read()
    55	                files.append({
    56	                    "path": fpath,
    57	                    "filename": fname,
    58	                    "content": content,
    59	                    "lines": content.splitlines(),
    60	                })
    61	            except IOError:
    62	                pass
    63	    return files
    64	
    65	
    66	def load_corpus():
    67	    """Load the full test corpus: vulnerable + safe files."""
    68	    vulnerable = load_files_from_dir(os.path.join(FIXTURES_DIR, "vulnerable"))
    69	    vulnerable += load_files_from_dir(VULN_APP_DIR)
    70	    safe = load_files_from_dir(os.path.join(FIXTURES_DIR, "safe"))
    71	    return {"vulnerable": vulnerable, "safe": safe}
    72	
    73	
    74	# ---------------------------------------------------------------------------
    75	# Rule loading
    76	# ---------------------------------------------------------------------------
    77	
    78	def load_untested_rules(domain_filter=None):
    79	    """Load all CVE rules with status='untested'."""
    80	    rules = []
    81	    pattern = os.path.join(DOMAINS_DIR, domain_filter or "*", "cve-rules.json")
    82	    for path in sorted(glob.glob(pattern)):
    83	        domain = os.path.basename(os.path.dirname(path))
    84	        with open(path) as f:
    85	            domain_rules = json.load(f)
    86	        for r in domain_rules:
    87	            if r.get("status") == "untested":
    88	                r["_source_path"] = path
    89	                r["_domain"] = domain
    90	                rules.append(r)
    91	    return rules
    92	
    93	
    94	# ---------------------------------------------------------------------------
    95	# Pattern validation
    96	# ---------------------------------------------------------------------------
    97	
    98	def validate_pattern(pattern_str):
    99	    """Validate a regex pattern: compilation and backtracking safety."""
   100	    # Compile check
   101	    try:
   102	        compiled = re.compile(pattern_str)
   103	    except re.error as e:
   104	        return {"valid": False, "error": f"compile: {e}"}
   105	
   106	    # Backtracking check with adversarial inputs
   107	    adversarial_inputs = [
   108	        "a" * 200,
   109	        "a" * 100 + "!" * 100,
   110	        " " * 200,
   111	        "x" * 50 + "\n" * 50 + "y" * 50,
   112	        "aaaa@aaaa.aaaa.aaaa.aaaa.aaaa.aaaa",
   113	    ]
   114	
   115	    for test_input in adversarial_inputs:
   116	        start = time.time()
   117	        try:
   118	            compiled.search(test_input)
   119	        except Exception:
   120	            pass
   121	        elapsed = time.time() - start
   122	        if elapsed > BACKTRACK_TIMEOUT_S:
   123	            return {"valid": False, "error": f"backtracking ({elapsed:.1f}s)"}
   124	
   125	    return {"valid": True, "compiled": compiled}
   126	
   127	
   128	# ---------------------------------------------------------------------------
   129	# File type matching
   130	# ---------------------------------------------------------------------------
   131	
   132	def file_matches_types(filename, file_types):
   133	    """Check if filename matches any of the rule's file_types globs."""
   134	    if not file_types:
   135	        return True  # No filter = match all source files
   136	
   137	    for ft in file_types:
   138	        if ft.startswith("*."):
   139	            ext = ft[1:]  # .js, .py, etc.
   140	            if filename.endswith(ext):
   141	                return True
   142	        elif ft == filename:
   143	            return True
   144	    return False
   145	
   146	
   147	# ---------------------------------------------------------------------------
   148	# Pattern matching engine
   149	# ---------------------------------------------------------------------------
   150	
   151	def scan_file(file_info, patterns, negative_patterns, file_types):
   152	    """Scan a single file with a rule's patterns. Returns list of matches."""
   153	    if not file_matches_types(file_info["filename"], file_types):
   154	        return []
   155	
   156	    matches = []
   157	    for line_num, line in enumerate(file_info["lines"], 1):
   158	        for pattern in patterns:
   159	            try:
   160	                if re.search(pattern, line):
   161	                    # Check negative patterns (mitigations)
   162	                    mitigated = False
   163	                    for neg in negative_patterns:
   164	                        try:
   165	                            if re.search(neg, line):
   166	                                mitigated = True
   167	                                break
   168	                        except re.error:
   169	                            pass
   170	
   171	                    if not mitigated:
   172	                        matches.append({
   173	                            "file": file_info["filename"],
   174	                            "line": line_num,
   175	                            "pattern": pattern,
   176	                            "text": line.strip()[:120],
   177	                        })
   178	            except re.error:
   179	                pass
   180	
   181	    return matches
   182	
   183	
   184	def run_rule_against_corpus(rule, corpus_files):
   185	    """Run a rule's patterns against a list of files."""
   186	    patterns = rule.get("detect", {}).get("patterns", [])
   187	    negative_patterns = rule.get("detect", {}).get("negative_patterns", [])
   188	    file_types = rule.get("detect", {}).get("file_types", [])
   189	
   190	    all_matches = []
   191	    for file_info in corpus_files:
   192	        matches = scan_file(file_info, patterns, negative_patterns, file_types)
   193	        all_matches.extend(matches)
   194	
   195	    return all_matches
   196	
   197	
   198	# ---------------------------------------------------------------------------
   199	# Rule testing
   200	# ---------------------------------------------------------------------------
   201	
   202	def test_rule(rule, corpus, precision_gate=DEFAULT_PRECISION_GATE, verbose=False):
   203	    """Test a single rule. Returns a result dict with scores."""
   204	    rule_id = rule["id"]
   205	    patterns = rule.get("detect", {}).get("patterns", [])
   206	
   207	    result = {
   208	        "id": rule_id,
   209	        "domain": rule.get("_domain"),
   210	        "title": rule.get("title", "")[:60],
   211	        "confidence": rule.get("confidence", 0),
   212	        "pattern_count": len(patterns),
   213	        "patterns_valid": 0,
   214	        "patterns_invalid": [],
   215	        "tp_count": 0,
   216	        "fp_count": 0,
   217	        "tp_matches": [],
   218	        "fp_matches": [],
   219	        "precision": None,
   220	        "verdict": "inconclusive",
   221	    }
   222	
   223	    # Step 1: Validate patterns
   224	    valid_patterns = []
   225	    for p in patterns:
   226	        check = validate_pattern(p)
   227	        if check["valid"]:
   228	            result["patterns_valid"] += 1
   229	            valid_patterns.append(p)
   230	        else:
   231	            result["patterns_invalid"].append({"pattern": p, "error": check["error"]})
   232	
   233	    if result["patterns_valid"] == 0:
   234	        result["verdict"] = "invalid"
   235	        return result
   236	
   237	    # Step 2: True positives — matches in vulnerable corpus
   238	    tp_matches = run_rule_against_corpus(rule, corpus["vulnerable"])
   239	    result["tp_matches"] = tp_matches
   240	    result["tp_count"] = len(tp_matches)
   241	
   242	    # Step 3: False positives — matches in safe corpus
   243	    fp_matches = run_rule_against_corpus(rule, corpus["safe"])
   244	    result["fp_matches"] = fp_matches
   245	    result["fp_count"] = len(fp_matches)
   246	
   247	    # Step 4: Calculate precision
   248	    tp = result["tp_count"]
   249	    fp = result["fp_count"]
   250	
   251	    if tp + fp == 0:
   252	        result["verdict"] = "no-matches"
   253	        result["precision"] = None
   254	    elif tp == 0 and fp > 0:
   255	        result["precision"] = 0.0
   256	        result["verdict"] = "fp-only"
   257	    else:
   258	        result["precision"] = tp / (tp + fp)
   259	        result["verdict"] = "pass" if result["precision"] >= precision_gate else "fail"
   260	
   261	    if verbose:
   262	        if tp_matches:
   263	            print(f"    TP ({tp}):")
   264	            for m in tp_matches[:5]:
   265	                print(f"      {m['file']}:{m['line']} [{m['pattern'][:40]}] → {m['text'][:60]}")
   266	            if tp > 5:
   267	                print(f"      ... and {tp - 5} more")
   268	        if fp_matches:
   269	            print(f"    FP ({fp}):")
   270	            for m in fp_matches[:5]:
   271	                print(f"      {m['file']}:{m['line']} [{m['pattern'][:40]}] → {m['text'][:60]}")
   272	            if fp > 5:
   273	                print(f"      ... and {fp - 5} more")
   274	
   275	    return result
   276	
