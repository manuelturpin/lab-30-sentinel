/bin/zsh -lc "manifest_path='reviews/audit-plan-2026-07-28/CORPUS-MANIFEST.json'
current_bad=0
current_total=0
current_count=0
while IFS="'$'"'\\t' read -r path expected_hash expected_bytes; do
  actual_hash="'$(shasum -a 256 "$path" | awk '"'{print "'$1}'"')
  actual_bytes="'$(wc -c < "$path" | tr -d '"' ')
  current_count="'$((current_count + 1))
  current_total=$((current_total + actual_bytes))
  if [[ "$actual_hash" != "$expected_hash" || "$actual_bytes" != "$expected_bytes" ]]; then
    print -r -- "CURRENT_MISMATCH'"\\t"'$path'"\\t"'$expected_hash'"\\t"'$actual_hash'"\\t"'$expected_bytes'"\\t"'$actual_bytes"
    current_bad=$((current_bad + 1))
  fi
done < <(jq -r '"'.files | to_entries[] | [.key,.value.sha256,(.value.bytes|tostring)] | @tsv' \""'$manifest_path")
print -r -- "CURRENT_SUMMARY'"\\tcount="'$current_count'"\\tbytes="'$current_total'"\\tmismatches="'$current_bad"
commit_bad=0
commit_count=0
while IFS=$'"'\\t' read -r path expected_hash; do
  commit_hash="'$(git show "824275d:$path" | shasum -a 256 | awk '"'{print "'$1}'"')
  commit_count="'$((commit_count + 1))
  if [[ "$commit_hash" != "$expected_hash" ]]; then
    print -r -- "COMMIT_MISMATCH'"\\t"'$path'"\\t"'$expected_hash'"\\t"'$commit_hash"
    commit_bad=$((commit_bad + 1))
  fi
done < <(jq -r --argjson round_paths '"'[\"reviews/audit-plan-2026-07-28/pipeline-output-active.json\",\"reviews/audit-plan-2026-07-28/rule-tester-run.log\",\"reviews/audit-plan-2026-07-28/gate-probe.log\"]' '.files | to_entries[] | select(.key as "'$k | ($round_paths | index($k) | not)) | [.key,.value.sha256] | @tsv'"' \""'$manifest_path")
print -r -- "COMMIT_SUMMARY'"\\tcount="'$commit_count'"\\tmismatches="'$commit_bad"
print -r -- "DIFF_67_BEGIN"
git diff --name-status 824275d..HEAD -- $(jq -r --argjson round_paths '"'[\"reviews/audit-plan-2026-07-28/pipeline-output-active.json\",\"reviews/audit-plan-2026-07-28/rule-tester-run.log\",\"reviews/audit-plan-2026-07-28/gate-probe.log\"]' '.files | keys[] | select(. as "'$k | ($round_paths | index($k) | not))'"' \""'$manifest_path")
print -r -- "DIFF_67_END"
print -r -- "EXPLICIT_HASHES"
for path in skills/security/SKILL.md scripts/rule-tester.py tests/vulnerable-app/src/server.js rag/query.py reviews/audit-plan-2026-07-28/gate-probe.log; do
  print -r -- "$path'"\\t"'$(shasum -a 256 "$path" | awk '"'{print "'$1}'"')\\t"'$(wc -c < "$path" | tr -d '"' ')\"
done" in /Users/manuelturpin/Desktop/bonsai974/claude/lab/lab-30-sentinel
