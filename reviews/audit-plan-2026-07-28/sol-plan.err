    99	    pattern = os.path.join(DOMAINS_DIR, domain_filter or "*", "cve-rules.json")
   100	    for path in sorted(glob.glob(pattern)):
   101	        domain = os.path.basename(os.path.dirname(path))
   102	        with open(path) as f:
   103	            domain_rules = json.load(f)
   104	        for r in domain_rules:
   105	            if not r.get("detect", {}).get("patterns"):
   106	                # Skip rules that were already LLM-generated
   107	                if r.get("generated_by") == "llm":
   108	                    continue
   109	                r["_source_path"] = path
   110	                r["_domain"] = domain
   111	                rules.append(r)
   112	    return rules
   113	
   114	
   115	def prioritize_rules(rules, kev_ids):
   116	    """Sort rules by priority: KEV > CVSS>=9 > CVSS>=7+EPSS>=0.5 > rest."""
   117	    def priority_key(r):
   118	        is_kev = r["id"] in kev_ids
   119	        cvss = r.get("cvss_v4") or 0
   120	        epss = r.get("epss_score") or 0
   121	        if is_kev:
   122	            return (0, -cvss)
   123	        if cvss >= 9.0:
   124	            return (1, -cvss)
   125	        if cvss >= 7.0 and epss >= 0.5:
   126	            return (2, -epss)
   127	        return (3, -cvss)
   128	
   129	    rules.sort(key=priority_key)
   130	    return rules
   131	
   132	
   133	def priority_label(rule, kev_ids):
   134	    """Human-readable priority label for a rule."""
   135	    if rule["id"] in kev_ids:
   136	        return "KEV"
   137	    cvss = rule.get("cvss_v4") or 0
   138	    epss = rule.get("epss_score") or 0
   139	    if cvss >= 9.0:
   140	        return f"CVSS {cvss}"
   141	    if cvss >= 7.0 and epss >= 0.5:
   142	        return f"CVSS {cvss} + EPSS {epss:.2f}"
   143	    return f"CVSS {cvss}"
