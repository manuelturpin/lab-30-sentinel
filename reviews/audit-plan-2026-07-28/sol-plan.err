    94	# ---------------------------------------------------------------------------
    95	# Pattern validation
    96	# ---------------------------------------------------------------------------
    97	
    98	def validate_pattern(pattern_str):
    99	    """Validate a regex pattern: compilation and backtracking safety."""
   100	    # Compile check
   101	    try:
   102	        compiled = re.compile(pattern_str)
   103	    except re.error as e:
   104	        return {"valid": False, "error": f"compile: {e}"}
   105	
   106	    # Backtracking check with adversarial inputs
   107	    adversarial_inputs = [
   108	        "a" * 200,
   109	        "a" * 100 + "!" * 100,
   110	        " " * 200,
   111	        "x" * 50 + "\n" * 50 + "y" * 50,
   112	        "aaaa@aaaa.aaaa.aaaa.aaaa.aaaa.aaaa",
   113	    ]
   114	
   115	    for test_input in adversarial_inputs:
   116	        start = time.time()
   117	        try:
   118	            compiled.search(test_input)
   119	        except Exception:
   120	            pass
   121	        elapsed = time.time() - start
   122	        if elapsed > BACKTRACK_TIMEOUT_S:
   123	            return {"valid": False, "error": f"backtracking ({elapsed:.1f}s)"}
   124	
   125	    return {"valid": True, "compiled": compiled}
