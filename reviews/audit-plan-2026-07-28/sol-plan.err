    38	type Ecosystem = "npm" | "pypi" | "go" | "cargo" | "gem" | "maven";
    39	
    40	function detectEcosystem(projectPath: string): Ecosystem | null {
    41	  const checks: Array<{ file: string; ecosystem: Ecosystem }> = [
    42	    { file: "package-lock.json", ecosystem: "npm" },
    43	    { file: "yarn.lock", ecosystem: "npm" },
    44	    { file: "requirements.txt", ecosystem: "pypi" },
    45	    { file: "Pipfile.lock", ecosystem: "pypi" },
    46	    { file: "go.sum", ecosystem: "go" },
    47	    { file: "Cargo.lock", ecosystem: "cargo" },
    48	    { file: "Gemfile.lock", ecosystem: "gem" },
    49	    { file: "pom.xml", ecosystem: "maven" },
    50	  ];
    51	
    52	  for (const check of checks) {
    53	    if (fs.existsSync(path.join(projectPath, check.file))) {
    54	      return check.ecosystem;
    55	    }
    56	  }
    57	  return null;
    58	}
    59	
    60	function parseNpmLockfile(projectPath: string): PackageInfo[] {
    61	  const packages: PackageInfo[] = [];
    62	
    63	  // Try package-lock.json first
    64	  const lockPath = path.join(projectPath, "package-lock.json");
    65	  if (fs.existsSync(lockPath)) {
    66	    try {
    67	      const content = JSON.parse(fs.readFileSync(lockPath, "utf-8"));
    68	
    69	      // v3 lockfile format (packages)
    70	      if (content.packages) {
    71	        for (const [pkgPath, info] of Object.entries(content.packages)) {
    72	          if (pkgPath === "") continue; // root package
    73	          const name = pkgPath.replace(/^node_modules\//, "");
    74	          const version = (info as { version?: string }).version;
    75	          if (name && version) {
    76	            packages.push({ name, version });
    77	          }
    78	        }
    79	      }
    80	      // v1 lockfile format (dependencies)
    81	      else if (content.dependencies) {
    82	        for (const [name, info] of Object.entries(content.dependencies)) {
    83	          const version = (info as { version?: string }).version;
    84	          if (version) {
    85	            packages.push({ name, version });
    86	          }
    87	        }
    88	      }
    89	    } catch {
    90	      // Invalid JSON
    91	    }
    92	    return packages;
    93	  }
    94	
    95	  // Try yarn.lock (simpler parsing)
    96	  const yarnPath = path.join(projectPath, "yarn.lock");
    97	  if (fs.existsSync(yarnPath)) {
    98	    try {
    99	      const content = fs.readFileSync(yarnPath, "utf-8");
   100	      const lines = content.split("\n");
   101	      let currentPkg = "";
   102	
   103	      for (const line of lines) {
   104	        // Package header line: "package@version:"
   105	        const headerMatch = line.match(/^"?([^@\s]+)@[^"]*"?:$/);
   106	        if (headerMatch) {
   107	          currentPkg = headerMatch[1];
   108	          continue;
   109	        }
   110	        // Version line
   111	        const versionMatch = line.match(/^\s+version\s+"([^"]+)"/);
   112	        if (versionMatch && currentPkg) {
   113	          packages.push({ name: currentPkg, version: versionMatch[1] });
   114	          currentPkg = "";
   115	        }
   116	      }
   117	    } catch {
   118	      // Invalid file
   119	    }
   120	  }
   121	
   122	  return packages;
   123	}
   124	
   125	function parsePypiDeps(projectPath: string): PackageInfo[] {
   126	  const packages: PackageInfo[] = [];
   127	
   128	  const reqPath = path.join(projectPath, "requirements.txt");
   129	  if (fs.existsSync(reqPath)) {
   130	    try {
   131	      const content = fs.readFileSync(reqPath, "utf-8");
   132	      for (const line of content.split("\n")) {
   133	        const trimmed = line.trim();
   134	        if (!trimmed || trimmed.startsWith("#") || trimmed.startsWith("-")) continue;
   135	        const match = trimmed.match(/^([a-zA-Z0-9_.-]+)==([a-zA-Z0-9_.]+)/);
   136	        if (match) {
   137	          packages.push({ name: match[1], version: match[2] });
   138	        }
   139	      }
   140	    } catch { /* skip */ }
   141	    return packages;
   142	  }
   143	
   144	  const pipfilePath = path.join(projectPath, "Pipfile.lock");
   145	  if (fs.existsSync(pipfilePath)) {
   146	    try {
   147	      const content = JSON.parse(fs.readFileSync(pipfilePath, "utf-8"));
   148	      const defaultDeps = content.default || {};
   149	      for (const [name, info] of Object.entries(defaultDeps)) {
   150	        const version = (info as { version?: string }).version?.replace("==", "");
   151	        if (version) {
   152	          packages.push({ name, version });
   153	        }
   154	      }
   155	    } catch { /* skip */ }
   156	  }
   157	
   158	  return packages;
   159	}
   160	
   161	function parseGoSum(projectPath: string): PackageInfo[] {
   162	  const packages: PackageInfo[] = [];
   163	  const sumPath = path.join(projectPath, "go.sum");
   164	
   165	  if (!fs.existsSync(sumPath)) return packages;
   166	
   167	  try {
   168	    const content = fs.readFileSync(sumPath, "utf-8");
   169	    const seen = new Set<string>();
   170	
   171	    for (const line of content.split("\n")) {
   172	      const match = line.match(/^(\S+)\s+v([^\s/]+)/);
   173	      if (match) {
   174	        const key = `${match[1]}@${match[2]}`;
   175	        if (!seen.has(key)) {
   176	          seen.add(key);
   177	          packages.push({ name: match[1], version: match[2] });
   178	        }
   179	      }
   180	    }
   181	  } catch { /* skip */ }
   182	
   183	  return packages;
   184	}
   185	
   186	function parseCargoLock(projectPath: string): PackageInfo[] {
   187	  const packages: PackageInfo[] = [];
   188	  const lockPath = path.join(projectPath, "Cargo.lock");
   189	
   190	  if (!fs.existsSync(lockPath)) return packages;
   191	
   192	  try {
   193	    const content = fs.readFileSync(lockPath, "utf-8");
   194	    const blocks = content.split("[[package]]");
   195	
   196	    for (const block of blocks.slice(1)) {
   197	      const nameMatch = block.match(/name\s*=\s*"([^"]+)"/);
   198	      const versionMatch = block.match(/version\s*=\s*"([^"]+)"/);
   199	      if (nameMatch && versionMatch) {
   200	        packages.push({ name: nameMatch[1], version: versionMatch[1] });
   201	      }
   202	    }
   203	  } catch { /* skip */ }
   204	
   205	  return packages;
   206	}
   207	
   208	function parseGemfileLock(projectPath: string): PackageInfo[] {
   209	  const packages: PackageInfo[] = [];
   210	  const lockPath = path.join(projectPath, "Gemfile.lock");
   211	
   212	  if (!fs.existsSync(lockPath)) return packages;
   213	
   214	  try {
   215	    const content = fs.readFileSync(lockPath, "utf-8");
   216	    let inSpecs = false;
   217	
   218	    for (const line of content.split("\n")) {
   219	      if (line.trim() === "specs:") {
   220	        inSpecs = true;
   221	        continue;
   222	      }
   223	      if (inSpecs && line.match(/^\S/)) {
   224	        inSpecs = false;
   225	        continue;
   226	      }
   227	      if (inSpecs) {
   228	        const match = line.match(/^\s{4}(\S+)\s+\(([^)]+)\)/);
   229	        if (match) {
   230	          packages.push({ name: match[1], version: match[2] });
   231	        }
   232	      }
   233	    }
   234	  } catch { /* skip */ }
   235	
   236	  return packages;
   237	}
   238	
   239	function parseDependencies(projectPath: string, ecosystem: Ecosystem): PackageInfo[] {
   240	  switch (ecosystem) {
   241	    case "npm": return parseNpmLockfile(projectPath);
   242	    case "pypi": return parsePypiDeps(projectPath);
   243	    case "go": return parseGoSum(projectPath);
   244	    case "cargo": return parseCargoLock(projectPath);
   245	    case "gem": return parseGemfileLock(projectPath);
   246	    case "maven": return []; // Maven lockfile parsing is complex; skip for now
   247	  }
   248	}
