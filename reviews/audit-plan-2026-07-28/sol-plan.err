     2	  "collection_name": "sentinel_kb",
     3	  "embedding_model": "BAAI/bge-base-en-v1.5",
     4	  "query_prefix": "Represent this sentence for searching relevant passages: ",
     5	  "chromadb_path": "./chromadb",
     6	  "sources": [
     7	    "../knowledge-base/domains/*/rules.json",
     8	    "../knowledge-base/domains/*/cve-rules.json",
     9	    "../knowledge-base/domains/*/patterns/*.json",
    10	    "../knowledge-base/standards/*.json",
    11	    "../knowledge-base/cve-feed/*.json"
    12	  ]
