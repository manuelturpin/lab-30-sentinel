   341	
   342	    file_types = data.get("file_types", [])
   343	    if not isinstance(file_types, list):
   344	        file_types = []
   345	    file_types = [ft for ft in file_types if isinstance(ft, str) and ft.strip()]
   346	
   347	    negative_patterns = data.get("negative_patterns", [])
   348	    if not isinstance(negative_patterns, list):
   349	        negative_patterns = []
   350	    negative_patterns = [np for np in negative_patterns if isinstance(np, str) and np.strip()]
   351	
   352	    exclude = data.get("exclude", [])
   353	    if not isinstance(exclude, list):
   354	        exclude = []
   355	    exclude = [e for e in exclude if isinstance(e, str) and e.strip()]
   356	
   357	    confidence = data.get("confidence", 0.5)
   358	    if not isinstance(confidence, (int, float)):
   359	        confidence = 0.5
   360	    confidence = max(0.0, min(1.0, float(confidence)))
   361	
   362	    return {
   363	        "patterns": valid_patterns,
   364	        "file_types": file_types,
   365	        "negative_patterns": negative_patterns,
   366	        "exclude": exclude,
   367	        "confidence": confidence,
   368	    }
