   560	# ===========================================================================
   561	# Subcommand: report
   562	# ===========================================================================
   563	
   564	def cmd_report(args):
   565	    """Show feedback statistics and rule health."""
   566	    feedback = load_feedback()
   567	    rules = load_all_cve_rules()
   568	
   569	    entries = feedback.get("entries", [])
   570	    if not entries:
   571	        print("No feedback entries yet. Run 'seed' or 'ingest' first.")
   572	        return
   573	
   574	    # Overall stats
   575	    verdicts = Counter(e["verdict"] for e in entries)
   576	    projects = Counter(e.get("project", "unknown") for e in entries)
   577	    rules_with_feedback = Counter(e["rule_id"] for e in entries)
   578	
   579	    print("=" * 60)
   580	    print("Sentinel Feedback Report")
   581	    print("=" * 60)
   582	
   583	    print(f"\nTotal entries: {len(entries)}")
   584	    print(f"  True positives:  {verdicts.get('tp', 0)}")
   585	    print(f"  False positives: {verdicts.get('fp', 0)}")
   586	    overall_prec = verdicts["tp"] / (verdicts["tp"] + verdicts["fp"]) if verdicts["tp"] + verdicts["fp"] > 0 else 0
   587	    print(f"  Overall precision: {overall_prec:.1%}")
   588	
   589	    print(f"\nRules with feedback: {len(rules_with_feedback)}")
   590	    print(f"Projects: {', '.join(f'{p}={c}' for p, c in projects.most_common(5))}")
   591	
   592	    # Per-rule breakdown
   593	    print(f"\n{'Rule ID':24s} {'Domain':14s} {'TP':>4s} {'FP':>4s} {'Prec':>6s} {'Conf':>6s} {'Status':12s}")
   594	    print("-" * 80)
   595	
   596	    rule_stats = defaultdict(lambda: {"tp": 0, "fp": 0})
   597	    for e in entries:
   598	        rule_stats[e["rule_id"]][e["verdict"]] += 1
   599	
   600	    for rid, stats in sorted(rule_stats.items(), key=lambda x: -(x[1]["tp"] + x[1]["fp"])):
   601	        rule = rules.get(rid, {})
   602	        tp = stats.get("tp", 0)
   603	        fp = stats.get("fp", 0)
   604	        total = tp + fp
   605	        prec = tp / total if total > 0 else 0
   606	        conf = rule.get("confidence", 0)
   607	        domain = rule.get("_domain", "?")
   608	        status = rule.get("status", "?")
   609	
   610	        print(f"{rid:24s} {domain:14s} {tp:4d} {fp:4d} {prec:6.1%} {conf:6.2f} {status:12s}")
   611	
   612	    # Pattern-level stats (top FP patterns)
   613	    pattern_stats = defaultdict(lambda: {"tp": 0, "fp": 0, "rules": set()})
   614	    for e in entries:
   615	        if e.get("pattern"):
   616	            pat = e["pattern"][:80]
   617	            pattern_stats[pat][e["verdict"]] += 1
   618	            pattern_stats[pat]["rules"].add(e["rule_id"])
   619	
   620	    fp_heavy = [(pat, s) for pat, s in pattern_stats.items()
   621	                if s["fp"] > 0 and s["tp"] / (s["tp"] + s["fp"]) < 0.5]
   622	
   623	    if fp_heavy:
   624	        print(f"\n--- FP-Heavy Patterns (precision < 50%) ---")
   625	        for pat, s in sorted(fp_heavy, key=lambda x: x[1]["fp"], reverse=True)[:10]:
   626	            prec = s["tp"] / (s["tp"] + s["fp"])
   627	            print(f"  {pat[:60]:60s} tp={s['tp']} fp={s['fp']} prec={prec:.0%}")
   628	
   629	    print(f"\n{'=' * 60}")
   630	
   631	
   632	# ===========================================================================
   633	# Main
   634	# ===========================================================================
   635	
   636	def main():
   637	    parser = argparse.ArgumentParser(
   638	        description="Sentinel Feedback Loop — FP/TP ingestion, confidence scoring, cross-domain propagation")
   639	    subparsers = parser.add_subparsers(dest="command", help="Subcommand")
   640	
   641	    # ingest
   642	    p_ingest = subparsers.add_parser("ingest", help="Record a TP/FP feedback entry")
   643	    p_ingest.add_argument("--rule", required=True, help="Rule ID (e.g., CVE-2021-22054)")
   644	    p_ingest.add_argument("--verdict", required=True, choices=["tp", "fp"], help="True positive or false positive")
   645	    p_ingest.add_argument("--file", help="Source file where match occurred")
   646	    p_ingest.add_argument("--line", type=int, help="Line number")
   647	    p_ingest.add_argument("--pattern", help="The specific regex pattern that matched")
   648	    p_ingest.add_argument("--context", help="Matched line content")
   649	    p_ingest.add_argument("--project", help="Project name")
   650	
   651	    # seed
   652	    p_seed = subparsers.add_parser("seed", help="Auto-seed feedback from rule-tester.py results")
   653	
   654	    # score
   655	    p_score = subparsers.add_parser("score", help="Recalculate confidence from feedback")
   656	    p_score.add_argument("--dry-run", action="store_true", help="Preview without applying")
   657	
   658	    # propagate
   659	    p_propagate = subparsers.add_parser("propagate", help="Cross-domain pattern propagation")
   660	    p_propagate.add_argument("--apply", action="store_true", help="Apply propagation (default: preview)")
   661	
   662	    # report
   663	    p_report = subparsers.add_parser("report", help="Show feedback statistics")
   664	
   665	    args = parser.parse_args()
   666	
   667	    if args.command is None:
   668	        parser.print_help()
   669	        return
   670	
   671	    commands = {
   672	        "ingest": cmd_ingest,
   673	        "seed": cmd_seed,
   674	        "score": cmd_score,
   675	        "propagate": cmd_propagate,
   676	        "report": cmd_report,
   677	    }
   678	    commands[args.command](args)
   679	
   680	
   681	if __name__ == "__main__":
   682	    main()

