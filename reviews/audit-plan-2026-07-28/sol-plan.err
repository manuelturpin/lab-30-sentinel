   670	# ---------------------------------------------------------------------------
   671	# Main
   672	# ---------------------------------------------------------------------------
   673	def main():
   674	    parser = argparse.ArgumentParser(description="Sentinel CVE Sync")
   675	    parser.add_argument("--dry-run", action="store_true", help="Preview without writing")
   676	    parser.add_argument("--days", type=int, default=None, help="Number of days to look back (default: 30 on first run)")
   677	    args = parser.parse_args()
   678	
   679	    print("=" * 60)
   680	    print("Sentinel CVE Sync")
   681	    print("=" * 60)
   682	
   683	    config = load_config()
   684	
   685	    # Determine start date
   686	    last_sync = config.get("last_sync")
   687	    if args.days:
   688	        start_date = datetime.now(timezone.utc) - timedelta(days=args.days)
   689	        print(f"Looking back {args.days} days (--days override)")
   690	    elif last_sync:
   691	        start_date = datetime.fromisoformat(last_sync.replace("Z", "+00:00"))
   692	        print(f"Syncing since last run: {last_sync}")
   693	    else:
   694	        start_date = datetime.now(timezone.utc) - timedelta(days=30)
   695	        print("First run — fetching last 30 days")
   696	
   697	    if args.dry_run:
   698	        print("[DRY RUN — no files will be written]")
   699	
   700	    print()
   701	    totals = {}
   702	
   703	    # 1. NVD
   704	    print("[1/6] NVD API 2.0")
   705	    totals["nvd"] = sync_nvd(config, start_date, args.dry_run)
   706	
   707	    # 2. OSV
   708	    print("[2/6] OSV API")
   709	    totals["osv"] = sync_osv(config, start_date, args.dry_run)
   710	
   711	    # 3. GitHub Advisories
   712	    print("[3/6] GitHub Security Advisories")
   713	    totals["github"] = sync_github(config, start_date, args.dry_run)
   714	
   715	    # 4. EPSS
   716	    print("[4/6] EPSS Scores")
   717	    totals["epss"] = sync_epss(config, args.dry_run)
   718	
   719	    # 5. KEV
   720	    print("[5/6] CISA KEV Catalog")
   721	    totals["kev"] = sync_kev(config, args.dry_run)
   722	
   723	    # 6. Standards
   724	    print("[6/6] OWASP/CWE Standards")
   725	    totals["standards"] = sync_standards(config, args.dry_run)
   726	
   727	    # Update sync metadata
   728	    if not args.dry_run:
   729	        config["last_sync"] = datetime.now(timezone.utc).isoformat()
   730	        config["last_sync_status"] = {
   731	            "timestamp": datetime.now(timezone.utc).isoformat(),
   732	            "results": totals,
   733	            "success": True,
   734	        }
   735	        save_config(config)
   736	
   737	    # Summary
   738	    print()
   739	    print("=" * 60)
   740	    print("Summary:")
   741	    for source, count in totals.items():
   742	        print(f"  {source}: {count} entries processed")
   743	    total = sum(totals.values())
   744	    print(f"  Total: {total}")
   745	    print("=" * 60)
   746	
   747	    return 0
   748	
