     1	"""
     2	Sentinel RAG Query — CLI for querying the Knowledge Base via ChromaDB.
     3	Supports hybrid search (BM25 + semantic + cross-encoder reranking) with RRF.
     4	
     5	Pipeline: Query → ID routing (exact) → Hybrid search (semantic + BM25/RRF) → Top-k
     6	
     7	Usage:
     8	    python3 query.py --query "SQL injection" --domain all --limit 10
     9	    python3 query.py --query "CWE-89" --limit 1
    10	
    11	Outputs JSON to stdout for consumption by the TypeScript MCP server.
    12	"""
    13	
    14	import argparse
    15	import json
    16	import os
    17	import re
    18	import sys
    19	from collections import defaultdict
    20	
    21	try:
    22	    import chromadb
    23	    from sentence_transformers import SentenceTransformer
    24	except ImportError as _imp_err:
    25	    print(f"Missing dependency: {_imp_err}\nInstall with: pip install sentence-transformers chromadb", file=sys.stderr)
    26	    sys.exit(1)
    27	
    28	try:
    29	    from rank_bm25 import BM25Okapi
    30	    HAS_BM25 = True
    31	except ImportError:
    32	    HAS_BM25 = False
    33	
    34	
    35	CONFIG_PATH = os.path.join(os.path.dirname(__file__), "config.json")
    36	
    37	# Regex for exact identifier queries
    38	ID_PATTERN = re.compile(
    39	    r'^(?:CVE-\d{4}-\d{4,}|CWE-\d+|[A-Z]+-[A-Z]+-\d+|A\d{2}|AML\.TA\d{4})$',
    40	    re.IGNORECASE,
    41	)
    42	
    43	
    44	def load_config():
    45	    with open(CONFIG_PATH) as f:
    46	        return json.load(f)
    47	
    48	
    49	def _tokenize(text: str) -> list[str]:
    50	    """Tokenize preserving CVE/CWE/rule identifiers as single tokens."""
    51	    text = text.lower()
    52	    return re.findall(r'cve-\d{4}-\d+|cwe-\d+|[a-z]+-[a-z]+-\d+|[a-z0-9]+', text)
    53	
    54	
    55	def _rrf_fuse(semantic_ids: list[str], bm25_ids: list[str], alpha: float = 0.6, k: int = 60) -> list[str]:
    56	    """Reciprocal Rank Fusion of semantic and BM25 results."""
    57	    scores = defaultdict(float)
    58	    for rank, doc_id in enumerate(semantic_ids):
    59	        scores[doc_id] += alpha * (1.0 / (k + rank + 1))
    60	    for rank, doc_id in enumerate(bm25_ids):
    61	        scores[doc_id] += (1 - alpha) * (1.0 / (k + rank + 1))
    62	    return [doc_id for doc_id, _ in sorted(scores.items(), key=lambda x: x[1], reverse=True)]
    63	
    64	
    65	def query_kb(query: str, domain: str = "all", limit: int = 10) -> dict:
    66	    """Query ChromaDB with hybrid search (semantic + BM25 via RRF)."""
    67	    config = load_config()
    68	    chromadb_path = os.path.join(os.path.dirname(__file__), config["chromadb_path"])
    69	
    70	    if not os.path.isdir(chromadb_path):
    71	        return {
    72	            "query": query, "domain": domain, "totalResults": 0, "results": [],
    73	            "error": f"ChromaDB directory not found at {chromadb_path}. Run indexer.py first.",
    74	        }
    75	
    76	    client = chromadb.PersistentClient(path=chromadb_path)
    77	
    78	    try:
    79	        collection = client.get_collection(config["collection_name"])
    80	    except ValueError:
    81	        return {
    82	            "query": query, "domain": domain, "totalResults": 0, "results": [],
    83	            "error": "Collection not found. Run indexer.py first.",
    84	        }
    85	
    86	    count = collection.count()
    87	    if count == 0:
    88	        return {"query": query, "domain": domain, "totalResults": 0, "results": []}
    89	
    90	    # Build where filter for domain
    91	    where_filter = None
    92	    if domain != "all":
    93	        where_filter = {"domain": domain}
    94	
    95	    # --- Query routing: exact ID → metadata filter ---
    96	    query_stripped = query.strip()
    97	    if ID_PATTERN.match(query_stripped):
    98	        # Try exact match by ID first
    99	        try:
   100	            exact = collection.get(ids=[query_stripped.upper()], include=["documents", "metadatas"])
   101	            if exact["ids"]:
   102	                entries = []
   103	                for i, doc_id in enumerate(exact["ids"]):
   104	                    meta = exact["metadatas"][i] if exact["metadatas"] else {}
   105	                    standards_raw = meta.get("standards", "[]")
   106	                    try:
   107	                        standards = json.loads(standards_raw) if isinstance(standards_raw, str) else standards_raw
   108	                    except json.JSONDecodeError:
   109	                        standards = [standards_raw] if standards_raw else []
   110	                    if isinstance(standards, str):
   111	                        standards = [standards]
   112	                    entries.append({
   113	                        "id": doc_id, "score": 1.0,
   114	                        "domain": meta.get("domain", ""), "title": meta.get("title", ""),
   115	                        "severity": meta.get("severity", "UNKNOWN"),
   116	                        "description": exact["documents"][i] if exact["documents"] else "",
   117	                        "standards": standards, "source": meta.get("source", ""),
   118	                    })
   119	                return {"query": query, "domain": domain, "totalResults": len(entries), "results": entries}
   120	        except Exception:
   121	            pass  # Fall through to hybrid search
   122	
   123	    # --- Semantic search ---
   124	    n_fetch = min(limit * 3, count)
   125	    model = SentenceTransformer(config["embedding_model"])
   126	    query_prefix = config.get("query_prefix", "")
   127	    prefixed_query = query_prefix + query[:1000]
   128	    query_embedding = model.encode([prefixed_query], normalize_embeddings=True).tolist()
   129	
   130	    sem_results = collection.query(
   131	        query_embeddings=query_embedding,
   132	        n_results=n_fetch,
   133	        where=where_filter,
   134	        include=["documents", "metadatas", "distances"],
   135	    )
   136	
   137	    sem_ids = sem_results["ids"][0] if sem_results["ids"] else []
   138	    sem_docs = sem_results["documents"][0] if sem_results["documents"] else []
   139	    sem_metas = sem_results["metadatas"][0] if sem_results["metadatas"] else []
   140	    sem_dists = sem_results["distances"][0] if sem_results["distances"] else []
   141	
   142	    # Build doc lookup from semantic results
   143	    doc_lookup = {}
   144	    for i, doc_id in enumerate(sem_ids):
   145	        doc_lookup[doc_id] = {
   146	            "document": sem_docs[i] if i < len(sem_docs) else "",
   147	            "metadata": sem_metas[i] if i < len(sem_metas) else {},
   148	            "distance": sem_dists[i] if i < len(sem_dists) else 1.0,
   149	        }
   150	
   151	    # --- BM25 search (if available) ---
   152	    if HAS_BM25 and sem_docs:
   153	        tokenized_docs = [_tokenize(doc) for doc in sem_docs]
   154	        bm25 = BM25Okapi(tokenized_docs)
   155	        query_tokens = _tokenize(query)
   156	        bm25_scores = bm25.get_scores(query_tokens)
   157	
   158	        # Rank by BM25 score
   159	        bm25_ranked = sorted(
   160	            [(sem_ids[i], bm25_scores[i]) for i in range(len(sem_ids)) if bm25_scores[i] > 0],
   161	            key=lambda x: x[1], reverse=True,
   162	        )
   163	        bm25_ids = [doc_id for doc_id, _ in bm25_ranked]
   164	
   165	        # RRF fusion
   166	        fused_ids = _rrf_fuse(sem_ids, bm25_ids, alpha=0.6, k=60)
   167	    else:
   168	        fused_ids = sem_ids
   169	
   170	    # --- Build response ---
   171	    entries = []
   172	    for doc_id in fused_ids[:limit]:
   173	        if doc_id not in doc_lookup:
   174	            continue
   175	        info = doc_lookup[doc_id]
   176	        meta = info["metadata"]
   177	        distance = info["distance"]
   178	        score = round(max(0, 1 - distance / 2), 4)
   179	
   180	        standards_raw = meta.get("standards", "[]")
   181	        try:
   182	            standards = json.loads(standards_raw) if isinstance(standards_raw, str) else standards_raw
   183	        except json.JSONDecodeError:
   184	            standards = [standards_raw] if standards_raw else []
   185	        if isinstance(standards, str):
   186	            standards = [standards]
   187	
   188	        entries.append({
   189	            "id": doc_id,
   190	            "score": score,
   191	            "domain": meta.get("domain", ""),
   192	            "title": meta.get("title", ""),
   193	            "severity": meta.get("severity", "UNKNOWN"),
   194	            "description": info["document"],
   195	            "standards": standards,
   196	            "source": meta.get("source", ""),
   197	        })
   198	
   199	    return {
   200	        "query": query,
   201	        "domain": domain,
   202	        "totalResults": len(entries),
   203	        "results": entries,
   204	    }
   205	
   206	
   207	def main():
   208	    parser = argparse.ArgumentParser(description="Query Sentinel Knowledge Base")
   209	    parser.add_argument("--query", required=True, help="Search query")
   210	    parser.add_argument("--domain", default="all", help="Domain filter")
   211	    parser.add_argument("--limit", type=int, default=10, help="Max results")
   212	    args = parser.parse_args()
   213	
   214	    try:
   215	        result = query_kb(args.query, args.domain, args.limit)
   216	        print(json.dumps(result))
   217	    except Exception as e:
   218	        print(json.dumps({"error": str(e), "query": args.query, "domain": args.domain, "totalResults": 0, "results": []}))
   219	        sys.exit(1)
   220	
   221	
   222	if __name__ == "__main__":
   223	    main()
     1	"""
     2	Sentinel RAG Indexer — Indexes Knowledge Base rules into ChromaDB
     3	for semantic search capabilities.
     4	"""
     5	
     6	import json
     7	import glob
     8	import os
     9	import sys
    10	
    11	import chromadb
    12	from sentence_transformers import SentenceTransformer
    13	
    14	CONFIG_PATH = os.path.join(os.path.dirname(__file__), "config.json")
    15	KB_BASE = os.path.join(os.path.dirname(__file__), "..", "knowledge-base")
    16	
    17	
    18	def load_config():
    19	    """Load RAG configuration."""
    20	    with open(CONFIG_PATH) as f:
    21	        return json.load(f)
    22	
    23	
    24	def _extract_domain(filepath: str) -> str:
    25	    """Extract domain name from filepath (e.g. .../domains/web-app/... -> web-app)."""
    26	    parts = filepath.replace("\\", "/").split("/")
    27	    if "domains" in parts:
    28	        idx = parts.index("domains")
    29	        if idx + 1 < len(parts):
    30	            return parts[idx + 1]
    31	    return "general"
    32	
    33	
    34	def _build_text(rule: dict) -> str:
    35	    """Build searchable text from a rule or pattern entry."""
    36	    parts = [
    37	        rule.get("title", rule.get("name", "")),
    38	        rule.get("description", ""),
    39	    ]
    40	    # Rules have remediation as dict, patterns have it as string
    41	    rem = rule.get("remediation", "")
    42	    if isinstance(rem, dict):
    43	        parts.append(rem.get("description", ""))
    44	    elif isinstance(rem, str):
    45	        parts.append(rem)
    46	    # Include subcategory/type for better search
    47	    parts.append(rule.get("subcategory", ""))
    48	    parts.append(rule.get("type", ""))
    49	    # NVD fields
    50	    cwes = rule.get("cwes", [])
    51	    if cwes:
    52	        parts.append(" ".join(cwes) if isinstance(cwes, list) else str(cwes))
    53	    if rule.get("source"):
    54	        parts.append(rule["source"])
    55	    epss = rule.get("epss")
    56	    if isinstance(epss, dict) and epss.get("score") is not None:
    57	        parts.append(f"EPSS:{epss['score']}")
    58	    return " ".join(p for p in parts if p)
    59	
    60	
    61	def _flatten_nested(data, filepath: str) -> list[dict]:
    62	    """Flatten nested structures (NVD caches, standards) into indexable items."""
    63	    basename = os.path.basename(filepath)
    64	
    65	    # Skip non-indexable files
    66	    if basename == "sync-config.json":
    67	        return []
    68	
    69	    # Already a list — return as-is
    70	    if isinstance(data, list):
    71	        return data
    72	
    73	    if not isinstance(data, dict):
    74	        return []
    75	
    76	    items = []
    77	
    78	    # NVD/OSV cache: {"vulnerabilities": [...]}
    79	    if "vulnerabilities" in data:
    80	        for vuln in data["vulnerabilities"]:
    81	            if not isinstance(vuln, dict):
    82	                continue
    83	            item = dict(vuln)
    84	            # NVD uses "cve_id", OSV uses "id"
    85	            if "cve_id" in item and "id" not in item:
    86	                item["id"] = item.pop("cve_id")
    87	            if "id" not in item:
    88	                continue
    89	            item.setdefault("title", item.get("summary", item.get("description", ""))[:120])
    90	            items.append(item)
    91	        return items
    92	
    93	    # GitHub advisories: {"advisories": [...]}
    94	    if "advisories" in data:
    95	        for adv in data["advisories"]:
    96	            if isinstance(adv, dict):
    97	                item = dict(adv)
    98	                # Normalize ghsa_id → id for consistent indexing
    99	                if "ghsa_id" in item and "id" not in item:
   100	                    item["id"] = item.pop("ghsa_id")
   101	                if "id" not in item:
   102	                    continue
   103	                item.setdefault("title", item.get("summary", "")[:120])
   104	                item.setdefault("description", item.get("summary", ""))
   105	                items.append(item)
   106	        return items
   107	
   108	    # Standards files with nested lists (categories, tactics, techniques, etc.)
   109	    nested_keys = ("categories", "tactics", "techniques", "functions", "weaknesses")
   110	    for key in nested_keys:
   111	        if key in data and isinstance(data[key], list):
   112	            standard_name = data.get("standard", basename)
   113	            for entry in data[key]:
   114	                if isinstance(entry, dict) and "id" in entry:
   115	                    item = dict(entry)
   116	                    item.setdefault("title", item.get("name", ""))
   117	                    item.setdefault("description", item.get("description", ""))
   118	                    item["standard_source"] = standard_name
   119	                    items.append(item)
   120	
   121	    if items:
   122	        return items
   123	
   124	    # Single dict with id — wrap in list
   125	    if "id" in data:
   126	        return [data]
   127	
   128	    return []
   129	
   130	
   131	def collect_documents(config: dict) -> list[dict]:
   132	    """Collect all documents from KB sources for indexing."""
   133	    documents = []
   134	    seen_ids = set()
   135	    rag_dir = os.path.dirname(os.path.abspath(__file__))
   136	    for pattern in config["sources"]:
   137	        full_pattern = os.path.normpath(os.path.join(rag_dir, pattern))
   138	        for filepath in glob.glob(full_pattern, recursive=True):
   139	            try:
   140	                with open(filepath) as f:
   141	                    data = json.load(f)
   142	
   143	                rules = _flatten_nested(data, filepath)
   144	                domain = _extract_domain(filepath)
   145	                for rule in rules:
   146	                    if isinstance(rule, dict) and "id" in rule:
   147	                        if rule["id"] in seen_ids:
   148	                            continue
   149	                        seen_ids.add(rule["id"])
   150	                        # Sanitize metadata — ChromaDB requires str/int/float/bool
   151	                        severity = rule.get("severity", "UNKNOWN")
   152	                        category = rule.get("subcategory", rule.get("type", ""))
   153	                        title = rule.get("title", "")
   154	                        standards = rule.get("standards", rule.get("cwe", []))
   155	                        documents.append({
   156	                            "id": rule["id"],
   157	                            "text": _build_text(rule),
   158	                            "metadata": {
   159	                                "source": filepath,
   160	                                "domain": str(rule.get("category", domain) or domain),
   161	                                "severity": str(severity) if severity else "UNKNOWN",
   162	                                "category": str(category) if category else "",
   163	                                "title": str(title) if title else "",
   164	                                "standards": json.dumps(standards) if standards else "[]",
   165	                            },
   166	                        })
   167	            except (json.JSONDecodeError, KeyError) as e:
   168	                print(f"Warning: Could not parse {filepath}: {e}", file=sys.stderr)
   169	                continue
   170	
   171	    return documents
   172	
   173	
   174	def index_documents(documents: list[dict], config: dict):
   175	    """Index documents into ChromaDB with sentence-transformer embeddings."""
   176	    chromadb_path = os.path.join(os.path.dirname(__file__), config["chromadb_path"])
   177	    client = chromadb.PersistentClient(path=chromadb_path)
   178	
   179	    # Delete and recreate for clean index
   180	    try:
   181	        client.delete_collection(config["collection_name"])
   182	    except Exception:
   183	        pass
   184	
   185	    collection = client.create_collection(
   186	        name=config["collection_name"],
   187	        metadata={
   188	            "hnsw:space": "cosine",
   189	            "hnsw:construction_ef": 200,
   190	            "hnsw:M": 16,
   191	            "hnsw:search_ef": 100,
   192	        },
   193	    )
   194	
   195	    print(f"Loading embedding model: {config['embedding_model']}...")
   196	    model = SentenceTransformer(config["embedding_model"])
   197	
   198	    # Batch upsert (ChromaDB max batch ~5000)
   199	    batch_size = 500
   200	    for i in range(0, len(documents), batch_size):
   201	        batch = documents[i : i + batch_size]
   202	        ids = [doc["id"] for doc in batch]
   203	        texts = [doc["text"] for doc in batch]
   204	        metadatas = [doc["metadata"] for doc in batch]
   205	
   206	        # bge-base: no prefix for documents, normalize for cosine
   207	        embeddings = model.encode(texts, normalize_embeddings=True, show_progress_bar=False).tolist()
   208	
   209	        collection.add(
   210	            ids=ids,
   211	            documents=texts,
   212	            embeddings=embeddings,
   213	            metadatas=metadatas,
   214	        )
   215	        print(f"  Indexed batch {i // batch_size + 1}: {len(batch)} documents")
   216	
   217	    print(f"Total: {collection.count()} documents in collection '{config['collection_name']}'")
   218	
   219	
   220	def main():
   221	    """Main entry point for KB indexing."""
   222	    print("=== Sentinel RAG Indexer ===")
   223	
   224	    config = load_config()
   225	    print(f"Config loaded: {config['collection_name']}")
   226	
   227	    documents = collect_documents(config)
   228	    print(f"Collected {len(documents)} documents from KB")
   229	
   230	    if not documents:
   231	        print("No documents found. Check source patterns in config.json.")
   232	        sys.exit(1)
   233	
   234	    index_documents(documents, config)
   235	    print("Indexing complete.")
   236	
   237	
   238	if __name__ == "__main__":
   239	    main()
