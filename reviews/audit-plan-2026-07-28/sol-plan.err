   269	
   270	    # Aggregate feedback per rule
   271	    rule_stats = defaultdict(lambda: {"tp": 0, "fp": 0, "patterns": defaultdict(lambda: {"tp": 0, "fp": 0})})
   272	
   273	    for entry in feedback["entries"]:
   274	        rid = entry["rule_id"]
   275	        verdict = entry["verdict"]
   276	        pattern = entry.get("pattern", "")
   277	
   278	        if verdict == "tp":
   279	            rule_stats[rid]["tp"] += 1
   280	            if pattern:
   281	                rule_stats[rid]["patterns"][pattern]["tp"] += 1
   282	        elif verdict == "fp":
   283	            rule_stats[rid]["fp"] += 1
   284	            if pattern:
   285	                rule_stats[rid]["patterns"][pattern]["fp"] += 1
   286	
   287	    # Calculate new confidence scores
   288	    updates = []
   289	    for rid, stats in sorted(rule_stats.items()):
   290	        if rid not in rules:
   291	            continue
   292	
   293	        rule = rules[rid]
   294	        old_confidence = rule.get("confidence", 0.5)
   295	        old_status = rule.get("status", "unknown")
   296	        tp = stats["tp"]
   297	        fp = stats["fp"]
   298	        total = tp + fp
   299	
   300	        if total < MIN_FEEDBACK_FOR_UPDATE:
   301	            continue
   302	
   303	        # Bayesian confidence: Laplace-smoothed precision weighted by base confidence
   304	        # factor = (tp + 1) / (tp + fp + 2)  → converges to precision with more data
   305	        bayesian_factor = (tp + 1) / (tp + fp + 2)
   306	
   307	        # Blend: 30% base confidence + 70% empirical
   308	        new_confidence = round(0.3 * old_confidence + 0.7 * bayesian_factor, 3)
   309	
   310	        # Determine status change
   311	        new_status = old_status
   312	        if new_confidence < DEMOTE_THRESHOLD and old_status == "active":
   313	            new_status = "needs-review"
   314	        elif new_confidence >= PROMOTE_THRESHOLD and old_status in ("needs-review", "no-matches"):
   315	            new_status = "active"
   316	
   317	        # Identify worst patterns (FP-heavy)
   318	        worst_patterns = []
   319	        for pat, pat_stats in stats["patterns"].items():
   320	            if pat_stats["fp"] > 0:
   321	                pat_prec = pat_stats["tp"] / (pat_stats["tp"] + pat_stats["fp"])
   322	                if pat_prec < 0.5:
   323	                    worst_patterns.append({
   324	                        "pattern": pat[:60],
   325	                        "tp": pat_stats["tp"],
   326	                        "fp": pat_stats["fp"],
   327	                        "precision": round(pat_prec, 2),
   328	                    })
   329	
   330	        updates.append({
   331	            "rule_id": rid,
   332	            "domain": rule.get("_domain"),
   333	            "old_confidence": old_confidence,
   334	            "new_confidence": new_confidence,
   335	            "old_status": old_status,
   336	            "new_status": new_status,
   337	            "tp": tp,
   338	            "fp": fp,
   339	            "precision": round(tp / total, 3),
   340	            "worst_patterns": worst_patterns,
   341	            "source_path": rule["_source_path"],
   342	        })
   343	
   344	    # Print results
   345	    print(f"\n{'Rule ID':24s} {'Domain':14s} {'TP':>4s} {'FP':>4s} {'Prec':>6s} "
   346	          f"{'Old Conf':>8s} {'New Conf':>8s} {'Status Change':20s}")
   347	    print("-" * 100)
   348	
   349	    for u in updates:
   350	        status_change = ""
   351	        if u["old_status"] != u["new_status"]:
   352	            status_change = f"{u['old_status']} → {u['new_status']}"
   353	
   354	        print(f"{u['rule_id']:24s} {u['domain']:14s} {u['tp']:4d} {u['fp']:4d} "
   355	              f"{u['precision']:6.1%} {u['old_confidence']:8.3f} {u['new_confidence']:8.3f} "
   356	              f"{status_change:20s}")
   357	
   358	        if u["worst_patterns"]:
   359	            for wp in u["worst_patterns"]:
   360	                print(f"  {'':24s} FP-heavy: {wp['pattern']} "
   361	                      f"(tp={wp['tp']}, fp={wp['fp']}, prec={wp['precision']:.0%})")
   362	
   363	    # Apply
   364	    if args.dry_run:
   365	        print(f"\n--- DRY RUN: no changes applied ---")
   366	        return
   367	
   368	    files_to_update = defaultdict(list)
   369	    for u in updates:
   370	        files_to_update[u["source_path"]].append(u)
   371	
   372	    for path, path_updates in files_to_update.items():
   373	        with open(path) as f:
   374	            all_rules = json.load(f)
   375	
   376	        updates_by_id = {u["rule_id"]: u for u in path_updates}
   377	        for i, r in enumerate(all_rules):
   378	            if r["id"] in updates_by_id:
   379	                u = updates_by_id[r["id"]]
   380	                all_rules[i]["confidence"] = u["new_confidence"]
   381	                if u["old_status"] != u["new_status"]:
   382	                    all_rules[i]["status"] = u["new_status"]
   383	                all_rules[i]["feedback_tp"] = u["tp"]
   384	                all_rules[i]["feedback_fp"] = u["fp"]
   385	                all_rules[i]["feedback_precision"] = u["precision"]
   386	                all_rules[i]["confidence_updated_at"] = datetime.now(timezone.utc).isoformat()
   387	
   388	        with open(path, "w") as f:
   389	            json.dump(all_rules, f, indent=2)
   390	            f.write("\n")
   391	
   392	        domain = os.path.basename(os.path.dirname(path))
   393	        print(f"  Updated {domain}/cve-rules.json: {len(path_updates)} rules")
   394	
   395	    changed_status = sum(1 for u in updates if u["old_status"] != u["new_status"])
   396	    print(f"\nApplied: {len(updates)} confidence updates, {changed_status} status changes")
   397	
   398	
   399	# ===========================================================================
   400	# Subcommand: propagate
   401	# ===========================================================================
   402	
   403	def cmd_propagate(args):
   404	    """Find validated patterns and propagate across domains sharing the same CWE."""
   405	    cve_rules = load_all_cve_rules()
   406	    domain_rules = load_domain_rules()
   407	    all_rules = {**domain_rules, **cve_rules}
   408	
   409	    # Step 1: Collect active rules grouped by CWE
   410	    cwe_patterns = defaultdict(list)  # CWE -> list of (rule_id, domain, patterns, confidence)
   411	
   412	    for rid, rule in all_rules.items():
   413	        if rule.get("status") not in ("active", None):
   414	            # Domain rules (rules.json) don't have status; CVE rules need "active"
   415	            if "_source_path" in rule and "cve-rules" in rule["_source_path"]:
   416	                continue
   417	
   418	        confidence = rule.get("confidence", 0.7)
   419	        if confidence < PROPAGATE_MIN_CONFIDENCE:
   420	            continue
   421	
   422	        patterns = rule.get("detect", {}).get("patterns", [])
   423	        if not patterns:
   424	            continue
   425	
   426	        cwes = [s for s in rule.get("standards", []) if s.startswith("CWE-")]
   427	        domain = rule.get("_domain", "unknown")
   428	
   429	        for cwe in cwes:
   430	            cwe_patterns[cwe].append({
   431	                "rule_id": rid,
   432	                "domain": domain,
   433	                "patterns": patterns,
   434	                "negative_patterns": rule.get("detect", {}).get("negative_patterns", []),
   435	                "file_types": rule.get("detect", {}).get("file_types", []),
   436	                "confidence": confidence,
   437	            })
   438	
   439	    # Step 2: Find propagation opportunities
   440	    # A CWE with rules in multiple domains where some domains have more patterns
   441	    suggestions = []
   442	
   443	    for cwe, sources in sorted(cwe_patterns.items()):
   444	        if len(sources) < 2:
   445	            continue
   446	
   447	        # Group by domain
   448	        by_domain = defaultdict(list)
   449	        for s in sources:
   450	            by_domain[s["domain"]].append(s)
   451	
   452	        if len(by_domain) < 2:
   453	            continue
   454	
   455	        # Find the richest source (most patterns, highest confidence)
   456	        domain_scores = {}
   457	        for domain, domain_sources in by_domain.items():
   458	            total_patterns = sum(len(s["patterns"]) for s in domain_sources)
   459	            max_confidence = max(s["confidence"] for s in domain_sources)
   460	            domain_scores[domain] = (total_patterns, max_confidence)
   461	
   462	        best_domain = max(domain_scores, key=lambda d: domain_scores[d])
   463	        best_sources = by_domain[best_domain]
   464	
   465	        # Collect all unique patterns from the best domain
   466	        best_patterns = set()
   467	        for s in best_sources:
   468	            best_patterns.update(s["patterns"])
   469	
   470	        # Check other domains for missing patterns
   470	        # Check other domains for missing patterns
   471	        for target_domain, target_sources in by_domain.items():
   472	            if target_domain == best_domain:
   473	                continue
   474	
   475	            target_patterns = set()
   476	            for s in target_sources:
   477	                target_patterns.update(s["patterns"])
   478	
   479	            new_patterns = best_patterns - target_patterns
   480	            if new_patterns:
   481	                suggestions.append({
   482	                    "cwe": cwe,
   483	                    "source_domain": best_domain,
   484	                    "target_domain": target_domain,
   485	                    "target_rules": [s["rule_id"] for s in target_sources],
   486	                    "new_patterns": sorted(new_patterns),
   487	                    "source_confidence": domain_scores[best_domain][1],
   488	                })
   489	
   490	    # Print suggestions
   491	    if not suggestions:
   492	        print("No cross-domain propagation opportunities found.")
   493	        return
   494	
   495	    print(f"\n{'CWE':12s} {'From':14s} {'To':14s} {'New Patterns':>12s} {'Conf':>6s}")
   496	    print("-" * 64)
   497	
   498	    for s in suggestions:
   499	        print(f"{s['cwe']:12s} {s['source_domain']:14s} {s['target_domain']:14s} "
   500	              f"{len(s['new_patterns']):12d} {s['source_confidence']:6.2f}")
   501	        for p in s["new_patterns"][:5]:
   502	            print(f"  {'':12s} + {p[:70]}")
   503	        if len(s["new_patterns"]) > 5:
   504	            print(f"  {'':12s} ... and {len(s['new_patterns']) - 5} more")
   505	        print(f"  {'':12s} Target rules: {', '.join(s['target_rules'][:3])}")
   506	
   507	    print(f"\nTotal: {len(suggestions)} propagation opportunities, "
   508	          f"{sum(len(s['new_patterns']) for s in suggestions)} new patterns")
   509	
   510	    if not args.apply:
   511	        print("\n--- Preview only. Use --apply to propagate patterns ---")
   512	        return
   513	
   514	    # Apply propagation
   515	    applied = 0
   516	    files_modified = set()
   517	
   518	    for s in suggestions:
   519	        for target_rid in s["target_rules"]:
   520	            if target_rid not in all_rules:
   521	                continue
   522	            rule = all_rules[target_rid]
   523	            current_patterns = rule.get("detect", {}).get("patterns", [])
   524	            added = [p for p in s["new_patterns"] if p not in current_patterns]
   525	            if not added:
   526	                continue
   527	
   528	            rule["detect"]["patterns"].extend(added)
   529	            rule["propagated_from"] = s["source_domain"]
   530	            rule["propagated_at"] = datetime.now(timezone.utc).isoformat()
   531	            rule["propagated_patterns"] = added
   532	            files_modified.add(rule["_source_path"])
   533	            applied += len(added)
   534	
   535	    # Save modified files
   536	    for path in files_modified:
   537	        with open(path) as f:
   538	            all_file_rules = json.load(f)
   539	
   540	        for i, r in enumerate(all_file_rules):
   541	            if r["id"] in all_rules:
   542	                updated = all_rules[r["id"]]
   543	                if "propagated_from" in updated:
   544	                    all_file_rules[i]["detect"] = {k: v for k, v in updated["detect"].items()
   545	                                                    if not k.startswith("_")}
   546	                    all_file_rules[i]["propagated_from"] = updated["propagated_from"]
   547	                    all_file_rules[i]["propagated_at"] = updated["propagated_at"]
   548	                    all_file_rules[i]["propagated_patterns"] = updated["propagated_patterns"]
   549	
   550	        with open(path, "w") as f:
   551	            json.dump(all_file_rules, f, indent=2)
   552	            f.write("\n")
   553	
   554	        domain = os.path.basename(os.path.dirname(path))
   555	        print(f"  Updated {domain}/cve-rules.json")
   556	
   557	    print(f"\nApplied {applied} propagated patterns across {len(files_modified)} files")
