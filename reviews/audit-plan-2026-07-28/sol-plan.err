   589	
   590	    repos = source.get("repos", {})
   591	    if not repos:
   592	        print("  OWASP: no repos configured")
   593	        return 0
   594	
   595	    # GitHub token for higher rate limits (optional)
   596	    headers = {"Accept": "application/vnd.github+json"}
   597	    gh_token = os.environ.get("GITHUB_TOKEN")
   598	    if gh_token:
   599	        headers["Authorization"] = f"Bearer {gh_token}"
   600	        print("  OWASP: using GITHUB_TOKEN")
   601	
   602	    updates_found = []
   603	    checked = 0
   604	
   605	    for repo_key, repo_config in repos.items():
   606	        repo = repo_config.get("repo", "")
   607	        current_version = repo_config.get("current_version", "")
   608	        standards_file = repo_config.get("standards_file", "")
   609	
   610	        if not repo or not current_version or not standards_file:
   611	            print(f"  OWASP: {repo_key} missing required fields, skipping")
   612	            continue
   613	
   614	        print(f"  OWASP: checking {repo}...")
   615	        checked += 1
   616	
   617	        if dry_run:
   618	            print(f"  OWASP: [dry-run] would check {repo} releases")
   619	            continue
   620	
   621	        # Try to fetch latest release first
   622	        release_url = f"https://api.github.com/repos/{repo}/releases/latest"
   623	        resp = api_request(release_url, headers=headers)
   624	
   625	        latest_version = None
   626	        if resp is not None and "tag_name" in resp:
   627	            # Extract version from tag (e.g., "v2025" -> "2025", "2025" -> "2025")
   628	            tag = resp.get("tag_name", "")
   629	            latest_version = tag.lstrip("v")
   630	        else:
   631	            # Fallback: fetch latest tag
   632	            tags_url = f"https://api.github.com/repos/{repo}/tags?per_page=1"
   633	            resp = api_request(tags_url, headers=headers)
   634	            if resp is not None and isinstance(resp, list) and len(resp) > 0:
   635	                tag = resp[0].get("name", "")
   636	                latest_version = tag.lstrip("v")
   637	
   638	        if latest_version and latest_version != current_version:
   639	            updates_found.append({
   640	                "repo": repo,
   641	                "repo_key": repo_key,
   642	                "standards_file": standards_file,
   643	                "current_version": current_version,
   644	                "latest_version": latest_version,
   645	                "checked_at": datetime.now(timezone.utc).isoformat(),
   646	            })
   647	            print(f"  OWASP: {repo_key}: update available {current_version} → {latest_version}")
   648	        else:
   649	            print(f"  OWASP: {repo_key}: up-to-date ({current_version})")
   650	
   651	        time.sleep(1)
   652	
   653	    # Write pending updates to standards directory
   654	    if updates_found:
   655	        pending_path = os.path.join(STANDARDS_DIR, "pending-updates.json")
   656	        pending_data = {
   657	            "timestamp": datetime.now(timezone.utc).isoformat(),
   658	            "updates": updates_found,
   659	        }
   660	        if not dry_run:
   661	            with open(pending_path, "w") as f:
   662	                json.dump(pending_data, f, indent=2)
   663	                f.write("\n")
   664	            print(f"  OWASP: wrote {len(updates_found)} updates to pending-updates.json")
   665	
   666	    print(f"  OWASP: checked {checked} repos, {len(updates_found)} updates available")
   667	    return checked
