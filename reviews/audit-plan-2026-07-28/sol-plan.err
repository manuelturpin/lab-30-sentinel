     1	/**
     2	 * scan-headers tool — Security headers verification
     3	 *
     4	 * Fetches a URL and analyzes HTTP security headers
     5	 * (CSP, HSTS, X-Frame-Options, etc.).
     6	 */
     7	
     8	import * as http from "http";
     9	import * as https from "https";
    10	import { URL } from "url";
    11	import { isPublicUrl } from "../utils/url-validator.js";
    12	
    13	export interface HeaderScanResult {
    14	  url: string;
    15	  score: number; // 0-100
    16	  grade: "A+" | "A" | "B" | "C" | "D" | "F";
    17	  headers: HeaderCheck[];
    18	  missingHeaders: string[];
    19	}
    20	
    21	export interface HeaderCheck {
    22	  name: string;
    23	  value: string | null;
    24	  status: "present" | "missing" | "misconfigured";
    25	  severity: "HIGH" | "MEDIUM" | "LOW" | "INFO";
    26	  recommendation?: string;
    27	}
    28	
    29	export const SECURITY_HEADERS = [
    30	  {
    31	    name: "Content-Security-Policy",
    32	    required: true,
    33	    severity: "HIGH" as const,
    34	  },
    35	  {
    36	    name: "Strict-Transport-Security",
    37	    required: true,
    38	    severity: "HIGH" as const,
    39	  },
    40	  {
    41	    name: "X-Content-Type-Options",
    42	    required: true,
    43	    severity: "MEDIUM" as const,
    44	  },
    45	  {
    46	    name: "X-Frame-Options",
    47	    required: true,
    48	    severity: "MEDIUM" as const,
    49	  },
    50	  {
    51	    name: "Referrer-Policy",
    52	    required: true,
    53	    severity: "MEDIUM" as const,
    54	  },
    55	  {
    56	    name: "Permissions-Policy",
    57	    required: false,
    58	    severity: "LOW" as const,
    59	  },
    60	  {
    61	    name: "Cross-Origin-Opener-Policy",
    62	    required: false,
    63	    severity: "LOW" as const,
    64	  },
    65	  {
    66	    name: "Cross-Origin-Resource-Policy",
    67	    required: false,
    68	    severity: "LOW" as const,
    69	  },
    70	  {
    71	    name: "Cross-Origin-Embedder-Policy",
    72	    required: false,
    73	    severity: "INFO" as const,
    74	  },
    75	];
    76	
    77	const SEVERITY_DEDUCTIONS: Record<string, number> = {
    78	  HIGH: 20,
    79	  MEDIUM: 10,
    80	  LOW: 5,
    81	  INFO: 2,
    82	};
    83	
    84	function fetchHeaders(
    85	  targetUrl: string,
    86	  maxRedirects: number = 3
    87	): Promise<Record<string, string | string[]>> {
    88	  return new Promise((resolve, reject) => {
    89	    const parsed = new URL(targetUrl);
    90	    const client = parsed.protocol === "https:" ? https : http;
    91	
    92	    const req = client.get(targetUrl, (res) => {
    93	      // Follow redirects
    94	      if (
    95	        res.statusCode &&
    96	        res.statusCode >= 300 &&
    97	        res.statusCode < 400 &&
    98	        res.headers.location &&
    99	        maxRedirects > 0
   100	      ) {
   101	        let redirectUrl = res.headers.location;
   102	        // Handle relative redirects
   103	        if (redirectUrl.startsWith("/")) {
   104	          redirectUrl = `${parsed.protocol}//${parsed.host}${redirectUrl}`;
   105	        }
   106	        res.resume(); // Consume response data
   107	        fetchHeaders(redirectUrl, maxRedirects - 1).then(resolve).catch(reject);
   108	        return;
   109	      }
   110	
   111	      // Drain the response body
   112	      res.resume();
   113	      res.on("end", () => {
   114	        resolve(res.headers as Record<string, string | string[]>);
   115	      });
   116	    });
   117	
   118	    req.on("error", reject);
   119	    req.setTimeout(10000, () => {
   120	      req.destroy();
   121	      reject(new Error("Request timed out"));
   122	    });
   123	  });
   124	}
   125	
   126	function evaluateCSP(value: string): string[] {
   127	  const issues: string[] = [];
   128	
   129	  if (value.includes("'unsafe-inline'")) {
   130	    issues.push("CSP contains 'unsafe-inline' which weakens XSS protection");
   131	  }
   132	  if (value.includes("'unsafe-eval'")) {
   133	    issues.push("CSP contains 'unsafe-eval' which allows code execution from strings");
   134	  }
   135	  if (!value.includes("default-src")) {
   136	    issues.push("CSP is missing 'default-src' directive — no fallback policy");
   137	  }
   138	  if (/(?:default-src|script-src)\s+[^;]*\*/.test(value)) {
   139	    issues.push("CSP uses wildcard '*' which allows loading resources from any origin");
   140	  }
   141	
   142	  return issues;
   143	}
   144	
   145	function evaluateHSTS(value: string): string[] {
   146	  const issues: string[] = [];
   147	
   148	  const maxAgeMatch = value.match(/max-age=(\d+)/);
   149	  if (!maxAgeMatch) {
   150	    issues.push("HSTS missing max-age directive");
   151	  } else {
   152	    const maxAge = parseInt(maxAgeMatch[1], 10);
   153	    if (maxAge < 31536000) {
   154	      issues.push(`HSTS max-age is ${maxAge}s — should be at least 31536000 (1 year)`);
   155	    }
   156	  }
   157	
   158	  if (!value.includes("includeSubDomains")) {
   159	    issues.push("HSTS missing includeSubDomains — subdomains are not protected");
   160	  }
   161	
   162	  return issues;
   163	}
   164	
   165	function scoreToGrade(score: number): "A+" | "A" | "B" | "C" | "D" | "F" {
   166	  if (score >= 90) return "A+";
   167	  if (score >= 80) return "A";
   168	  if (score >= 70) return "B";
   169	  if (score >= 60) return "C";
   170	  if (score >= 50) return "D";
   171	  return "F";
   172	}
   173	
   174	export async function scanHeaders(url: string): Promise<HeaderScanResult> {
   175	  if (!isPublicUrl(url)) {
   176	    throw new Error(`Refusing to scan private/local URL: ${url}`);
   177	  }
   178	
   179	  let responseHeaders: Record<string, string | string[]>;
   180	
   181	  try {
   182	    responseHeaders = await fetchHeaders(url);
   183	  } catch (error) {
   184	    return {
   185	      url,
   186	      score: 0,
   187	      grade: "F",
   188	      headers: [],
   189	      missingHeaders: SECURITY_HEADERS.filter(h => h.required).map(h => h.name),
   190	    };
   191	  }
   192	
   193	  const headerChecks: HeaderCheck[] = [];
   194	  const missingHeaders: string[] = [];
   195	  let score = 100;
   196	
   197	  // Normalize header keys to lowercase for lookup
   198	  const normalizedHeaders: Record<string, string> = {};
   199	  for (const [key, val] of Object.entries(responseHeaders)) {
   200	    normalizedHeaders[key.toLowerCase()] = Array.isArray(val) ? val.join(", ") : val;
   201	  }
   202	
   203	  for (const headerDef of SECURITY_HEADERS) {
   204	    const headerKey = headerDef.name.toLowerCase();
   205	    const value = normalizedHeaders[headerKey] || null;
   206	
   207	    if (!value) {
   208	      // Header is missing
   209	      headerChecks.push({
   210	        name: headerDef.name,
   211	        value: null,
   212	        status: "missing",
   213	        severity: headerDef.severity,
   214	        recommendation: `Add the ${headerDef.name} header to improve security.`,
   215	      });
   216	      missingHeaders.push(headerDef.name);
   217	      score -= SEVERITY_DEDUCTIONS[headerDef.severity];
   218	      continue;
   219	    }
   220	
   221	    // Header is present — check for misconfigurations
   222	    let misconfigured = false;
   223	    let recommendation: string | undefined;
   224	
   225	    if (headerDef.name === "Content-Security-Policy") {
   226	      const cspIssues = evaluateCSP(value);
   227	      if (cspIssues.length > 0) {
   228	        misconfigured = true;
   229	        recommendation = cspIssues.join(". ");
   230	        score -= Math.floor(SEVERITY_DEDUCTIONS[headerDef.severity] / 2);
   231	      }
   232	    }
   233	
   234	    if (headerDef.name === "Strict-Transport-Security") {
   235	      const hstsIssues = evaluateHSTS(value);
   236	      if (hstsIssues.length > 0) {
   237	        misconfigured = true;
   238	        recommendation = hstsIssues.join(". ");
   239	        score -= Math.floor(SEVERITY_DEDUCTIONS[headerDef.severity] / 2);
   240	      }
   241	    }
   242	
   243	    if (headerDef.name === "X-Content-Type-Options" && value !== "nosniff") {
   244	      misconfigured = true;
   245	      recommendation = "X-Content-Type-Options should be set to 'nosniff'.";
   246	      score -= Math.floor(SEVERITY_DEDUCTIONS[headerDef.severity] / 2);
   247	    }
   248	
   249	    if (headerDef.name === "X-Frame-Options") {
   250	      const upper = value.toUpperCase();
   251	      if (upper !== "DENY" && upper !== "SAMEORIGIN") {
   252	        misconfigured = true;
   253	        recommendation = "X-Frame-Options should be 'DENY' or 'SAMEORIGIN'.";
   254	        score -= Math.floor(SEVERITY_DEDUCTIONS[headerDef.severity] / 2);
   255	      }
   256	    }
   257	
   258	    headerChecks.push({
   259	      name: headerDef.name,
   260	      value,
   261	      status: misconfigured ? "misconfigured" : "present",
   262	      severity: headerDef.severity,
   263	      recommendation,
   264	    });
   265	  }
   266	
   267	  // Check for dangerous headers that should NOT be present
   268	  if (normalizedHeaders["server"]) {
   269	    headerChecks.push({
   270	      name: "Server",
   271	      value: normalizedHeaders["server"],
   272	      status: "misconfigured",
   273	      severity: "LOW",
   274	      recommendation: "Remove or obfuscate the Server header to prevent information disclosure.",
   275	    });
   276	    score -= 3;
   277	  }
   278	
   279	  if (normalizedHeaders["x-powered-by"]) {
   280	    headerChecks.push({
     1	/**
     2	 * Sentinel Scanner — MCP Server
     3	 *
     4	 * Exposes security scanning tools to Claude Code via the
     5	 * Model Context Protocol. This is the main entry point.
     6	 *
     7	 * Session 12 (2026-03-15) / T2 (2026-04-21): 4 local scanning tools
     8	 * (scan-project, scan-secrets, query-cve, query-kb) were removed in
     9	 * favor of native Read/Grep/Bash — see docs/adr/2026-04-21-mcp-tools-removal.md.
    10	 */
    11	
    12	import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
    13	import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
    14	import { z } from "zod";
    15	import { scanDependencies } from "./tools/scan-dependencies.js";
    16	import { scanHeaders } from "./tools/scan-headers.js";
    17	import { generateSBOM } from "./utils/sbom-generator.js";
    18	
    19	const server = new McpServer({
    20	  name: "sentinel-scanner",
    21	  version: "0.1.0",
    22	});
    23	
    24	// --- Tool: scan-dependencies ---
    25	server.tool(
    26	  "scan-dependencies",
    27	  "Analyze project dependencies for known vulnerabilities using OSV and NVD databases.",
    28	  {
    29	    projectPath: z.string().describe("Absolute path to the project"),
    30	    ecosystem: z
    31	      .enum(["npm", "pypi", "gem", "go", "cargo", "maven", "auto"])
    32	      .default("auto")
    33	      .describe("Package ecosystem to scan"),
    34	  },
    35	  async ({ projectPath, ecosystem }) => {
    36	    const result = await scanDependencies(projectPath, ecosystem);
    37	    return {
    38	      content: [
    39	        {
    40	          type: "text" as const,
    41	          text: JSON.stringify(result, null, 2),
    42	        },
    43	      ],
    44	      _meta: {
    45	        "anthropic/maxResultSizeChars": 500000,
    46	      },
    47	    };
    48	  }
    49	);
    50	
    51	// --- Tool: scan-headers ---
    52	server.tool(
    53	  "scan-headers",
    54	  "Check security headers (CSP, HSTS, X-Frame-Options, etc.) for a web application.",
    55	  {
    56	    url: z.string().describe("URL to check headers for"),
    57	  },
    58	  async ({ url }) => {
    59	    const result = await scanHeaders(url);
    60	    return {
    61	      content: [
    62	        {
    63	          type: "text" as const,
    64	          text: JSON.stringify(result, null, 2),
    65	        },
    66	      ],
    67	      _meta: {
    68	        "anthropic/maxResultSizeChars": 500000,
    69	      },
    70	    };
    71	  }
    72	);
    73	
    74	// --- Tool: generate-sbom ---
    75	server.tool(
    76	  "generate-sbom",
    77	  "Generate a CycloneDX Software Bill of Materials (SBOM) for a project.",
    78	  {
    79	    projectPath: z.string().describe("Absolute path to the project"),
    80	    projectName: z.string().optional().describe("Project name (auto-detected from package.json if omitted)"),
    81	    projectVersion: z.string().optional().describe("Project version (auto-detected if omitted)"),
    82	  },
    83	  async ({ projectPath, projectName, projectVersion }) => {
    84	    const sbom = generateSBOM(projectPath, projectName, projectVersion);
    85	    return {
    86	      content: [
    87	        {
    88	          type: "text" as const,
    89	          text: JSON.stringify(sbom, null, 2),
    90	        },
    91	      ],
    92	    };
    93	  }
    94	);
    95	
    96	// --- Start server ---
    97	async function main() {
    98	  // Session correlation context. Claude Code injects these into stdio MCP
    99	  // subprocess environments: CLAUDE_CODE_SESSION_ID + CLAUDECODE=1 (v2.1.154),
   100	  // CLAUDE_PROJECT_DIR (v2.1.139). Logged to stderr so MCP scans can be
   101	  // correlated with the dispatching Claude Code session in the audit trail.
   102	  const sessionId = process.env.CLAUDE_CODE_SESSION_ID ?? "unknown";
   103	  const projectDir = process.env.CLAUDE_PROJECT_DIR ?? process.cwd();
   104	  const transport = new StdioServerTransport();
   105	  await server.connect(transport);
   106	  console.error(
   107	    `Sentinel Scanner MCP Server running on stdio ` +
   108	      `(session=${sessionId}, project=${projectDir})`
   109	  );
   110	}
   111	
   112	main().catch(console.error);

