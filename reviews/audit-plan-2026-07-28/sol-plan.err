     1	/**
     2	 * SARIF Generator — Converts scan findings to SARIF 2.1.0 format
     3	 *
     4	 * Skeleton for Session 8 implementation.
     5	 * SARIF spec: https://docs.oasis-open.org/sarif/sarif/v2.1.0/sarif-v2.1.0.html
     6	 */
     7	
     8	import type { Finding } from "./types.js";
     9	
    10	export interface SARIFReport {
    11	  $schema: string;
    12	  version: string;
    13	  runs: SARIFRun[];
    14	}
    15	
    16	export interface SARIFRun {
    17	  tool: {
    18	    driver: {
    19	      name: string;
    20	      version: string;
    21	      informationUri: string;
    22	      rules: SARIFRule[];
    23	    };
    24	  };
    25	  invocations?: SARIFInvocation[];
    26	  artifacts?: SARIFArtifact[];
    27	  results: SARIFResult[];
    28	}
    29	
    30	export interface SARIFInvocation {
    31	  executionSuccessful: boolean;
    32	  commandLine?: string;
    33	  arguments?: string[];
    34	  startTimeUtc?: string;
    35	  endTimeUtc?: string;
    36	  exitCode?: number;
    37	}
    38	
    39	export interface SARIFArtifact {
    40	  location: { uri: string };
    41	  roles?: string[];
    42	  length?: number;
    43	}
    44	
    45	export interface SARIFGeneratorOptions {
    46	  startTime?: string;
    47	  endTime?: string;
    48	  args?: string[];
    49	  scannedFiles?: string[];
    50	}
    51	
    52	export interface SARIFRule {
    53	  id: string;
    54	  name: string;
    55	  shortDescription: { text: string };
    56	  fullDescription?: { text: string };
    57	  defaultConfiguration: {
    58	    level: "error" | "warning" | "note" | "none";
    59	  };
    60	  properties?: Record<string, unknown>;
    61	}
    62	
    63	export interface SARIFResult {
    64	  ruleId: string;
    65	  level: "error" | "warning" | "note" | "none";
    66	  message: { text: string };
    67	  locations: Array<{
    68	    physicalLocation: {
    69	      artifactLocation: { uri: string };
    70	      region?: {
    71	        startLine: number;
    72	        startColumn?: number;
    73	      };
    74	    };
    75	  }>;
    76	  properties?: Record<string, unknown>;
    77	}
    78	
    79	/**
    80	 * Convert Sentinel findings to SARIF 2.1.0 format.
    81	 */
    82	export function generateSARIF(findings: Finding[], options: SARIFGeneratorOptions = {}): SARIFReport {
    83	  const rules: SARIFRule[] = [];
    84	  const results: SARIFResult[] = [];
    85	  const seenRules = new Set<string>();
    86	
    87	  for (const finding of findings) {
    88	    // Add rule if not seen
    89	    if (!seenRules.has(finding.id)) {
    90	      seenRules.add(finding.id);
    91	      rules.push({
    92	        id: finding.id,
    93	        name: finding.title,
    94	        shortDescription: { text: finding.title },
    95	        fullDescription: { text: finding.description },
    96	        defaultConfiguration: {
    97	          level: severityToLevel(finding.severity),
    98	        },
    99	        properties: {
   100	          cvss_v4: finding.cvss_v4,
   101	          standard: finding.standard,
   102	          owasp: finding.owasp,
   103	          cwe: finding.cwe,
   104	        },
   105	      });
   106	    }
   107	
   108	    // Add result
   109	    results.push({
   110	      ruleId: finding.id,
   111	      level: severityToLevel(finding.severity),
   112	      message: { text: `${finding.description}\n\nRemediation: ${finding.remediation}` },
   113	      locations: [
   114	        {
   115	          physicalLocation: {
   116	            artifactLocation: { uri: finding.location.file },
   117	            region: finding.location.line
   118	              ? {
   119	                  startLine: finding.location.line,
   120	                  startColumn: finding.location.column,
   121	                }
   122	              : undefined,
   123	          },
   124	        },
   125	      ],
   126	      properties: {
   127	        severity: finding.severity,
   128	        cvss_v4: finding.cvss_v4,
   129	        epss: finding.epss,
   130	      },
   131	    });
   132	  }
   133	
   134	  // Build invocations
   135	  const invocations: SARIFInvocation[] = [{
   136	    executionSuccessful: true,
   137	    commandLine: "sentinel-scanner",
   138	    arguments: options.args,
   139	    startTimeUtc: options.startTime,
   140	    endTimeUtc: options.endTime,
   141	    exitCode: 0,
   142	  }];
   143	
   144	  // Build artifacts from scanned files
   145	  const artifacts: SARIFArtifact[] = (options.scannedFiles || []).map(f => ({
   146	    location: { uri: f },
   147	    roles: ["analysisTarget"],
   148	  }));
   149	
   150	  return {
   151	    $schema:
   152	      "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
   153	    version: "2.1.0",
   154	    runs: [
   155	      {
   156	        tool: {
   157	          driver: {
   158	            name: "Sentinel",
   159	            version: "0.1.0",
   160	            informationUri: "https://github.com/bonsai974/sentinel",
   161	            rules,
   162	          },
   163	        },
   164	        invocations,
   165	        artifacts: artifacts.length > 0 ? artifacts : undefined,
   166	        results,
   167	      },
   168	    ],
   169	  };
   170	}
   171	
   172	function severityToLevel(
   173	  severity: string
   174	): "error" | "warning" | "note" | "none" {
   175	  switch (severity) {
   176	    case "CRITICAL":
   177	    case "HIGH":
   178	      return "error";
   179	    case "MEDIUM":
   180	      return "warning";
   181	    case "LOW":
   182	      return "note";
   183	    default:
   184	      return "none";
   185	  }
   186	}
     1	/**
     2	 * Risk Scorer — CVSS v4 + EPSS composite risk calculation
     3	 *
     4	 * Skeleton for Session 8 implementation.
     5	 * CVSS v4: https://www.first.org/cvss/v4-0/
     6	 * EPSS: https://www.first.org/epss/
     7	 */
     8	
     9	export interface RiskScore {
    10	  cvss_v4: number;
    11	  epss: number;
    12	  composite: number;
    13	  severity: "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "INFO";
    14	  exploitability?: ExploitabilityFactors;
    15	}
    16	
    17	export interface ExploitabilityFactors {
    18	  attackVector: "NETWORK" | "ADJACENT" | "LOCAL" | "PHYSICAL";
    19	  attackComplexity: "LOW" | "HIGH";
    20	  privilegesRequired: "NONE" | "LOW" | "HIGH";
    21	  userInteraction: "NONE" | "PASSIVE" | "ACTIVE";
    22	}
    23	
    24	/**
    25	 * Calculate composite risk score from CVSS v4 base score and EPSS probability.
    26	 *
    27	 * Formula: composite = cvss_v4 * (0.6 + 0.4 * epss)
    28	 * - EPSS boosts the score when exploitation is likely
    29	 * - Minimum composite is 60% of CVSS (even with 0 EPSS)
    30	 */
    31	export function calculateCompositeRisk(
    32	  cvss_v4: number,
    33	  epss: number = 0
    34	): RiskScore {
    35	  const clampedCVSS = Math.max(0, Math.min(10, cvss_v4));
    36	  const clampedEPSS = Math.max(0, Math.min(1, epss));
    37	
    38	  const composite = clampedCVSS * (0.6 + 0.4 * clampedEPSS);
    39	
    40	  return {
    41	    cvss_v4: clampedCVSS,
    42	    epss: clampedEPSS,
    43	    composite: Math.round(composite * 100) / 100,
    44	    severity: scoreToSeverity(composite),
    45	    exploitability: undefined, // Not computed from base score alone — requires full CVSS v4 vector
    46	  };
    47	}
    48	
    49	function scoreToSeverity(
    50	  score: number
    51	): "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "INFO" {
    52	  if (score >= 9.0) return "CRITICAL";
    53	  if (score >= 7.0) return "HIGH";
    54	  if (score >= 4.0) return "MEDIUM";
    55	  if (score >= 0.1) return "LOW";
    56	  return "INFO";
    57	}
    58	
    59	/**
    60	 * Sort findings by composite risk score (highest first).
    61	 */
    62	export function sortByRisk<T extends { cvss_v4?: number; epss?: number }>(
    63	  findings: T[]
    64	): T[] {
    65	  return [...findings].sort((a, b) => {
    66	    const riskA = calculateCompositeRisk(a.cvss_v4 || 0, a.epss || 0);
    67	    const riskB = calculateCompositeRisk(b.cvss_v4 || 0, b.epss || 0);
    68	    return riskB.composite - riskA.composite;
    69	  });
    70	}
     1	/**
     2	 * Report Renderer — Renders Markdown reports from findings using the Handlebars-like template.
     3	 *
     4	 * Simple string replacement engine: {{variables}}, {{#each}} loops, {{#if}} conditionals.
     5	 * No external dependencies required.
     6	 */
     7	
     8	import * as fs from "fs";
     9	import * as path from "path";
    10	import type { Finding } from "./types.js";
    11	import { calculateCompositeRisk } from "./risk-scorer.js";
    12	
    13	export interface ReportData {
    14	  project_name: string;
    15	  date: string;
    16	  stacks: string;
    17	  agent_count: number;
    18	  agent_names: string;
    19	  depth: string;
    20	  duration: string;
    21	  executive_summary: string;
    22	  findings: Finding[];
    23	  total_deps: number;
    24	  vuln_deps: number;
    25	  sarif_path: string;
    26	  sbom_path: string;
    27	  report_path: string;
    28	}
    29	
    30	interface TemplateContext {
    31	  [key: string]: string | number | boolean | TemplateContext[] | undefined;
    32	}
    33	
    34	/**
    35	 * Render a Markdown report from findings using the template.
    36	 */
    37	export function renderReport(data: ReportData): string {
    38	  const templatePath = path.resolve(
    39	    __dirname,
    40	    "../../../../reports/templates/full-report.md"
    41	  );
    42	
    43	  let template: string;
    44	  try {
    45	    template = fs.readFileSync(templatePath, "utf-8");
    46	  } catch {
    47	    // Fallback: generate report without template
    48	    return renderFallback(data);
    49	  }
    50	
    51	  // Build template context
    52	  const severityCounts = countSeverities(data.findings);
    53	  const total = data.findings.length;
    54	  const compositeScores = data.findings.map(
    55	    (f) => calculateCompositeRisk(f.cvss_v4 || 0, f.epss || 0).composite
    56	  );
    57	  const avgComposite =
    58	    compositeScores.length > 0
    59	      ? (
    60	          compositeScores.reduce((a, b) => a + b, 0) / compositeScores.length
    61	        ).toFixed(2)
    62	      : "0.00";
    63	  const avgEpss =
    64	    data.findings.length > 0
    65	      ? (
    66	          data.findings.reduce((a, f) => a + (f.epss || 0), 0) /
    67	          data.findings.length
    68	        ).toFixed(4)
    69	      : "0.0000";
    70	
    71	  const criticalHigh = data.findings.filter(
    72	    (f) => f.severity === "CRITICAL" || f.severity === "HIGH"
    73	  );
    74	  const medium = data.findings.filter((f) => f.severity === "MEDIUM");
    75	  const lowInfo = data.findings.filter(
    76	    (f) => f.severity === "LOW" || f.severity === "INFO"
    77	  );
    78	
    79	  const pct = (n: number) =>
    80	    total > 0 ? `${Math.round((n / total) * 100)}%` : "0%";
    81	
    82	  // Build recommendations from critical/high findings
    83	  const recommendations = criticalHigh.map((f, i) => ({
    84	    priority: f.severity === "CRITICAL" ? "Immediate" : "High",
    85	    description: `${f.title} — ${f.remediation}`,
    86	    "@index": i + 1,
    87	  }));
    88	
    89	  const context: TemplateContext = {
    90	    project_name: data.project_name,
    91	    date: data.date,
    92	    stacks: data.stacks,
    93	    agent_count: data.agent_count,
    94	    agent_names: data.agent_names,
    95	    depth: data.depth,
    96	    duration: data.duration,
    97	    executive_summary: data.executive_summary,
    98	    critical: severityCounts.CRITICAL,
    99	    high: severityCounts.HIGH,
   100	    medium: severityCounts.MEDIUM,
   101	    low: severityCounts.LOW,
   102	    info: severityCounts.INFO,
   103	    total,
   104	    critical_pct: pct(severityCounts.CRITICAL),
   105	    high_pct: pct(severityCounts.HIGH),
   106	    medium_pct: pct(severityCounts.MEDIUM),
   107	    low_pct: pct(severityCounts.LOW),
   108	    info_pct: pct(severityCounts.INFO),
   109	    composite_score: avgComposite,
   110	    epss_avg: avgEpss,
   111	    total_deps: data.total_deps,
   112	    vuln_deps: data.vuln_deps,
   113	    sarif_path: data.sarif_path,
   114	    sbom_path: data.sbom_path,
   115	    report_path: data.report_path,
   116	  };
   117	
   118	  let result = template;
   119	
   120	  // Process {{#each}} blocks
   121	  result = processEachBlocks(result, {
   122	    critical_high_findings: criticalHigh.map((f) => ({
   123	      id: f.id,
   124	      title: f.title,
   125	      severity: f.severity,
   126	      cvss_v4: f.cvss_v4 || 0,
   127	      epss: f.epss || 0,
   128	      epss_percentile: f.epss ? `${Math.round(f.epss * 100)}th` : "N/A",
   129	      file: f.location.file,
   130	      line: f.location.line || 0,
   131	      standard: f.standard || "N/A",
   132	      owasp: f.owasp || "N/A",
   133	      agent: (f as Finding & { agent?: string }).agent || "unknown",
   134	      description: f.description,
   135	      remediation: f.remediation,
   136	      code_fix: "",
   137	    })),
   138	    medium_findings: medium.map((f, i) => ({
   139	      "@index": i + 1,
   140	      id: f.id,
   141	      title: f.title,
   142	      file: f.location.file,
   143	      line: f.location.line || 0,
   144	      standard: f.standard || "N/A",
   145	      cvss_v4: f.cvss_v4 || 0,
   146	    })),
   147	    low_info_findings: lowInfo.map((f, i) => ({
   148	      "@index": i + 1,
   149	      id: f.id,
   150	      title: f.title,
   151	      file: f.location.file,
   152	      line: f.location.line || 0,
   153	      standard: f.standard || "N/A",
   154	    })),
   155	    recommendations: recommendations as unknown as TemplateContext[],
   156	  });
   157	
   158	  // Process {{#if}} blocks
   159	  result = processIfBlocks(result);
   160	
   161	  // Replace simple {{variables}}
   162	  result = replaceVariables(result, context);
   163	
   164	  return result;
   165	}
   166	
   167	function countSeverities(findings: Finding[]): Record<string, number> {
   168	  const counts: Record<string, number> = {
   169	    CRITICAL: 0,
   170	    HIGH: 0,
   171	    MEDIUM: 0,
   172	    LOW: 0,
   173	    INFO: 0,
   174	  };
   175	  for (const f of findings) {
   176	    counts[f.severity] = (counts[f.severity] || 0) + 1;
   177	  }
   178	  return counts;
   179	}
   180	
   181	function processEachBlocks(
   182	  template: string,
   183	  collections: Record<string, TemplateContext[]>
   184	): string {
   185	  // Match {{#each collectionName}}...{{/each}}
   186	  const eachRegex = /\{\{#each\s+(\w+)\}\}\n?([\s\S]*?)\{\{\/each\}\}/g;
   187	
   188	  return template.replace(eachRegex, (_match, collectionName, body) => {
   189	    const items = collections[collectionName];
   190	    if (!items || items.length === 0) {
   191	      return "_No findings in this category._\n";
   192	    }
   193	
   194	    return items
   195	      .map((item) => {
   196	        let rendered = body;
   197	        // Replace {{variable}} with item values
   198	        rendered = rendered.replace(
   199	          /\{\{(@?\w+)\}\}/g,
   200	          (_m: string, key: string) => {
   201	            const val = item[key];
   202	            return val !== undefined ? String(val) : "";
   203	          }
   204	        );
   205	        return rendered;
   206	      })
   207	      .join("");
   208	  });
   209	}
   210	
   211	function processIfBlocks(template: string): string {
   212	  // Match {{#if variable}}...{{/if}}
   213	  const ifRegex = /\{\{#if\s+(\w+)\}\}\n?([\s\S]*?)\{\{\/if\}\}/g;
   214	
   215	  return template.replace(ifRegex, (_match, _variable, body) => {
   216	    // After each-block processing, variables are already replaced.
   217	    // If the body content (between markers) is empty/whitespace-only, hide the block.
   218	    const stripped = body.replace(/\{\{\w+\}\}/g, "").trim();
   219	    // Check for actual content: if only whitespace/code-fence markers remain, skip
   220	    const contentOnly = stripped.replace(/```\w*/g, "").trim();
   221	    if (!contentOnly) {
   222	      return "";
   223	    }
   224	    return body;
   225	  });
   226	}
   227	
   228	function replaceVariables(
   229	  template: string,
   230	  context: TemplateContext
   231	): string {
   232	  return template.replace(/\{\{(\w+)\}\}/g, (_match, key) => {
   233	    const val = context[key];
   234	    return val !== undefined ? String(val) : "";
   235	  });
   236	}
   237	
   238	/**
   239	 * Fallback renderer when template is not available.
   240	 */

