    36	# ---------------------------------------------------------------------------
    37	# Reference examples — loaded from domain rules.json for few-shot prompting
    38	# ---------------------------------------------------------------------------
    39	
    40	def load_reference_rules(domain=None):
    41	    """Load curated domain rules with populated patterns as few-shot examples."""
    42	    examples = []
    43	    pattern = os.path.join(DOMAINS_DIR, domain or "*", "rules.json")
    44	    for path in sorted(glob.glob(pattern)):
    45	        with open(path) as f:
    46	            rules = json.load(f)
    47	        for r in rules:
    48	            detect = r.get("detect", {})
    49	            if detect.get("patterns"):
    50	                examples.append({
    51	                    "id": r["id"],
    52	                    "category": r.get("category", ""),
    53	                    "title": r.get("title", ""),
    54	                    "description": r.get("description", "")[:200],
    55	                    "cwe": [s for s in r.get("standards", []) if s.startswith("CWE-")],
    56	                    "detect": {
    57	                        "patterns": detect["patterns"][:3],
    58	                        "negative_patterns": detect.get("negative_patterns", [])[:3],
    59	                        "file_types": detect.get("file_types", []),
    60	                    },
    61	                })
    62	    return examples
    63	
    64	
    65	def pick_reference_examples(rule, all_examples, count=3):
    66	    """Pick the most relevant reference examples for a given CVE rule."""
    67	    domain = rule.get("category", "")
    68	    cwe_ids = set(s for s in rule.get("standards", []) if s.startswith("CWE-"))
    69	
    70	    scored = []
    71	    for ex in all_examples:
    72	        score = 0
    73	        if ex["category"] == domain:
    74	            score += 2
    75	        if cwe_ids & set(ex.get("cwe", [])):
    76	            score += 3
    77	        scored.append((score, ex))
    78	
    79	    scored.sort(key=lambda x: -x[0])
    80	    return [ex for _, ex in scored[:count]]
    81	
