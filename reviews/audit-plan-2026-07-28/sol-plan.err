   128	# ---------------------------------------------------------------------------
   129	# File type matching
   130	# ---------------------------------------------------------------------------
   131	
   132	def file_matches_types(filename, file_types):
   133	    """Check if filename matches any of the rule's file_types globs."""
   134	    if not file_types:
   135	        return True  # No filter = match all source files
   136	
   137	    for ft in file_types:
   138	        if ft.startswith("*."):
   139	            ext = ft[1:]  # .js, .py, etc.
   140	            if filename.endswith(ext):
   141	                return True
   142	        elif ft == filename:
   143	            return True
   144	    return False
   145	
   146	
   147	# ---------------------------------------------------------------------------
   148	# Pattern matching engine
   149	# ---------------------------------------------------------------------------
   150	
   151	def scan_file(file_info, patterns, negative_patterns, file_types):
   152	    """Scan a single file with a rule's patterns. Returns list of matches."""
   153	    if not file_matches_types(file_info["filename"], file_types):
   154	        return []
   155	
   156	    matches = []
   157	    for line_num, line in enumerate(file_info["lines"], 1):
   158	        for pattern in patterns:
   159	            try:
   160	                if re.search(pattern, line):
   161	                    # Check negative patterns (mitigations)
   162	                    mitigated = False
   163	                    for neg in negative_patterns:
   164	                        try:
   165	                            if re.search(neg, line):
   166	                                mitigated = True
   167	                                break
   168	                        except re.error:
   169	                            pass
   170	
   171	                    if not mitigated:
   172	                        matches.append({
   173	                            "file": file_info["filename"],
   174	                            "line": line_num,
   175	                            "pattern": pattern,
   176	                            "text": line.strip()[:120],
   177	                        })
   178	            except re.error:
   179	                pass
   180	
   181	    return matches
   182	
   183	
   184	def run_rule_against_corpus(rule, corpus_files):
   185	    """Run a rule's patterns against a list of files."""
   186	    patterns = rule.get("detect", {}).get("patterns", [])
   187	    negative_patterns = rule.get("detect", {}).get("negative_patterns", [])
   188	    file_types = rule.get("detect", {}).get("file_types", [])
   189	
   190	    all_matches = []
   191	    for file_info in corpus_files:
   192	        matches = scan_file(file_info, patterns, negative_patterns, file_types)
   193	        all_matches.extend(matches)
   194	
   195	    return all_matches
   196	
   197	
   198	# ---------------------------------------------------------------------------
   199	# Rule testing
   200	# ---------------------------------------------------------------------------
   201	
   202	def test_rule(rule, corpus, precision_gate=DEFAULT_PRECISION_GATE, verbose=False):
   203	    """Test a single rule. Returns a result dict with scores."""
   204	    rule_id = rule["id"]
   205	    patterns = rule.get("detect", {}).get("patterns", [])
   206	
   207	    result = {
   208	        "id": rule_id,
   209	        "domain": rule.get("_domain"),
   210	        "title": rule.get("title", "")[:60],
   211	        "confidence": rule.get("confidence", 0),
   212	        "pattern_count": len(patterns),
   213	        "patterns_valid": 0,
   214	        "patterns_invalid": [],
   215	        "tp_count": 0,
   216	        "fp_count": 0,
   217	        "tp_matches": [],
   218	        "fp_matches": [],
   219	        "precision": None,
   220	        "verdict": "inconclusive",
   221	    }
   222	
   223	    # Step 1: Validate patterns
   224	    valid_patterns = []
   225	    for p in patterns:
   226	        check = validate_pattern(p)
   227	        if check["valid"]:
   228	            result["patterns_valid"] += 1
   229	            valid_patterns.append(p)
   230	        else:
   231	            result["patterns_invalid"].append({"pattern": p, "error": check["error"]})
   232	
   233	    if result["patterns_valid"] == 0:
   234	        result["verdict"] = "invalid"
   235	        return result
   235	        return result
   236	
   237	    # Step 2: True positives — matches in vulnerable corpus
   238	    tp_matches = run_rule_against_corpus(rule, corpus["vulnerable"])
   239	    result["tp_matches"] = tp_matches
   240	    result["tp_count"] = len(tp_matches)
   241	
   242	    # Step 3: False positives — matches in safe corpus
   243	    fp_matches = run_rule_against_corpus(rule, corpus["safe"])
   244	    result["fp_matches"] = fp_matches
   245	    result["fp_count"] = len(fp_matches)
   246	
   247	    # Step 4: Calculate precision
   248	    tp = result["tp_count"]
   249	    fp = result["fp_count"]
   250	
   251	    if tp + fp == 0:
   252	        result["verdict"] = "no-matches"
   253	        result["precision"] = None
   254	    elif tp == 0 and fp > 0:
   255	        result["precision"] = 0.0
   256	        result["verdict"] = "fp-only"
   257	    else:
   258	        result["precision"] = tp / (tp + fp)
   259	        result["verdict"] = "pass" if result["precision"] >= precision_gate else "fail"
   260	
   261	    if verbose:
   262	        if tp_matches:
   263	            print(f"    TP ({tp}):")
   264	            for m in tp_matches[:5]:
   265	                print(f"      {m['file']}:{m['line']} [{m['pattern'][:40]}] → {m['text'][:60]}")
   266	            if tp > 5:
   267	                print(f"      ... and {tp - 5} more")
   268	        if fp_matches:
   269	            print(f"    FP ({fp}):")
   270	            for m in fp_matches[:5]:
   271	                print(f"      {m['file']}:{m['line']} [{m['pattern'][:40]}] → {m['text'][:60]}")
   272	            if fp > 5:
   273	                print(f"      ... and {fp - 5} more")
   274	
   275	    return result
   276	
   277	
   278	# ---------------------------------------------------------------------------
   279	# Apply results to cve-rules.json
   280	# ---------------------------------------------------------------------------
   281	
   282	def apply_results(rules, test_results, precision_gate, dry_run=False):
   283	    """Update rule statuses in cve-rules.json files."""
   284	    now = datetime.now(timezone.utc).isoformat()
   285	    results_by_id = {r["id"]: r for r in test_results}
   286	    rules_by_id = {r["id"]: r for r in rules}
   287	    files_modified = set()
   288	
   289	    counts = {"active": 0, "needs-review": 0, "no-matches": 0, "invalid": 0}
   290	
   291	    for result in test_results:
   292	        verdict = result["verdict"]
   293	
   294	        if verdict == "pass":
   295	            new_status = "active"
   296	            counts["active"] += 1
   297	        elif verdict in ("fail", "fp-only"):
   298	            new_status = "needs-review"
   299	            counts["needs-review"] += 1
   300	        elif verdict == "no-matches":
   301	            new_status = "no-matches"
   302	            counts["no-matches"] += 1
   303	        elif verdict == "invalid":
   304	            new_status = "invalid"
   305	            counts["invalid"] += 1
   306	        else:
   307	            continue
   308	
   309	        rule = rules_by_id.get(result["id"])
   310	        if rule:
   311	            files_modified.add(rule["_source_path"])
   312	
   313	    if dry_run:
   314	        return counts
   315	
   316	    # Write changes
   317	    for path in files_modified:
   318	        with open(path) as f:
   319	            all_rules = json.load(f)
   320	
   321	        changed = False
   322	        for i, r in enumerate(all_rules):
   323	            if r["id"] not in results_by_id:
   324	                continue
   325	            result = results_by_id[r["id"]]
   326	            verdict = result["verdict"]
   327	
   328	            if verdict == "pass":
   329	                all_rules[i]["status"] = "active"
   330	            elif verdict in ("fail", "fp-only"):
   331	                all_rules[i]["status"] = "needs-review"
   332	            elif verdict == "no-matches":
   333	                all_rules[i]["status"] = "no-matches"
   334	            elif verdict == "invalid":
   335	                all_rules[i]["status"] = "invalid"
   336	            else:
   337	                continue
   338	
   339	            if result["precision"] is not None:
   340	                all_rules[i]["test_precision"] = round(result["precision"], 3)
   341	            all_rules[i]["tested_at"] = now
   342	            changed = True
   343	
   344	        if changed:
   345	            with open(path, "w") as f:
   346	                json.dump(all_rules, f, indent=2)
   347	                f.write("\n")
   348	            domain = os.path.basename(os.path.dirname(path))
   349	            n = sum(1 for r in test_results
   350	                    if rules_by_id.get(r["id"], {}).get("_source_path") == path)
   351	            print(f"  Updated {domain}/cve-rules.json: {n} rules")
   352	
   353	    return counts
   354	
   355	
   356	# ---------------------------------------------------------------------------
   357	# Report
   358	# ---------------------------------------------------------------------------
   359	
   360	def print_results_table(test_results):
   361	    """Print a summary table of test results."""
   362	    print(f"\n{'ID':24s} {'Domain':14s} {'Pats':>4s} {'TP':>4s} {'FP':>4s} {'Prec':>6s} {'Verdict':12s}")
   363	    print("-" * 76)
   364	
   365	    for r in sorted(test_results, key=lambda x: (
   366	        {"pass": 0, "fail": 1, "fp-only": 2, "no-matches": 3, "invalid": 4}.get(x["verdict"], 5),
   367	        -(x["precision"] or 0),
   368	    )):
   369	        prec_str = f"{r['precision']:.1%}" if r["precision"] is not None else "—"
   370	        verdict_icon = {
   370	        verdict_icon = {
   371	            "pass": "PASS",
   372	            "fail": "FAIL",
   373	            "fp-only": "FP-ONLY",
   374	            "no-matches": "NO-MATCH",
   375	            "invalid": "INVALID",
   376	        }.get(r["verdict"], r["verdict"])
   377	
   378	        print(f"{r['id']:24s} {r['domain']:14s} {r['pattern_count']:4d} "
   379	              f"{r['tp_count']:4d} {r['fp_count']:4d} {prec_str:>6s} {verdict_icon:12s}")
   380	
   381	    # Invalid patterns detail
   382	    invalids = [r for r in test_results if r["patterns_invalid"]]
   383	    if invalids:
   384	        print(f"\n--- Invalid patterns ---")
   385	        for r in invalids:
   386	            for inv in r["patterns_invalid"]:
   387	                print(f"  {r['id']}: {inv['error']} — {inv['pattern'][:60]}")
   388	
   389	
   390	# ---------------------------------------------------------------------------
   391	# Main
   392	# ---------------------------------------------------------------------------
   393	
   394	def main():
   395	    parser = argparse.ArgumentParser(
   396	        description="Validate LLM-generated CVE detection patterns against test corpus")
   397	    parser.add_argument("--domain", type=str, default=None,
   398	                        help="Only test rules from this domain")
   399	    parser.add_argument("--precision", type=float, default=DEFAULT_PRECISION_GATE,
   400	                        help=f"Precision gate for promotion (default: {DEFAULT_PRECISION_GATE})")
   401	    parser.add_argument("--verbose", action="store_true",
   402	                        help="Show individual match details")
   403	    parser.add_argument("--dry-run", action="store_true",
   404	                        help="Preview results without updating rule statuses")
   405	    args = parser.parse_args()
   406	
   407	    precision_gate = args.precision
   408	
   409	    print("=" * 60)
   410	    print("Sentinel Rule Tester")
   411	    print("=" * 60)
   412	
   413	    # Load corpus
   414	    corpus = load_corpus()
   415	    print(f"\nCorpus loaded:")
   416	    print(f"  Vulnerable files: {len(corpus['vulnerable'])} "
   417	          f"({sum(len(f['lines']) for f in corpus['vulnerable'])} lines)")
   418	    print(f"  Safe files:       {len(corpus['safe'])} "
   419	          f"({sum(len(f['lines']) for f in corpus['safe'])} lines)")
   420	
   421	    # Load rules
   422	    rules = load_untested_rules(args.domain)
   423	    print(f"\nUntested rules: {len(rules)}")
   424	
   425	    if not rules:
   426	        print("No untested rules to validate. Done.")
   427	        return
   428	
   429	    # Domain breakdown
   430	    domain_counts = {}
   431	    for r in rules:
   432	        d = r.get("_domain", "unknown")
   433	        domain_counts[d] = domain_counts.get(d, 0) + 1
   434	    print(f"  By domain: {', '.join(f'{d}={c}' for d, c in sorted(domain_counts.items()))}")
   435	
   436	    # Test each rule
   437	    print(f"\nPrecision gate: {precision_gate:.0%}")
   438	    print(f"Testing...\n")
   439	
   440	    test_results = []
   441	    for i, rule in enumerate(rules):
   442	        label = f"[{i+1}/{len(rules)}]"
   443	        print(f"  {label} {rule['id']} ({rule.get('_domain')})...", end="", flush=True)
   444	        result = test_rule(rule, corpus, precision_gate=precision_gate, verbose=args.verbose)
   445	        test_results.append(result)
   446	
   447	        prec = f"{result['precision']:.0%}" if result['precision'] is not None else "—"
   448	        print(f" TP={result['tp_count']} FP={result['fp_count']} "
   449	              f"prec={prec} → {result['verdict']}")
   450	
   451	    # Results table
   452	    print_results_table(test_results)
   453	
   454	    # Summary
   455	    verdicts = {}
   456	    for r in test_results:
   457	        verdicts[r["verdict"]] = verdicts.get(r["verdict"], 0) + 1
   458	
   459	    print(f"\n{'=' * 60}")
   460	    print(f"Summary ({len(test_results)} rules tested):")
   461	    print(f"  PASS (→ active):      {verdicts.get('pass', 0)}")
   462	    print(f"  FAIL (→ needs-review): {verdicts.get('fail', 0)}")
   463	    print(f"  FP-ONLY (→ needs-review): {verdicts.get('fp-only', 0)}")
   464	    print(f"  NO-MATCH (→ no-matches): {verdicts.get('no-matches', 0)}")
   465	    print(f"  INVALID:              {verdicts.get('invalid', 0)}")
   466	
   467	    # Apply
   468	    if args.dry_run:
   469	        print(f"\n--- DRY RUN: no statuses updated ---")
   470	    else:
   471	        print(f"\n--- Applying results ---")
   472	        counts = apply_results(rules, test_results, precision_gate)
   473	        print(f"\nApplied: {counts['active']} active, "
   474	              f"{counts['needs-review']} needs-review, "
   475	              f"{counts['no-matches']} no-matches, "
   476	              f"{counts['invalid']} invalid")
   477	
   478	    # Next steps
   479	    promoted = verdicts.get("pass", 0)
   480	    if promoted > 0:
   481	        print(f"\nNext: run 'python3 rag/indexer.py' to re-index promoted rules")
   482	
   483	    print(f"{'=' * 60}")
   484	
   485	
   486	if __name__ == "__main__":
   487	    main()

