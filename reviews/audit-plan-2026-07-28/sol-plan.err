   149	
   150	SYSTEM_PROMPT = """\
   151	You are a security static analysis rule generator. Given a CVE description, you generate \
   152	regex detection patterns that identify vulnerable code patterns in source files.
   153	
   154	Rules:
   155	- Patterns are Python-compatible regex strings used with re.search() on source code lines
   156	- Patterns should be specific enough to detect the vulnerability class, not just the CVE product
   157	- Focus on the CWE (weakness class) to write general patterns, not product-specific strings
   158	- negative_patterns are strings/regexes that indicate the vulnerability is mitigated (e.g., sanitization functions)
   159	- file_types are glob patterns for files to scan (e.g., "*.js", "*.py", "*.go")
   160	- exclude lists directory names to skip during scanning
   161	- confidence: 1.0 = exact CVE pattern, 0.7 = CWE-class pattern, 0.4 = broad heuristic
   162	- If the CVE is too product-specific or infrastructure-only (no detectable code pattern), \
   163	set patterns to an empty array and confidence to 0.0
   164	
   165	Output ONLY valid JSON, no markdown fences, no explanation."""
   166	
   167	
   168	def build_user_prompt(rule, examples):
   169	    """Build the user prompt for a single CVE rule."""
   170	    cwe_list = ", ".join(s for s in rule.get("standards", []) if s.startswith("CWE-"))
   171	    epss_info = ""
   172	    if rule.get("epss_score"):
   173	        epss_info = f"\nEPSS Score: {rule['epss_score']:.4f} (exploit probability)"
   174	
   175	    examples_text = ""
   176	    if examples:
   177	        ex_items = []
   178	        for ex in examples:
   179	            ex_items.append(json.dumps({
   180	                "id": ex["id"],
   181	                "title": ex["title"],
   182	                "cwe": ex["cwe"],
   183	                "detect": ex["detect"],
   184	            }, indent=2))
   185	        examples_text = "\n\nReference patterns from the same domain (learn the style):\n" + \
   186	            "\n---\n".join(ex_items)
   187	
   188	    return f"""\
   189	Generate detection patterns for this CVE:
   190	
   191	CVE ID: {rule['id']}
   192	Severity: {rule.get('severity', 'UNKNOWN')} (CVSS {rule.get('cvss_v4', 'N/A')})
   193	Domain: {rule.get('category', 'unknown')}
   194	CWE: {cwe_list or 'Not specified'}
   195	Description: {rule.get('description', 'No description available')}{epss_info}
   196	{examples_text}
   197	
   198	Output JSON with this exact schema:
   199	{{
   200	  "patterns": ["regex1", "regex2"],
   201	  "file_types": ["*.ext"],
   202	  "negative_patterns": ["mitigationPattern1"],
   203	  "exclude": ["dir_to_skip"],
   204	  "confidence": 0.7
   205	}}"""
