{"id":"API-BOLA-001","severity":"CRITICAL","cvss_v4":9.1,"category":"api","subcategory":"bola","title":"Broken Object Level Authorization — resource accessed without ownership check","description":"API endpoint retrieves or modifies a resource by ID from request parameters without verifying that the authenticated user owns or has permission to access it. This is the #1 API vulnerability (BOLA/IDOR).","detect":{"patterns":["findById\\(req\\.params\\.","findOne\\(\\{.*id:\\s*req\\.params","findUnique.*where.*id.*req\\.params","findByPk\\(req\\.params","get.*/:id.*findById","Model\\.objects\\.get\\(pk="],"negative_patterns":["req\\.user\\.id","userId.*req\\.user","author.*req\\.user","owner.*req\\.user","belongsTo","checkOwnership","authorize"],"file_types":["*.js","*.ts","*.py","*.rb","*.go"],"exclude":["node_modules","dist","build","test"]},"remediation":{"description":"Always verify resource ownership after fetching. Add a WHERE clause that includes the authenticated user's ID, or check ownership before returning the resource.","code_example":"// Good: ownership check in query\nconst item = await prisma.item.findFirst({\n  where: { id: req.params.id, userId: req.user.id }\n});\nif (!item) return res.status(404).json({ error: 'Not found' });","references":["https://owasp.org/API-Security/editions/2023/en/0xa1-broken-object-level-authorization/"]},"standards":["CWE-639","CWE-862","OWASP-API1:2023"],"ai_specific":false,"frameworks":["express","fastify","django","rails","fastapi"]}
{"id":"API-CONSUMPTION-001","severity":"MEDIUM","cvss_v4":6.5,"category":"api","subcategory":"unsafe-consumption","title":"Third-party API response used without validation","description":"Data received from external/third-party APIs used directly without validation or sanitization, creating injection vectors via untrusted external data.","detect":{"patterns":["await fetch\\(['\"]https://.*\\.then.*\\.json\\(\\)\\s*(?!.*validate)","axios\\.get\\(['\"]https://.*\\.data(?!.*schema)","response\\.json\\(\\).*(?!.*validate|.*schema|.*zod|.*yup)"],"file_types":["*.js","*.ts","*.py"],"exclude":["node_modules","dist","build"]},"remediation":{"description":"Validate all data received from third-party APIs against expected schemas. Treat external API data as untrusted input.","code_example":"import { z } from 'zod';\n\nconst ExternalDataSchema = z.object({\n  id: z.string(),\n  name: z.string().max(255),\n  status: z.enum(['active', 'inactive'])\n});\n\nconst response = await fetch('https://api.external.com/data');\nconst rawData = await response.json();\nconst data = ExternalDataSchema.parse(rawData);","references":["https://owasp.org/API-Security/editions/2023/en/0xa10-unsafe-consumption-of-apis/"]},"standards":["CWE-20","OWASP-API10:2023"],"ai_specific":false,"frameworks":["*"]}
FILE ../../knowledge-base/domains/cors/rules.json
{"id":"CORS-ORIGIN-001","severity":"HIGH","cvss_v4":8.0,"category":"cors","subcategory":"origin","title":"Wildcard Access-Control-Allow-Origin on authenticated endpoint","description":"CORS configured with wildcard origin (*) on endpoints that handle authenticated requests. This allows any website to make cross-origin requests to the API.","detect":{"patterns":["Access-Control-Allow-Origin.*\\*","origin:\\s*['\"]\\*['\"]","origin:\\s*true","cors\\(\\)\\s*(?!\\{)"],"negative_patterns":["origin:\\s*\\[","allowlist","whitelist","origin.*function"],"file_types":["*.js","*.ts","*.mjs","*.py","*.rb","*.conf"],"exclude":["node_modules","dist","build"]},"remediation":{"description":"Configure CORS with a specific allowlist of trusted origins instead of using wildcard.","code_example":"app.use(cors({\n  origin: ['https://app.example.com', 'https://admin.example.com'],\n  credentials: true\n}));","references":["https://cheatsheetseries.owasp.org/cheatsheets/CORS_Cheat_Sheet.html"]},"standards":["CWE-942","OWASP-A05:2025"],"ai_specific":false,"frameworks":["express","fastify","django","flask","rails"]}
{"id":"CORS-VARY-001","severity":"LOW","cvss_v4":3.1,"category":"cors","subcategory":"headers","title":"Missing Vary: Origin header in CORS response","description":"When Access-Control-Allow-Origin is set dynamically based on the request Origin, the response must include Vary: Origin to prevent cache poisoning.","detect":{"patterns":["Access-Control-Allow-Origin.*req\\.(headers|get)\\(.*origin","origin.*function","res\\.header.*Access-Control-Allow-Origin.*origin"],"negative_patterns":["Vary.*Origin","vary.*origin"],"file_types":["*.js","*.ts","*.mjs","*.py","*.rb"],"exclude":["node_modules","dist","build"]},"remediation":{"description":"Add Vary: Origin header when dynamically setting Access-Control-Allow-Origin based on the request.","code_example":"res.header('Access-Control-Allow-Origin', allowedOrigin);\nres.header('Vary', 'Origin');","references":["https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Vary"]},"standards":["CWE-525"],"ai_specific":false,"frameworks":["express","fastify","node"]}
FILE ../../knowledge-base/domains/data-privacy/rules.json
{"id":"PRIV-PII-001","severity":"HIGH","cvss_v4":7.5,"category":"data-privacy","subcategory":"pii-protection","title":"PII logged without masking","description":"Personally identifiable information (email, password, SSN) is written to application logs without masking or redaction. Attackers with log access can harvest sensitive data in bulk.","detect":{"patterns":["console\\.(log|info|warn|error|debug)\\s*\\(.*\\b(email|e-mail|mail)\\b","(logger|log|logging)\\.(info|warn|error|debug)\\s*\\(.*\\b(password|passwd|pwd)\\b","(console|logger|log)\\.(log|info|warn|error|debug)\\s*\\(.*\\b(ssn|social_security|socialSecurity)\\b","print\\s*\\(.*\\b(email|password|ssn|social_security)\\b","logging\\.(info|warning|error|debug)\\s*\\(.*\\b(email|password|ssn)\\b"],"negative_patterns":["mask(ed)?\\s*\\(","redact(ed)?\\s*\\(","\\*{3,}","\\[REDACTED\\]","sanitize\\s*\\("],"file_types":["*.js","*.ts","*.py","*.java","*.go","*.rb"],"exclude":["node_modules","dist","build","test","__pycache__","__tests__"]},"remediation":{"description":"Never log raw PII. Use a masking utility to redact sensitive fields before writing to any log output.","code_example":"function maskPII(value) {\n  if (!value) return value;\n  return value.slice(0, 2) + '***' + value.slice(-2);\n}\nlogger.info('User login', { email: maskPII(user.email) });","references":["https://cheatsheetseries.owasp.org/cheatsheets/Logging_Cheat_Sheet.html","https://cwe.mitre.org/data/definitions/532.html"]},"standards":["CWE-532","GDPR-Art-5","GDPR-Art-25"],"ai_specific":false,"frameworks":["express","django","flask","fastapi","spring","rails"]}
{"id":"PRIV-ENVBYPASS-001","severity":"HIGH","cvss_v4":7.5,"category":"data-privacy","subcategory":"security-bypass","title":"Security bypass flags exposed in environment configuration","description":"Environment files or CI configs contain variables that disable security mechanisms (credential scrubbing, MCP sandboxing, hook execution). The Claude Code source leak (2026-03-31) revealed multiple env vars that bypass security features. Exposing these in committed files creates a documented path for attackers to disable protections.","detect":{"patterns":["DISABLE_.*(?:AUTH|SECURITY|VERIFY|CHECK|HOOK|SANDBOX)","SKIP_.*(?:AUTH|SECURITY|VERIFY|CHECK|VALIDATION)","NO_.*(?:AUTH|VERIFY|CHECK|SSL|TLS)\\s*=","UNSAFE_.*=","INSECURE_.*=","NODE_TLS_REJECT_UNAUTHORIZED\\s*=\\s*['\"]?0"],"negative_patterns":["# test only","# development only","NODE_ENV.*test"],"file_types":[".env",".env.*","Dockerfile","docker-compose.*","*.yaml","*.yml"],"exclude":["node_modules","dist","test"]},"remediation":{"description":"Never commit security bypass variables to production configs. Use separate environment files for dev/test/prod. Audit CI pipelines for security-disabling variables. Add pre-commit hooks to block commits containing security bypass patterns.","code_example":"# pre-commit hook to catch bypass vars\n#!/bin/bash\nif git diff --cached | grep -iE '(DISABLE_AUTH|SKIP_VERIFY|NODE_TLS_REJECT_UNAUTHORIZED=0|INSECURE_)'; then\n  echo 'ERROR: Security bypass variable detected in commit'\n  exit 1\nfi","references":["https://cheatsheetseries.owasp.org/cheatsheets/Environment_Secrets_Cheat_Sheet.html"]},"standards":["CWE-489","CWE-215","OWASP-A05:2025"],"ai_specific":false,"frameworks":[]}
FILE ../../knowledge-base/domains/database/rules.json
{"id":"DB-INJECT-001","severity":"CRITICAL","cvss_v4":9.1,"category":"database","subcategory":"injection","title":"NoSQL Operator Injection via Unsanitized User Input","description":"User-controlled input is passed directly into a MongoDB query without sanitization, allowing attackers to inject NoSQL operators such as $gt, $lt, $ne, $regex, or $where to bypass authentication, exfiltrate data, or manipulate query logic.","detect":{"patterns":["\\.(find|findOne|findOneAndUpdate|findOneAndDelete|updateOne|updateMany|deleteOne|deleteMany)\\s*\\(\\s*\\{[^}]*req\\.(body|query|params)","\\$where\\s*:\\s*['\"`]","\\{\\s*\\$(gt|gte|lt|lte|ne|in|nin|regex|exists|where)\\s*:\\s*req\\.(body|query|params)","\\.find\\(\\s*req\\.(body|query|params)","\\.(aggregate|mapReduce)\\s*\\(\\s*\\[?\\s*req\\.(body|query|params)"],"negative_patterns":["mongo-sanitize","express-mongo-sanitize","sanitize\\(req\\.","\\.escape\\(req\\."],"file_types":["*.js","*.ts","*.mjs","*.cjs"],"exclude":["node_modules","dist","build","test","__tests__","__pycache__"]},"remediation":{"description":"Use input validation and sanitization libraries such as express-mongo-sanitize or mongo-sanitize. Validate expected types before passing user input to queries. Never pass raw request bodies directly into query objects.","code_example":"const sanitize = require('express-mongo-sanitize');\napp.use(sanitize());\n\n// Explicit field extraction instead of passing req.body\nconst user = await User.findOne({ email: String(req.body.email) });","references":["https://owasp.org/www-project-web-security-testing-guide/latest/4-Web_Application_Security_Testing/07-Input_Validation_Testing/05.6-Testing_for_NoSQL_Injection","https://cwe.mitre.org/data/definitions/943.html"]},"standards":["CWE-943"],"ai_specific":false,"frameworks":["mongodb","mongoose","mongoclient"]}
{"id":"DB-BACKUP-001","severity":"MEDIUM","cvss_v4":5.5,"category":"database","subcategory":"backup","title":"Unencrypted Database Backup Operations","description":"Database backup commands are executed without encryption flags, producing unencrypted dump files that may contain sensitive data. If these backups are stored on shared storage, transmitted over unencrypted channels, or left on compromised systems, the data is fully exposed.","detect":{"patterns":["mongodump\\s+(?!.*--ssl)(?!.*--tls)","mongodump\\s+(?!.*--archive=.*\\.enc)","pg_dump\\s+(?!.*--format=custom)(?!.*\\|\\s*(gpg|openssl|age))","pg_dumpall\\s+(?!.*\\|\\s*(gpg|openssl|age))","mysqldump\\s+(?!.*\\|\\s*(gpg|openssl|age))","xtrabackup\\s+(?!.*--encrypt)","redis-cli.*--rdb\\s+(?!.*gpg)"],"negative_patterns":["encrypt","gpg","openssl\\s+enc","age\\s+-r","--ssl","--tls","kms"],"file_types":["*.sh","*.bash","*.yaml","*.yml","*.py","*.js","*.ts","Makefile","Dockerfile"],"exclude":["node_modules","dist","build","test","__pycache__"]},"remediation":{"description":"Encrypt all database backups using GPG, OpenSSL, or cloud-native encryption (AWS KMS, GCP CMEK). Use TLS for backup transfers. Store backups in encrypted storage with restricted access. Implement backup retention policies and verify backup integrity regularly.","code_example":"# Encrypted MongoDB backup\nmongodump --uri=\"$MONGO_URI\" --tls --archive | gpg --encrypt --recipient backup@company.com > backup.archive.gpg\n\n# Encrypted PostgreSQL backup\npg_dump --format=custom \"$DATABASE_URL\" | gpg --symmetric --cipher-algo AES256 > backup.dump.gpg\n\n# Encrypted MySQL backup\nmysqldump -u \"$DB_USER\" -p\"$DB_PASS\" --all-databases | openssl enc -aes-256-cbc -salt -out backup.sql.enc","references":["https://cheatsheetseries.owasp.org/cheatsheets/Database_Security_Cheat_Sheet.html","https://cwe.mitre.org/data/definitions/312.html"]},"standards":["CWE-312"],"ai_specific":false,"frameworks":["mongodb","postgresql","mysql","redis","mariadb"]}
FILE ../../knowledge-base/domains/infrastructure/rules.json
{"id":"INFRA-DOCKER-001","severity":"HIGH","cvss_v4":7.5,"category":"infrastructure","subcategory":"docker","title":"Container running as root user","description":"The Dockerfile does not specify a non-root USER or explicitly sets USER root. Running containers as root grants full host-level privileges if an attacker escapes the container, dramatically increasing the blast radius of any compromise.","detect":{"patterns":["^USER\\s+root\\s*$","^(?!.*USER\\s+\\S).*FROM\\s+\\S+"],"negative_patterns":["^USER\\s+(?!root)\\S+"],"file_types":["Dockerfile","*.dockerfile"],"exclude":["node_modules","dist","build","test","__pycache__"]},"remediation":{"description":"Create a dedicated non-root user and switch to it before the ENTRYPOINT/CMD instruction. Use numeric UID for consistency across environments.","code_example":"RUN groupadd -r appuser && useradd -r -g appuser -s /sbin/nologin appuser\nUSER appuser:appuser","references":["https://docs.docker.com/engine/reference/builder/#user","https://cheatsheetseries.owasp.org/cheatsheets/Docker_Security_Cheat_Sheet.html"]},"standards":["CWE-250"],"ai_specific":false,"frameworks":["docker","podman"]}
{"id":"INFRA-NET-001","severity":"HIGH","cvss_v4":7.4,"category":"infrastructure","subcategory":"network","title":"Unrestricted network ingress (0.0.0.0/0)","description":"Security group or firewall rules allowing inbound traffic from 0.0.0.0/0 (any IPv4) or ::/0 (any IPv6) expose services to the entire internet. Combined with a vulnerable service, this enables direct exploitation from any attacker worldwide.","detect":{"patterns":["CidrIp\\s*[:=]\\s*['\"]?0\\.0\\.0\\.0/0['\"]?","cidr_blocks\\s*=\\s*\\[\\s*\"0\\.0\\.0\\.0/0\"\\s*\\]","source_ranges\\s*=\\s*\\[\\s*\"0\\.0\\.0\\.0/0\"\\s*\\]","0\\.0\\.0\\.0/0","::/0","from_port\\s*=\\s*0[\\s\\S]*?to_port\\s*=\\s*65535","ingress\\s*\\{[\\s\\S]*?0\\.0\\.0\\.0/0"],"negative_patterns":["^\\s*#.*0\\.0\\.0\\.0","egress","outbound"],"file_types":["*.tf","*.hcl","*.json","*.yaml","*.yml","*.template"],"exclude":["node_modules","dist","build","test","__pycache__"]},"remediation":{"description":"Restrict ingress to known IP ranges or CIDR blocks. Use VPN, bastion hosts, or AWS PrivateLink for internal services. For public services, use a load balancer with WAF in front rather than exposing instances directly.","code_example":"# Terraform: restrict to corporate VPN\nresource \"aws_security_group_rule\" \"allow_ssh\" {\n  type              = \"ingress\"\n  from_port         = 22\n  to_port           = 22\n  protocol          = \"tcp\"\n  cidr_blocks       = [\"10.0.0.0/8\"]  # internal only\n  security_group_id = aws_security_group.main.id\n}","references":["https://docs.aws.amazon.com/vpc/latest/userguide/security-group-rules.html","https://www.cisecurity.org/benchmark/amazon_web_services"]},"standards":["CWE-284"],"ai_specific":false,"frameworks":["aws","gcp","azure","terraform","cloudformation"]}
FILE ../../knowledge-base/domains/mobile/rules.json
{"id":"MOB-CRED-001","severity":"CRITICAL","cvss_v4":9.1,"category":"mobile","subcategory":"credential-storage","title":"Hardcoded credentials in mobile code","description":"Detects API keys, passwords, secrets, and tokens hardcoded directly in mobile application source code. Hardcoded credentials can be extracted through reverse engineering or static analysis of the application binary, leading to unauthorized access to backend services and data breaches.","detect":{"patterns":["(api[_-]?key|apikey|api[_-]?secret)\\s*[:=]\\s*[\"'][A-Za-z0-9_\\-]{16,}[\"']","(password|passwd|pwd|secret)\\s*[:=]\\s*[\"'][^\"']{8,}[\"']","Bearer\\s+[A-Za-z0-9\\-._~+/]+=*","AWS[A-Z0-9]{10,}","(sk|pk)_(live|test)_[A-Za-z0-9]{20,}","private[_-]?key\\s*[:=]\\s*[\"'][^\"']+[\"']"],"negative_patterns":["\\$\\{.*\\}","process\\.env\\.","Environment\\.","BuildConfig\\.","\\bplaceholder\\b","\\bexample\\b","\\bTODO\\b","\\bXXXX+\\b"],"file_types":["*.swift","*.kt","*.java","*.dart","*.js","*.ts","*.tsx","*.jsx"],"exclude":["node_modules","dist","build","test","__pycache__"]},"remediation":{"description":"Move all credentials to secure platform-specific storage. On iOS, use Keychain Services. On Android, use EncryptedSharedPreferences or the Android Keystore system. For React Native, use react-native-keychain. For Flutter, use flutter_secure_storage. Credentials should be provisioned at runtime via secure configuration management.","code_example":"// Android - EncryptedSharedPreferences\nval masterKey = MasterKey.Builder(context)\n    .setKeyScheme(MasterKey.KeyScheme.AES256_GCM)\n    .build()\nval securePrefs = EncryptedSharedPreferences.create(\n    context, \"secure_prefs\", masterKey,\n    EncryptedSharedPreferences.PrefKeyEncryptionScheme.AES256_SIV,\n    EncryptedSharedPreferences.PrefValueEncryptionScheme.AES256_GCM\n)\n\n// iOS - Keychain\nlet query: [String: Any] = [\n    kSecClass as String: kSecClassGenericPassword,\n    kSecAttrAccount as String: \"apiKey\",\n    kSecValueData as String: apiKey.data(using: .utf8)!\n]\nSecItemAdd(query as CFDictionary, nil)","references":["https://owasp.org/www-project-mobile-top-10/2024-risks/m1-improper-credential-usage","https://cwe.mitre.org/data/definitions/798.html","https://developer.android.com/topic/security/data","https://developer.apple.com/documentation/security/keychain_services"]},"standards":["CWE-798","OWASP-M01:2024"],"ai_specific":false,"frameworks":["react-native","flutter","swift","kotlin"]}
{"id":"MOB-CRYPTO-001","severity":"HIGH","cvss_v4":8.4,"category":"mobile","subcategory":"cryptography","title":"Use of weak or deprecated cryptographic algorithms","description":"Detects usage of weak, broken, or deprecated cryptographic algorithms such as MD5, SHA1 for security purposes, DES, 3DES, RC4, or ECB mode encryption. These algorithms have known vulnerabilities and do not provide adequate security for protecting sensitive data.","detect":{"patterns":["MessageDigest\\.getInstance\\([\"']MD5[\"']\\)","MessageDigest\\.getInstance\\([\"']SHA-1[\"']\\)","CC_MD5\\(|CC_SHA1\\(","Cipher\\.getInstance\\([\"']DES","Cipher\\.getInstance\\([\"'].*ECB","Cipher\\.getInstance\\([\"']RC4[\"']\\)","DESKeySpec|DESedeKeySpec","kCCAlgorithmDES|kCCAlgorithm3DES","CryptoJS\\.MD5|CryptoJS\\.SHA1|CryptoJS\\.DES|CryptoJS\\.RC4","md5\\(|sha1\\((?!.*hmac)"],"negative_patterns":["SHA-256|SHA-384|SHA-512","AES/GCM|AES/CBC/PKCS","kCCAlgorithmAES","PBKDF2","argon2"],"file_types":["*.swift","*.kt","*.java","*.dart","*.js","*.ts"],"exclude":["node_modules","dist","build","test","__pycache__"]},"remediation":{"description":"Replace weak algorithms with modern alternatives: use SHA-256 or SHA-3 instead of MD5/SHA1 for hashing, AES-256-GCM instead of DES/3DES/RC4 for encryption, and PBKDF2/Argon2 for key derivation. Always use authenticated encryption modes (GCM, CCM) instead of ECB or plain CBC.","code_example":"// Android - Use AES-GCM\nval cipher = Cipher.getInstance(\"AES/GCM/NoPadding\")\nval keyGenerator = KeyGenerator.getInstance(\"AES\")\nkeyGenerator.init(256)\nval secretKey = keyGenerator.generateKey()\nval iv = ByteArray(12)\nSecureRandom().nextBytes(iv)\ncipher.init(Cipher.ENCRYPT_MODE, secretKey, GCMParameterSpec(128, iv))\n\n// iOS - Use CryptoKit\nimport CryptoKit\nlet key = SymmetricKey(size: .bits256)\nlet sealedBox = try AES.GCM.seal(plaintext, using: key)\n\n// Hashing - Use SHA-256\nval digest = MessageDigest.getInstance(\"SHA-256\")\nlet hash = SHA256.hash(data: data)","references":["https://owasp.org/www-project-mobile-top-10/2024-risks/m10-insufficient-cryptography","https://cwe.mitre.org/data/definitions/327.html","https://developer.apple.com/documentation/cryptokit"]},"standards":["CWE-327","CWE-328","OWASP-M10:2024"],"ai_specific":false,"frameworks":["react-native","flutter","swift","kotlin"]}
FILE ../../knowledge-base/domains/ssl-tls/rules.json
{"id":"TLS-PROTO-001","severity":"HIGH","cvss_v4":7.4,"category":"ssl-tls","subcategory":"protocol","title":"Outdated TLS protocol version enabled","description":"Server configuration allows TLS 1.0 or TLS 1.1 connections, which have known vulnerabilities (BEAST, POODLE). Only TLS 1.2+ should be accepted.","detect":{"patterns":["ssl_protocols.*TLSv1[^.]","ssl_protocols.*TLSv1\\.0","ssl_protocols.*SSLv3","tls\\.min.*1\\.[01]","MinProtocol.*TLSv1[^.2-3]"],"negative_patterns":["TLSv1\\.2","TLSv1\\.3"],"file_types":["*.conf","*.cfg","*.yaml","*.yml","*.toml","*.json"],"exclude":["node_modules","dist","build"]},"remediation":{"description":"Configure the server to only accept TLS 1.2 and TLS 1.3. Disable SSLv3, TLS 1.0, and TLS 1.1.","code_example":"ssl_protocols TLSv1.2 TLSv1.3;","references":["https://cheatsheetseries.owasp.org/cheatsheets/Transport_Layer_Security_Cheat_Sheet.html"]},"standards":["CWE-326","OWASP-A02:2025"],"ai_specific":false,"frameworks":["nginx","apache","node"]}
{"id":"TLS-PIN-001","severity":"MEDIUM","cvss_v4":4.8,"category":"ssl-tls","subcategory":"pinning","title":"Missing certificate pinning for mobile/critical applications","description":"Application connecting to backend APIs does not implement certificate pinning, making it susceptible to man-in-the-middle attacks with rogue CA certificates.","detect":{"patterns":["fetch\\(","axios\\.","http\\.request","URLSession","OkHttpClient"],"negative_patterns":["pinning","pin","TrustManager","ssl_pinning","certificatePinner"],"file_types":["*.swift","*.kt","*.java","*.dart","*.js","*.ts"],"exclude":["node_modules","dist","build"]},"remediation":{"description":"Implement certificate pinning for connections to your own backend services. Use public key pinning rather than certificate pinning for easier rotation.","references":["https://cheatsheetseries.owasp.org/cheatsheets/Pinning_Cheat_Sheet.html"]},"standards":["CWE-295","OWASP-M5:2024"],"ai_specific":false,"frameworks":["ios","android","react-native","flutter"]}
FILE ../../knowledge-base/domains/static-sites/rules.json
{"id":"STATIC-HEADERS-001","severity":"MEDIUM","cvss_v4":5.3,"category":"static-sites","subcategory":"headers","title":"Missing security headers in static hosting configuration","description":"Static site hosting configuration lacks essential security headers (X-Content-Type-Options, X-Frame-Options, Content-Security-Policy). Attackers can exploit missing headers for clickjacking, MIME sniffing, and XSS attacks.","detect":{"patterns":["\\[\\[headers\\]\\]","\"headers\"\\s*:","headers\\s*="],"negative_patterns":["X-Content-Type-Options","Content-Security-Policy","X-Frame-Options"],"file_types":["netlify.toml","vercel.json","_headers","*.toml"],"exclude":["node_modules","dist"]},"remediation":{"description":"Configure security headers in your hosting platform's configuration file.","code_example":"# netlify.toml\n[[headers]]\n  for = \"/*\"\n  [headers.values]\n    X-Frame-Options = \"DENY\"\n    X-Content-Type-Options = \"nosniff\"\n    Content-Security-Policy = \"default-src 'self'\"","references":["https://cheatsheetseries.owasp.org/cheatsheets/HTTP_Headers_Cheat_Sheet.html"]},"standards":["CWE-693","OWASP-A05:2025"],"ai_specific":false,"frameworks":["netlify","vercel","cloudflare-pages"]}
{"id":"STATIC-SRI-001","severity":"MEDIUM","cvss_v4":6.1,"category":"static-sites","subcategory":"integrity","title":"External scripts loaded without Subresource Integrity (SRI)","description":"HTML pages load scripts or stylesheets from CDNs without integrity attributes. If the CDN is compromised, malicious code can be injected into the site.","detect":{"patterns":["<script\\s+src\\s*=\\s*['\"]https?://","<link\\s+.*href\\s*=\\s*['\"]https?://.*stylesheet"],"negative_patterns":["integrity\\s*=","crossorigin"],"file_types":["*.html","*.htm","*.ejs","*.hbs"],"exclude":["node_modules","dist"]},"remediation":{"description":"Add integrity and crossorigin attributes to all external script and link tags.","code_example":"<script src=\"https://cdn.example.com/lib.js\" integrity=\"sha384-...\" crossorigin=\"anonymous\"></script>","references":["https://developer.mozilla.org/en-US/docs/Web/Security/Subresource_Integrity"]},"standards":["CWE-353","OWASP-A08:2025"],"ai_specific":false,"frameworks":["netlify","vercel","github-pages"]}
FILE ../../knowledge-base/domains/supply-chain/rules.json
{"id":"SC-VULN-001","severity":"HIGH","cvss_v4":8.6,"category":"supply-chain","subcategory":"vulnerable-dependencies","title":"Known vulnerable dependency in use","description":"A project dependency has known CVEs in the installed version. Attackers can exploit published vulnerabilities to compromise the application.","detect":{"patterns":["\"dependencies\"\\s*:","\"devDependencies\"\\s*:","install_requires\\s*=","\\[dependencies\\]"],"negative_patterns":["npm audit","safety check","snyk test"],"file_types":["package.json","requirements.txt","setup.py","Cargo.toml","go.mod","Gemfile"],"exclude":["node_modules","dist"]},"remediation":{"description":"Run dependency audit tools regularly (npm audit, pip-audit, cargo audit). Update vulnerable packages to patched versions. Use automated dependency update tools like Dependabot or Renovate.","code_example":"# npm\nnpm audit fix\n# Python\npip-audit\n# Rust\ncargo audit","references":["https://owasp.org/www-project-dependency-check/"]},"standards":["CWE-1104","OWASP-A06:2025"],"ai_specific":false,"frameworks":[]}
{"id":"SC-HUSKY-001","severity":"HIGH","cvss_v4":7.8,"category":"supply-chain","subcategory":"git-hook-manipulation","title":"Git hook manipulation or .husky directory tampering","description":"Git hooks (.husky/, .git/hooks/) are modified or contain suspicious commands. Attackers can inject malicious code into pre-commit, pre-push, or post-checkout hooks to execute arbitrary commands on every git operation. Claude Code v2.1.90 added .husky to protected directories, recognizing this as a supply-chain attack vector.","detect":{"patterns":["(?:pre-commit|pre-push|post-checkout|post-merge).*(?:curl|wget|nc |bash -c|eval|base64)","\\.husky/.*(?:rm |chmod|chown|curl|wget|python|node -e)","core\\.hooksPath\\s*=","git\\s+config\\s+core\\.hooksPath","\\$\\(.*\\).*>.*\\.husky/","echo.*>.*\\.git/hooks/"],"negative_patterns":["npx husky install","npx --yes husky","lint-staged","commitlint","prettier --write"],"file_types":["*.sh","*.yaml","*.yml","Makefile","Dockerfile",".husky/*","package.json"],"exclude":["node_modules","dist"]},"remediation":{"description":"Review all git hooks for suspicious commands. Use husky from npm with verified scripts only. Monitor .husky/ directory changes in CI. Never redirect untrusted content to git hook files. Consider using core.hooksPath only with a reviewed, committed hooks directory.","code_example":"# Audit existing hooks\nfind .husky .git/hooks -type f -exec grep -l 'curl\\|wget\\|eval\\|base64' {} \\;\n\n# Safe husky setup\nnpx husky init\necho 'npx lint-staged' > .husky/pre-commit","references":["https://typicode.github.io/husky/","https://owasp.org/www-project-developer-guide/draft/design/web_app_checklist/","https://github.com/anthropics/claude-code/releases/tag/v2.1.90"]},"standards":["CWE-506","CWE-829","CWE-94"],"ai_specific":false,"frameworks":[]}
