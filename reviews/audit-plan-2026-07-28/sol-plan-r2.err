    53	
    54	def api_request(url, method="GET", data=None, headers=None, timeout=30):
    55	    """Thin wrapper kept for call-site compatibility — delegates to lib.http_client."""
    56	    return _http_api_request(
    57	        url,
    58	        method=method,
    59	        data=data,
    60	        headers=headers,
    61	        timeout=timeout,
    62	        user_agent="Sentinel-CVE-Sync/1.0",
    63	    )
    64	
    65	
    66	# ---------------------------------------------------------------------------
    67	# NVD API 2.0
    68	# ---------------------------------------------------------------------------
    69	def sync_nvd(config, start_date, dry_run=False):
    70	    """Fetch CVEs from NVD API 2.0."""
    71	    source = config["sync_sources"]["nvd"]
    72	    if not source.get("enabled"):
    73	        print("  NVD: disabled, skipping")
    74	        return 0
    75	
    76	    api_url = source["api_url"]
    77	    rate_limit = source.get("rate_limit_ms", 6000) / 1000.0
    78	
    79	    # Use API key if available (higher rate limit)
    80	    headers = {}
    81	    api_key = os.environ.get("NVD_API_KEY")
    82	    if api_key:
    83	        headers["apiKey"] = api_key
    84	        rate_limit = 0.6  # 50 req/30s with key
    85	        print("  NVD: using API key (higher rate limit)")
    86	
    87	    end_date = datetime.now(timezone.utc)
    88	    # URL-encode the '+' as '%2B' — NVD API rejects bare '+' (interprets as space → 404)
    89	    start_str = start_date.strftime("%Y-%m-%dT%H:%M:%S.000") + "%2B00:00"
    90	    end_str = end_date.strftime("%Y-%m-%dT%H:%M:%S.000") + "%2B00:00"
    91	
    92	    cache = load_cache("nvd-cache.json")
    93	    existing_vulns = {v["cve_id"]: v for v in cache.get("vulnerabilities", [])}
    94	    added = 0
    95	    updated = 0
    96	    start_index = 0
    97	    results_per_page = 100
    98	
    99	    while True:
   100	        url = (
   101	            f"{api_url}"
   102	            f"?lastModStartDate={start_str}"
   103	            f"&lastModEndDate={end_str}"
   104	            f"&startIndex={start_index}"
   105	            f"&resultsPerPage={results_per_page}"
   106	        )
   107	        print(f"  NVD: fetching from index {start_index}...")
   108	
   109	        if dry_run:
   110	            print(f"  NVD: [dry-run] would fetch {url}")
   111	            break
   112	
   113	        resp = api_request(url, headers=headers)
   114	        if resp is None:
   115	            print("  NVD: API error, stopping NVD sync")
   116	            break
   117	
   118	        vulnerabilities = resp.get("vulnerabilities", [])
   119	        total_results = resp.get("totalResults", 0)
   120	
   121	        for item in vulnerabilities:
   122	            cve = item.get("cve", {})
   123	            cve_id = cve.get("id", "")
   124	            if not cve_id:
   125	                continue
   126	
   127	            # Extract CVSS v4 or v3.1 score
   128	            metrics = cve.get("metrics", {})
   129	            cvss_score = None
   130	            for version in ["cvssMetricV40", "cvssMetricV31", "cvssMetricV30"]:
   131	                if version in metrics and metrics[version]:
   132	                    cvss_data = metrics[version][0].get("cvssData", {})
   133	                    cvss_score = cvss_data.get("baseScore")
   134	                    break
   135	
   136	            # Extract CWE
   137	            cwes = []
   138	            for weakness in cve.get("weaknesses", []):
   139	                for desc in weakness.get("description", []):
   140	                    if desc.get("value", "").startswith("CWE-"):
   141	                        cwes.append(desc["value"])
   142	
   143	            # Extract description
   144	            description = ""
   145	            for desc in cve.get("descriptions", []):
   146	                if desc.get("lang") == "en":
   147	                    description = desc.get("value", "")
   148	                    break
   149	
   150	            entry = {
   151	                "cve_id": cve_id,
   152	                "description": description,
   153	                "cvss_score": cvss_score,
   154	                "cwes": cwes,
   155	                "published": cve.get("published"),
   156	                "last_modified": cve.get("lastModified"),
   157	                "source": "nvd",
   158	            }
   159	
   160	            if cve_id in existing_vulns:
   161	                existing_vulns[cve_id] = entry
   162	                updated += 1
   163	            else:
   164	                existing_vulns[cve_id] = entry
   165	                added += 1
   166	
   167	        if start_index + results_per_page >= total_results:
   168	            break
   169	        start_index += results_per_page
   170	        time.sleep(rate_limit)
   171	
   172	    if not dry_run:
   173	        cache["vulnerabilities"] = list(existing_vulns.values())
   174	        cache["last_modified"] = datetime.now(timezone.utc).isoformat()
   175	        save_cache("nvd-cache.json", cache)
   176	
   177	    print(f"  NVD: +{added} new, ~{updated} updated")
   178	    return added + updated
   179	
