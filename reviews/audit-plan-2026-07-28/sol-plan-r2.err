FILE scripts/rule-tester.py
     1	#!/usr/bin/env python3
     2	"""
     3	Sentinel Rule Tester — validates LLM-generated detection patterns.
     4	
     5	Tests untested CVE rules against a corpus of known-vulnerable and known-safe
     6	code fixtures. Rules passing the precision gate (>=70%) are promoted to "active".
     7	
     8	Usage:
     9	    python3 scripts/rule-tester.py                  # Test all untested rules
    10	    python3 scripts/rule-tester.py --domain api     # Test one domain
    11	    python3 scripts/rule-tester.py --dry-run        # Preview without status changes
    12	    python3 scripts/rule-tester.py --verbose         # Show match details
    13	    python3 scripts/rule-tester.py --precision 0.8   # Custom precision gate
    14	"""
    15	from __future__ import annotations
    16	
    17	
    18	import argparse
    19	import glob
    20	import json
    21	import os
    22	import re
    23	import signal
    24	import sys
    25	import time
    26	from datetime import datetime, timezone
    27	from pathlib import Path
    28	
    29	SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
    30	PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
    31	KB_DIR = os.path.join(PROJECT_ROOT, "knowledge-base")
    32	DOMAINS_DIR = os.path.join(KB_DIR, "domains")
    33	FIXTURES_DIR = os.path.join(PROJECT_ROOT, "tests", "fixtures")
    34	VULN_APP_DIR = os.path.join(PROJECT_ROOT, "tests", "vulnerable-app", "src")
    35	
    36	DEFAULT_PRECISION_GATE = 0.70
    37	BACKTRACK_TIMEOUT_S = 2.0  # Max seconds for a single regex test
    38	
    39	
    40	# ---------------------------------------------------------------------------
    41	# Corpus loading
    42	# ---------------------------------------------------------------------------
    43	
    44	def load_files_from_dir(directory):
    45	    """Load all source files from a directory tree."""
    46	    files = []
    47	    if not os.path.isdir(directory):
    48	        return files
    49	    for root, _, filenames in os.walk(directory):
    50	        for fname in filenames:
    51	            fpath = os.path.join(root, fname)
    52	            try:
    53	                with open(fpath, encoding="utf-8", errors="replace") as f:
    54	                    content = f.read()
    55	                files.append({
    56	                    "path": fpath,
    57	                    "filename": fname,
    58	                    "content": content,
    59	                    "lines": content.splitlines(),
    60	                })
    61	            except IOError:
    62	                pass
    63	    return files
    64	
    65	
    66	def load_corpus():
    67	    """Load the full test corpus: vulnerable + safe files."""
    68	    vulnerable = load_files_from_dir(os.path.join(FIXTURES_DIR, "vulnerable"))
    69	    vulnerable += load_files_from_dir(VULN_APP_DIR)
    70	    safe = load_files_from_dir(os.path.join(FIXTURES_DIR, "safe"))
    71	    return {"vulnerable": vulnerable, "safe": safe}
    72	
    73	
    74	# ---------------------------------------------------------------------------
    75	# Rule loading
    76	# ---------------------------------------------------------------------------
    77	
    78	def load_untested_rules(domain_filter=None):
    79	    """Load all CVE rules with status='untested'."""
    80	    rules = []
    81	    pattern = os.path.join(DOMAINS_DIR, domain_filter or "*", "cve-rules.json")
    82	    for path in sorted(glob.glob(pattern)):
    83	        domain = os.path.basename(os.path.dirname(path))
    84	        with open(path) as f:
    85	            domain_rules = json.load(f)
    86	        for r in domain_rules:
    87	            if r.get("status") == "untested":
    88	                r["_source_path"] = path
    89	                r["_domain"] = domain
    90	                rules.append(r)
    91	    return rules
    92	
    93	
    94	# ---------------------------------------------------------------------------
    95	# Pattern validation
    96	# ---------------------------------------------------------------------------
    97	
    98	def validate_pattern(pattern_str):
    99	    """Validate a regex pattern: compilation and backtracking safety."""
   100	    # Compile check
   101	    try:
   102	        compiled = re.compile(pattern_str)
   103	    except re.error as e:
   104	        return {"valid": False, "error": f"compile: {e}"}
   105	
   106	    # Backtracking check with adversarial inputs
   107	    adversarial_inputs = [
   108	        "a" * 200,
   109	        "a" * 100 + "!" * 100,
   110	        " " * 200,
   111	        "x" * 50 + "\n" * 50 + "y" * 50,
   112	        "aaaa@aaaa.aaaa.aaaa.aaaa.aaaa.aaaa",
   113	    ]
   114	
   115	    for test_input in adversarial_inputs:
   116	        start = time.time()
   117	        try:
   118	            compiled.search(test_input)
   119	        except Exception:
   120	            pass
   121	        elapsed = time.time() - start
   122	        if elapsed > BACKTRACK_TIMEOUT_S:
   123	            return {"valid": False, "error": f"backtracking ({elapsed:.1f}s)"}
   124	
   125	    return {"valid": True, "compiled": compiled}
   126	
   127	
   128	# ---------------------------------------------------------------------------
   129	# File type matching
   130	# ---------------------------------------------------------------------------
   131	
   132	def file_matches_types(filename, file_types):
   133	    """Check if filename matches any of the rule's file_types globs."""
   134	    if not file_types:
   135	        return True  # No filter = match all source files
   136	
   137	    for ft in file_types:
   138	        if ft.startswith("*."):
   139	            ext = ft[1:]  # .js, .py, etc.
   140	            if filename.endswith(ext):
   141	                return True
   142	        elif ft == filename:
   143	            return True
   144	    return False
   145	
   146	
   147	# ---------------------------------------------------------------------------
   148	# Pattern matching engine
   149	# ---------------------------------------------------------------------------
   150	
   151	def scan_file(file_info, patterns, negative_patterns, file_types):
   152	    """Scan a single file with a rule's patterns. Returns list of matches."""
   153	    if not file_matches_types(file_info["filename"], file_types):
   154	        return []
   155	
   156	    matches = []
   157	    for line_num, line in enumerate(file_info["lines"], 1):
   158	        for pattern in patterns:
   159	            try:
   160	                if re.search(pattern, line):
   161	                    # Check negative patterns (mitigations)
   162	                    mitigated = False
   163	                    for neg in negative_patterns:
   164	                        try:
   165	                            if re.search(neg, line):
   166	                                mitigated = True
   167	                                break
   168	                        except re.error:
   169	                            pass
   170	
   171	                    if not mitigated:
   172	                        matches.append({
   173	                            "file": file_info["filename"],
   174	                            "line": line_num,
   175	                            "pattern": pattern,
   176	                            "text": line.strip()[:120],
   177	                        })
   178	            except re.error:
   179	                pass
   180	
   181	    return matches
   182	
   183	
   184	def run_rule_against_corpus(rule, corpus_files):
   185	    """Run a rule's patterns against a list of files."""
   186	    patterns = rule.get("detect", {}).get("patterns", [])
   187	    negative_patterns = rule.get("detect", {}).get("negative_patterns", [])
   188	    file_types = rule.get("detect", {}).get("file_types", [])
   189	
   190	    all_matches = []
   191	    for file_info in corpus_files:
   192	        matches = scan_file(file_info, patterns, negative_patterns, file_types)
   193	        all_matches.extend(matches)
   194	
   195	    return all_matches
   196	
   197	
   198	# ---------------------------------------------------------------------------
   199	# Rule testing
   200	# ---------------------------------------------------------------------------
   201	
   202	def test_rule(rule, corpus, precision_gate=DEFAULT_PRECISION_GATE, verbose=False):
   203	    """Test a single rule. Returns a result dict with scores."""
   204	    rule_id = rule["id"]
   205	    patterns = rule.get("detect", {}).get("patterns", [])
   206	
   207	    result = {
   208	        "id": rule_id,
   209	        "domain": rule.get("_domain"),
   210	        "title": rule.get("title", "")[:60],
   211	        "confidence": rule.get("confidence", 0),
   212	        "pattern_count": len(patterns),
   213	        "patterns_valid": 0,
   214	        "patterns_invalid": [],
   215	        "tp_count": 0,
   216	        "fp_count": 0,
   217	        "tp_matches": [],
   218	        "fp_matches": [],
   219	        "precision": None,
   220	        "verdict": "inconclusive",
   221	    }
   222	
   223	    # Step 1: Validate patterns
   224	    valid_patterns = []
   225	    for p in patterns:
   226	        check = validate_pattern(p)
   227	        if check["valid"]:
   228	            result["patterns_valid"] += 1
   229	            valid_patterns.append(p)
   230	        else:
   231	            result["patterns_invalid"].append({"pattern": p, "error": check["error"]})
   232	
   233	    if result["patterns_valid"] == 0:
   234	        result["verdict"] = "invalid"
   235	        return result
   236	
   237	    # Step 2: True positives — matches in vulnerable corpus
   238	    tp_matches = run_rule_against_corpus(rule, corpus["vulnerable"])
   239	    result["tp_matches"] = tp_matches
   240	    result["tp_count"] = len(tp_matches)
   241	
   242	    # Step 3: False positives — matches in safe corpus
   243	    fp_matches = run_rule_against_corpus(rule, corpus["safe"])
   244	    result["fp_matches"] = fp_matches
   245	    result["fp_count"] = len(fp_matches)
   246	
   247	    # Step 4: Calculate precision
   248	    tp = result["tp_count"]
   249	    fp = result["fp_count"]
   250	
   251	    if tp + fp == 0:
   252	        result["verdict"] = "no-matches"
   253	        result["precision"] = None
   254	    elif tp == 0 and fp > 0:
   255	        result["precision"] = 0.0
   256	        result["verdict"] = "fp-only"
   257	    else:
   258	        result["precision"] = tp / (tp + fp)
   259	        result["verdict"] = "pass" if result["precision"] >= precision_gate else "fail"
   260	
   261	    if verbose:
   262	        if tp_matches:
   263	            print(f"    TP ({tp}):")
   264	            for m in tp_matches[:5]:
   265	                print(f"      {m['file']}:{m['line']} [{m['pattern'][:40]}] → {m['text'][:60]}")
   266	            if tp > 5:
   267	                print(f"      ... and {tp - 5} more")
   268	        if fp_matches:
   269	            print(f"    FP ({fp}):")
   270	            for m in fp_matches[:5]:
   271	                print(f"      {m['file']}:{m['line']} [{m['pattern'][:40]}] → {m['text'][:60]}")
   272	            if fp > 5:
   273	                print(f"      ... and {fp - 5} more")
   274	
   275	    return result
   276	
   277	
   278	# ---------------------------------------------------------------------------
   279	# Apply results to cve-rules.json
   280	# ---------------------------------------------------------------------------
   281	
   282	def apply_results(rules, test_results, precision_gate, dry_run=False):
   283	    """Update rule statuses in cve-rules.json files."""
   284	    now = datetime.now(timezone.utc).isoformat()
   285	    results_by_id = {r["id"]: r for r in test_results}
   286	    rules_by_id = {r["id"]: r for r in rules}
   287	    files_modified = set()
   288	
   289	    counts = {"active": 0, "needs-review": 0, "no-matches": 0, "invalid": 0}
   290	
   291	    for result in test_results:
   292	        verdict = result["verdict"]
   293	
   294	        if verdict == "pass":
   295	            new_status = "active"
   296	            counts["active"] += 1
   297	        elif verdict in ("fail", "fp-only"):
   298	            new_status = "needs-review"
   299	            counts["needs-review"] += 1
   300	        elif verdict == "no-matches":
   301	            new_status = "no-matches"
   302	            counts["no-matches"] += 1
   303	        elif verdict == "invalid":
   304	            new_status = "invalid"
   305	            counts["invalid"] += 1
   306	        else:
   307	            continue
   308	
   309	        rule = rules_by_id.get(result["id"])
   310	        if rule:
   311	            files_modified.add(rule["_source_path"])
   312	
   313	    if dry_run:
   314	        return counts
   315	
   316	    # Write changes
   317	    for path in files_modified:
   318	        with open(path) as f:
   319	            all_rules = json.load(f)
   320	
   321	        changed = False
   322	        for i, r in enumerate(all_rules):
   323	            if r["id"] not in results_by_id:
   324	                continue
   325	            result = results_by_id[r["id"]]
   326	            verdict = result["verdict"]
   327	
   328	            if verdict == "pass":
   329	                all_rules[i]["status"] = "active"
   330	            elif verdict in ("fail", "fp-only"):
   331	                all_rules[i]["status"] = "needs-review"
   332	            elif verdict == "no-matches":
   333	                all_rules[i]["status"] = "no-matches"
   334	            elif verdict == "invalid":
   335	                all_rules[i]["status"] = "invalid"
   336	            else:
   337	                continue
   338	
   339	            if result["precision"] is not None:
   340	                all_rules[i]["test_precision"] = round(result["precision"], 3)
   341	            all_rules[i]["tested_at"] = now
   342	            changed = True
   343	
   344	        if changed:
   345	            with open(path, "w") as f:
   346	                json.dump(all_rules, f, indent=2)
   347	                f.write("\n")
   348	            domain = os.path.basename(os.path.dirname(path))
   349	            n = sum(1 for r in test_results
   350	                    if rules_by_id.get(r["id"], {}).get("_source_path") == path)
   351	            print(f"  Updated {domain}/cve-rules.json: {n} rules")
   352	
   353	    return counts
   354	
   355	
   356	# ---------------------------------------------------------------------------
   357	# Report
   358	# ---------------------------------------------------------------------------
   359	
   360	def print_results_table(test_results):
   361	    """Print a summary table of test results."""
   362	    print(f"\n{'ID':24s} {'Domain':14s} {'Pats':>4s} {'TP':>4s} {'FP':>4s} {'Prec':>6s} {'Verdict':12s}")
   363	    print("-" * 76)
   364	
   365	    for r in sorted(test_results, key=lambda x: (
   366	        {"pass": 0, "fail": 1, "fp-only": 2, "no-matches": 3, "invalid": 4}.get(x["verdict"], 5),
   367	        -(x["precision"] or 0),
   368	    )):
   369	        prec_str = f"{r['precision']:.1%}" if r["precision"] is not None else "—"
   370	        verdict_icon = {
   371	            "pass": "PASS",
   372	            "fail": "FAIL",
   373	            "fp-only": "FP-ONLY",
   374	            "no-matches": "NO-MATCH",
   375	            "invalid": "INVALID",
   376	        }.get(r["verdict"], r["verdict"])
   377	
   378	        print(f"{r['id']:24s} {r['domain']:14s} {r['pattern_count']:4d} "
   379	              f"{r['tp_count']:4d} {r['fp_count']:4d} {prec_str:>6s} {verdict_icon:12s}")
   380	
   381	    # Invalid patterns detail
   382	    invalids = [r for r in test_results if r["patterns_invalid"]]
   383	    if invalids:
   384	        print(f"\n--- Invalid patterns ---")
   385	        for r in invalids:
   386	            for inv in r["patterns_invalid"]:
   387	                print(f"  {r['id']}: {inv['error']} — {inv['pattern'][:60]}")
   388	
   389	
   390	# ---------------------------------------------------------------------------
   391	# Main
   392	# ---------------------------------------------------------------------------
   393	
   394	def main():
   395	    parser = argparse.ArgumentParser(
   396	        description="Validate LLM-generated CVE detection patterns against test corpus")
   397	    parser.add_argument("--domain", type=str, default=None,
   398	                        help="Only test rules from this domain")
   399	    parser.add_argument("--precision", type=float, default=DEFAULT_PRECISION_GATE,
   400	                        help=f"Precision gate for promotion (default: {DEFAULT_PRECISION_GATE})")
   401	    parser.add_argument("--verbose", action="store_true",
   402	                        help="Show individual match details")
   403	    parser.add_argument("--dry-run", action="store_true",
   404	                        help="Preview results without updating rule statuses")
   405	    args = parser.parse_args()
   406	
   407	    precision_gate = args.precision
   408	
   409	    print("=" * 60)
   410	    print("Sentinel Rule Tester")
   411	    print("=" * 60)
   412	
   413	    # Load corpus
   414	    corpus = load_corpus()
   415	    print(f"\nCorpus loaded:")
   416	    print(f"  Vulnerable files: {len(corpus['vulnerable'])} "
   417	          f"({sum(len(f['lines']) for f in corpus['vulnerable'])} lines)")
   418	    print(f"  Safe files:       {len(corpus['safe'])} "
   419	          f"({sum(len(f['lines']) for f in corpus['safe'])} lines)")
   420	
   421	    # Load rules
   422	    rules = load_untested_rules(args.domain)
   423	    print(f"\nUntested rules: {len(rules)}")
   424	
   425	    if not rules:
   426	        print("No untested rules to validate. Done.")
   427	        return
   428	
   429	    # Domain breakdown
   430	    domain_counts = {}
   431	    for r in rules:
   432	        d = r.get("_domain", "unknown")
   433	        domain_counts[d] = domain_counts.get(d, 0) + 1
   434	    print(f"  By domain: {', '.join(f'{d}={c}' for d, c in sorted(domain_counts.items()))}")
   435	
   436	    # Test each rule
   437	    print(f"\nPrecision gate: {precision_gate:.0%}")
   438	    print(f"Testing...\n")
   439	
   440	    test_results = []
   441	    for i, rule in enumerate(rules):
   442	        label = f"[{i+1}/{len(rules)}]"
   443	        print(f"  {label} {rule['id']} ({rule.get('_domain')})...", end="", flush=True)
   444	        result = test_rule(rule, corpus, precision_gate=precision_gate, verbose=args.verbose)
   445	        test_results.append(result)
   446	
   447	        prec = f"{result['precision']:.0%}" if result['precision'] is not None else "—"
   448	        print(f" TP={result['tp_count']} FP={result['fp_count']} "
   449	              f"prec={prec} → {result['verdict']}")
   450	
   451	    # Results table
   452	    print_results_table(test_results)
   453	
   454	    # Summary
   455	    verdicts = {}
   456	    for r in test_results:
   457	        verdicts[r["verdict"]] = verdicts.get(r["verdict"], 0) + 1
   458	
   459	    print(f"\n{'=' * 60}")
   460	    print(f"Summary ({len(test_results)} rules tested):")
   461	    print(f"  PASS (→ active):      {verdicts.get('pass', 0)}")
   462	    print(f"  FAIL (→ needs-review): {verdicts.get('fail', 0)}")
   463	    print(f"  FP-ONLY (→ needs-review): {verdicts.get('fp-only', 0)}")
   464	    print(f"  NO-MATCH (→ no-matches): {verdicts.get('no-matches', 0)}")
   465	    print(f"  INVALID:              {verdicts.get('invalid', 0)}")
   466	
   467	    # Apply
   468	    if args.dry_run:
   469	        print(f"\n--- DRY RUN: no statuses updated ---")
   470	    else:
   471	        print(f"\n--- Applying results ---")
   472	        counts = apply_results(rules, test_results, precision_gate)
   473	        print(f"\nApplied: {counts['active']} active, "
   474	              f"{counts['needs-review']} needs-review, "
   475	              f"{counts['no-matches']} no-matches, "
   476	              f"{counts['invalid']} invalid")
   477	
   478	    # Next steps
   479	    promoted = verdicts.get("pass", 0)
   480	    if promoted > 0:
   481	        print(f"\nNext: run 'python3 rag/indexer.py' to re-index promoted rules")
   482	
   483	    print(f"{'=' * 60}")
   484	
   485	
   486	if __name__ == "__main__":
   487	    main()

FILE scripts/pattern-gen.py
     1	#!/usr/bin/env python3
     2	"""
     3	Sentinel Pattern Generator — LLM-powered detection pattern generation for CVE rules.
     4	
     5	Uses `claude -p` (pipe mode) to generate regex detection patterns for CVE rules
     6	that have empty detect.patterns[]. Runs through the user's Claude Max subscription
     7	— no API key needed.
     8	
     9	Usage:
    10	    python3 scripts/pattern-gen.py                  # Top 50 rules
    11	    python3 scripts/pattern-gen.py --limit 10        # Top 10 rules
    12	    python3 scripts/pattern-gen.py --dry-run         # Preview rules without calling Claude
    13	    python3 scripts/pattern-gen.py --domain web-app  # Only generate for one domain
    14	    python3 scripts/pattern-gen.py --workers 3       # Parallel workers (default: 1)
    15	"""
    16	from __future__ import annotations
    17	
    18	
    19	import argparse
    20	import glob
    21	import json
    22	import os
    23	import re
    24	import subprocess
    25	import sys
    26	from concurrent.futures import ThreadPoolExecutor, as_completed
    27	from datetime import datetime, timezone
    28	
    29	SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
    30	PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
    31	KB_DIR = os.path.join(PROJECT_ROOT, "knowledge-base")
    32	DOMAINS_DIR = os.path.join(KB_DIR, "domains")
    33	KEV_PATH = os.path.join(KB_DIR, "cve-feed", "kev-catalog.json")
    34	
    35	
    36	# ---------------------------------------------------------------------------
    37	# Reference examples — loaded from domain rules.json for few-shot prompting
    38	# ---------------------------------------------------------------------------
    39	
    40	def load_reference_rules(domain=None):
    41	    """Load curated domain rules with populated patterns as few-shot examples."""
    42	    examples = []
    43	    pattern = os.path.join(DOMAINS_DIR, domain or "*", "rules.json")
    44	    for path in sorted(glob.glob(pattern)):
    45	        with open(path) as f:
    46	            rules = json.load(f)
    47	        for r in rules:
    48	            detect = r.get("detect", {})
    49	            if detect.get("patterns"):
    50	                examples.append({
    51	                    "id": r["id"],
    52	                    "category": r.get("category", ""),
    53	                    "title": r.get("title", ""),
    54	                    "description": r.get("description", "")[:200],
    55	                    "cwe": [s for s in r.get("standards", []) if s.startswith("CWE-")],
    56	                    "detect": {
    57	                        "patterns": detect["patterns"][:3],
    58	                        "negative_patterns": detect.get("negative_patterns", [])[:3],
    59	                        "file_types": detect.get("file_types", []),
    60	                    },
    61	                })
    62	    return examples
    63	
    64	
    65	def pick_reference_examples(rule, all_examples, count=3):
    66	    """Pick the most relevant reference examples for a given CVE rule."""
    67	    domain = rule.get("category", "")
    68	    cwe_ids = set(s for s in rule.get("standards", []) if s.startswith("CWE-"))
    69	
    70	    scored = []
    71	    for ex in all_examples:
    72	        score = 0
    73	        if ex["category"] == domain:
    74	            score += 2
    75	        if cwe_ids & set(ex.get("cwe", [])):
    76	            score += 3
    77	        scored.append((score, ex))
    78	
    79	    scored.sort(key=lambda x: -x[0])
    80	    return [ex for _, ex in scored[:count]]
    81	
    82	
    83	# ---------------------------------------------------------------------------
    84	# CVE rule loading and prioritization
    85	# ---------------------------------------------------------------------------
    86	
    87	def load_kev_cve_ids():
    88	    """Load set of CVE IDs from the CISA KEV catalog."""
    89	    if not os.path.exists(KEV_PATH):
    90	        return set()
    91	    with open(KEV_PATH) as f:
    92	        data = json.load(f)
    93	    return {v["cve_id"] for v in data.get("vulnerabilities", [])}
    94	
    95	
    96	def load_empty_rules(domain_filter=None):
    97	    """Load all CVE rules with empty detect.patterns across all domains."""
    98	    rules = []
    99	    pattern = os.path.join(DOMAINS_DIR, domain_filter or "*", "cve-rules.json")
   100	    for path in sorted(glob.glob(pattern)):
   101	        domain = os.path.basename(os.path.dirname(path))
   102	        with open(path) as f:
   103	            domain_rules = json.load(f)
   104	        for r in domain_rules:
   105	            if not r.get("detect", {}).get("patterns"):
   106	                # Skip rules that were already LLM-generated
   107	                if r.get("generated_by") == "llm":
   108	                    continue
   109	                r["_source_path"] = path
   110	                r["_domain"] = domain
   111	                rules.append(r)
   112	    return rules
   113	
   114	
   115	def prioritize_rules(rules, kev_ids):
   116	    """Sort rules by priority: KEV > CVSS>=9 > CVSS>=7+EPSS>=0.5 > rest."""
   117	    def priority_key(r):
   118	        is_kev = r["id"] in kev_ids
   119	        cvss = r.get("cvss_v4") or 0
   120	        epss = r.get("epss_score") or 0
   121	        if is_kev:
   122	            return (0, -cvss)
   123	        if cvss >= 9.0:
   124	            return (1, -cvss)
   125	        if cvss >= 7.0 and epss >= 0.5:
   126	            return (2, -epss)
   127	        return (3, -cvss)
   128	
   129	    rules.sort(key=priority_key)
   130	    return rules
   131	
   132	
   133	def priority_label(rule, kev_ids):
   134	    """Human-readable priority label for a rule."""
   135	    if rule["id"] in kev_ids:
   136	        return "KEV"
   137	    cvss = rule.get("cvss_v4") or 0
   138	    epss = rule.get("epss_score") or 0
   139	    if cvss >= 9.0:
   140	        return f"CVSS {cvss}"
   141	    if cvss >= 7.0 and epss >= 0.5:
   142	        return f"CVSS {cvss} + EPSS {epss:.2f}"
   143	    return f"CVSS {cvss}"
   144	
   145	
   146	# ---------------------------------------------------------------------------
   147	# Prompt construction
   148	# ---------------------------------------------------------------------------
   149	
   150	SYSTEM_PROMPT = """\
   151	You are a security static analysis rule generator. Given a CVE description, you generate \
   152	regex detection patterns that identify vulnerable code patterns in source files.
   153	
   154	Rules:
   155	- Patterns are Python-compatible regex strings used with re.search() on source code lines
   156	- Patterns should be specific enough to detect the vulnerability class, not just the CVE product
   157	- Focus on the CWE (weakness class) to write general patterns, not product-specific strings
   158	- negative_patterns are strings/regexes that indicate the vulnerability is mitigated (e.g., sanitization functions)
   159	- file_types are glob patterns for files to scan (e.g., "*.js", "*.py", "*.go")
   160	- exclude lists directory names to skip during scanning
   161	- confidence: 1.0 = exact CVE pattern, 0.7 = CWE-class pattern, 0.4 = broad heuristic
   162	- If the CVE is too product-specific or infrastructure-only (no detectable code pattern), \
   163	set patterns to an empty array and confidence to 0.0
   164	
   165	Output ONLY valid JSON, no markdown fences, no explanation."""
   166	
   167	
   168	def build_user_prompt(rule, examples):
   169	    """Build the user prompt for a single CVE rule."""
   170	    cwe_list = ", ".join(s for s in rule.get("standards", []) if s.startswith("CWE-"))
   171	    epss_info = ""
   172	    if rule.get("epss_score"):
   173	        epss_info = f"\nEPSS Score: {rule['epss_score']:.4f} (exploit probability)"
   174	
   175	    examples_text = ""
   176	    if examples:
   177	        ex_items = []
   178	        for ex in examples:
   179	            ex_items.append(json.dumps({
   180	                "id": ex["id"],
   181	                "title": ex["title"],
   182	                "cwe": ex["cwe"],
   183	                "detect": ex["detect"],
   184	            }, indent=2))
   185	        examples_text = "\n\nReference patterns from the same domain (learn the style):\n" + \
   186	            "\n---\n".join(ex_items)
   187	
   188	    return f"""\
   189	Generate detection patterns for this CVE:
   190	
   191	CVE ID: {rule['id']}
   192	Severity: {rule.get('severity', 'UNKNOWN')} (CVSS {rule.get('cvss_v4', 'N/A')})
   193	Domain: {rule.get('category', 'unknown')}
   194	CWE: {cwe_list or 'Not specified'}
   195	Description: {rule.get('description', 'No description available')}{epss_info}
   196	{examples_text}
   197	
   198	Output JSON with this exact schema:
   199	{{
   200	  "patterns": ["regex1", "regex2"],
   201	  "file_types": ["*.ext"],
   202	  "negative_patterns": ["mitigationPattern1"],
   203	  "exclude": ["dir_to_skip"],
   204	  "confidence": 0.7
   205	}}"""
   206	
   207	
   208	# ---------------------------------------------------------------------------
   209	# Claude CLI — pipe mode execution
   210	# ---------------------------------------------------------------------------
   211	
   212	_ALLOWED_MODELS = frozenset({"opus", "sonnet", "haiku", "fable", "claude-fable-5"})
   213	
   214	
   215	def call_claude(prompt, system_prompt, model="sonnet"):
   216	    """Call claude CLI in pipe mode and return the raw text output."""
   217	    if model not in _ALLOWED_MODELS:
   218	        raise ValueError(
   219	            f"Invalid model {model!r}; allowed: {sorted(_ALLOWED_MODELS)}"
   220	        )
   221	    cmd = ["claude", "-p", "--output-format", "text", "--model", model]
   222	    if system_prompt:
   223	        cmd.extend(["--system-prompt", system_prompt])
   224	
   225	    full_prompt = prompt
   226	    try:
   227	        result = subprocess.run(
   228	            cmd,
   229	            input=full_prompt,
   230	            capture_output=True,
   231	            text=True,
   232	            timeout=120,
   233	        )
   234	        if result.returncode != 0:
   235	            stderr = result.stderr.strip()
   236	            if stderr:
   237	                print(f"  claude stderr: {stderr[:200]}", file=sys.stderr)
   238	            return None
   239	        return result.stdout.strip()
   240	    except subprocess.TimeoutExpired:
   241	        print("  claude: timeout (120s)", file=sys.stderr)
   242	        return None
   243	    except FileNotFoundError:
   244	        print("  ERROR: 'claude' CLI not found in PATH", file=sys.stderr)
   245	        sys.exit(1)
   246	
   247	
   248	def generate_one(rule, examples_db, model):
   249	    """Generate patterns for a single rule via claude -p."""
   250	    examples = pick_reference_examples(rule, examples_db)
   251	    user_prompt = build_user_prompt(rule, examples)
   252	    text = call_claude(user_prompt, SYSTEM_PROMPT, model=model)
   253	    if text:
   254	        parsed = parse_llm_output(text)
   255	        if parsed:
   256	            return (rule["id"], parsed)
   257	    return (rule["id"], None)
   258	
   259	
   260	def generate_patterns(rules, examples_db, model, workers=1):
   261	    """Generate patterns for all selected rules."""
   262	    results = {}
   263	
   264	    if workers <= 1:
   265	        # Sequential
   266	        for i, rule in enumerate(rules):
   267	            rid = rule["id"]
   268	            print(f"  [{i+1}/{len(rules)}] {rid} ({rule.get('category')})...",
   269	                  end="", flush=True)
   270	            _, parsed = generate_one(rule, examples_db, model)
   271	            if parsed:
   272	                results[rid] = parsed
   273	                n = len(parsed.get("patterns", []))
   274	                print(f" {n} patterns, conf={parsed.get('confidence', 0)}")
   275	            else:
   276	                print(" no result")
   277	    else:
   278	        # Parallel
   279	        with ThreadPoolExecutor(max_workers=workers) as pool:
   280	            futures = {
   281	                pool.submit(generate_one, rule, examples_db, model): rule
   282	                for rule in rules
   283	            }
   284	            done = 0
   285	            for future in as_completed(futures):
   286	                done += 1
   287	                rule = futures[future]
   288	                rid, parsed = future.result()
   289	                if parsed:
   290	                    results[rid] = parsed
   291	                    n = len(parsed.get("patterns", []))
   292	                    print(f"  [{done}/{len(rules)}] {rid}: "
   293	                          f"{n} patterns, conf={parsed.get('confidence', 0)}")
   294	                else:
   295	                    print(f"  [{done}/{len(rules)}] {rid}: no result")
   296	
   297	    return results
   298	
   299	
   300	# ---------------------------------------------------------------------------
   301	# Output parsing and validation
   302	# ---------------------------------------------------------------------------
   303	
   304	def parse_llm_output(text):
   305	    """Parse LLM output into a validated pattern dict."""
   306	    text = text.strip()
   307	
   308	    # Strip markdown code fences if present
   309	    if text.startswith("```"):
   310	        text = re.sub(r'^```(?:json)?\s*\n?', '', text)
   311	        text = re.sub(r'\n?```\s*$', '', text)
   312	
   313	    try:
   314	        data = json.loads(text)
   315	    except json.JSONDecodeError:
   316	        # Try to extract JSON from surrounding text
   317	        match = re.search(r'\{[^{}]*(?:\{[^{}]*\}[^{}]*)*\}', text, re.DOTALL)
   318	        if match:
   319	            try:
   320	                data = json.loads(match.group())
   321	            except json.JSONDecodeError:
   322	                return None
   323	        else:
   324	            return None
   325	
   326	    # Validate and normalize
   327	    patterns = data.get("patterns", [])
   328	    if not isinstance(patterns, list):
   329	        return None
   330	
   331	    # Validate regexes
   332	    valid_patterns = []
   333	    for p in patterns:
   334	        if not isinstance(p, str) or not p.strip():
   335	            continue
   336	        try:
   337	            re.compile(p)
   338	            valid_patterns.append(p)
   339	        except re.error:
   340	            pass  # Skip invalid regex
   341	
   342	    file_types = data.get("file_types", [])
   343	    if not isinstance(file_types, list):
   344	        file_types = []
   345	    file_types = [ft for ft in file_types if isinstance(ft, str) and ft.strip()]
   346	
   347	    negative_patterns = data.get("negative_patterns", [])
   348	    if not isinstance(negative_patterns, list):
   349	        negative_patterns = []
   350	    negative_patterns = [np for np in negative_patterns if isinstance(np, str) and np.strip()]
   351	
   352	    exclude = data.get("exclude", [])
   353	    if not isinstance(exclude, list):
   354	        exclude = []
   355	    exclude = [e for e in exclude if isinstance(e, str) and e.strip()]
   356	
   357	    confidence = data.get("confidence", 0.5)
   358	    if not isinstance(confidence, (int, float)):
   359	        confidence = 0.5
   360	    confidence = max(0.0, min(1.0, float(confidence)))
   361	
   362	    return {
   363	        "patterns": valid_patterns,
   364	        "file_types": file_types,
   365	        "negative_patterns": negative_patterns,
   366	        "exclude": exclude,
   367	        "confidence": confidence,
   368	    }
   369	
   370	
   371	# ---------------------------------------------------------------------------
   372	# Write results back to cve-rules.json files
   373	# ---------------------------------------------------------------------------
   374	
   375	def apply_results(rules, results):
   376	    """Write generated patterns back to their source cve-rules.json files."""
   377	    now = datetime.now(timezone.utc).isoformat()
   378	    files_to_update = {}
   379	
   380	    # Index selected rules by ID for quick lookup
   381	    rules_by_id = {r["id"]: r for r in rules}
   382	
   383	    updated = 0
   384	    skipped = 0
   385	
   386	    for rule_id, generated in results.items():
   387	        if rule_id not in rules_by_id:
   388	            continue
   389	        rule = rules_by_id[rule_id]
   390	        source_path = rule["_source_path"]
   391	
   392	        # Skip if LLM returned no patterns (product-specific CVE)
   393	        if not generated["patterns"]:
   394	            skipped += 1
   395	            continue
   396	
   397	        # Mark for update
   398	        rule["detect"]["patterns"] = generated["patterns"]
   399	        rule["detect"]["file_types"] = generated["file_types"]
   400	        if generated["negative_patterns"]:
   401	            rule["detect"]["negative_patterns"] = generated["negative_patterns"]
   402	        if generated["exclude"]:
   403	            rule["detect"]["exclude"] = generated["exclude"]
   404	        rule["confidence"] = generated["confidence"]
   405	        rule["generated_by"] = "llm"
   406	        rule["generated_at"] = now
   407	        rule["status"] = "untested"
   408	
   409	        files_to_update[source_path] = True
   410	        updated += 1
   411	
   412	    # Write back to each modified file
   413	    for path in files_to_update:
   414	        with open(path) as f:
   415	            all_rules = json.load(f)
   416	
   417	        # Apply updates by matching rule ID
   418	        for i, r in enumerate(all_rules):
   419	            if r["id"] in results and r["id"] in rules_by_id:
   420	                rule = rules_by_id[r["id"]]
   421	                for key in ("detect", "confidence", "generated_by", "generated_at", "status"):
   422	                    if key in rule:
   423	                        all_rules[i][key] = rule[key]
   424	
   425	        with open(path, "w") as f:
   426	            json.dump(all_rules, f, indent=2)
   427	            f.write("\n")
   428	
   429	        domain = os.path.basename(os.path.dirname(path))
   430	        count = sum(1 for rid in results if rules_by_id.get(rid, {}).get("_source_path") == path
   431	                    and results[rid].get("patterns"))
   432	        print(f"  Updated {path.split('domains/')[-1]}: {count} rules")
   433	
   434	    return updated, skipped
   435	
   436	
   437	# ---------------------------------------------------------------------------
   438	# Main
   439	# ---------------------------------------------------------------------------
   440	
   441	def main():
   442	    parser = argparse.ArgumentParser(
   443	        description="Generate detection patterns for CVE rules using Claude CLI (Max subscription)")
   444	    parser.add_argument("--limit", type=int, default=50,
   445	                        help="Max rules to process per run (default: 50)")
   446	    parser.add_argument("--domain", type=str, default=None,
   447	                        help="Only process rules from this domain")
   448	    parser.add_argument("--model", type=str, default="sonnet",
   449	                        help="Claude model to use: sonnet, opus, haiku, fable, claude-fable-5 (default: sonnet)")
   450	    parser.add_argument("--workers", type=int, default=1,
   451	                        help="Parallel claude processes (default: 1)")
   452	    parser.add_argument("--dry-run", action="store_true",
   453	                        help="Preview selected rules without calling Claude")
   454	    args = parser.parse_args()
   455	
   456	    print("=" * 60)
   457	    print("Sentinel Pattern Generator (claude -p, Max subscription)")
   458	    print("=" * 60)
   459	
   460	    # Load KEV catalog for prioritization
   461	    kev_ids = load_kev_cve_ids()
   462	    print(f"\nKEV catalog: {len(kev_ids)} actively exploited CVEs")
   463	
   464	    # Load reference rules for few-shot prompting
   465	    ref_examples = load_reference_rules(args.domain)
   466	    print(f"Reference rules loaded: {len(ref_examples)} examples")
   467	
   468	    # Load and prioritize empty CVE rules
   469	    empty_rules = load_empty_rules(args.domain)
   470	    print(f"Empty CVE rules found: {len(empty_rules)}")
   471	
   472	    if not empty_rules:
   473	        print("\nNo empty CVE rules to process. Done.")
   474	        return
   475	
   476	    prioritized = prioritize_rules(empty_rules, kev_ids)
   477	    selected = prioritized[:args.limit]
   478	
   479	    # Count by priority tier
   480	    kev_count = sum(1 for r in selected if r["id"] in kev_ids)
   481	    crit_count = sum(1 for r in selected if r["id"] not in kev_ids
   482	                     and (r.get("cvss_v4") or 0) >= 9.0)
   483	    high_epss = sum(1 for r in selected if r["id"] not in kev_ids
   484	                    and (r.get("cvss_v4") or 0) >= 7.0 and (r.get("cvss_v4") or 0) < 9.0
   485	                    and (r.get("epss_score") or 0) >= 0.5)
   486	    rest = len(selected) - kev_count - crit_count - high_epss
   487	
   488	    print(f"\nSelected {len(selected)} rules (limit={args.limit}):")
   489	    print(f"  KEV (actively exploited): {kev_count}")
   490	    print(f"  CVSS >= 9.0 (critical):   {crit_count}")
   491	    print(f"  CVSS >= 7.0 + EPSS >= 0.5: {high_epss}")
   492	    print(f"  Other:                     {rest}")
   493	
   494	    # Domain breakdown
   495	    domain_counts = {}
   496	    for r in selected:
   497	        d = r.get("_domain", "unknown")
   498	        domain_counts[d] = domain_counts.get(d, 0) + 1
   499	    print(f"\n  By domain: {', '.join(f'{d}={c}' for d, c in sorted(domain_counts.items()))}")
   500	
   501	    if args.dry_run:
   502	        print(f"\n--- DRY RUN: Top {min(10, len(selected))} rules ---")
   503	        for r in selected[:10]:
   504	            label = priority_label(r, kev_ids)
   505	            cwe = ", ".join(s for s in r.get("standards", []) if s.startswith("CWE-"))
   506	            print(f"  {r['id']:20s} | {r.get('severity', '?'):8s} | {label:20s} | {cwe:15s} | {r.get('_domain', '?')}")
   507	        if len(selected) > 10:
   508	            print(f"  ... and {len(selected) - 10} more")
   509	
   510	        # Show sample prompt
   511	        sample = selected[0]
   512	        sample_examples = pick_reference_examples(sample, ref_examples)
   513	        print(f"\n--- Sample prompt for {sample['id']} ---")
   514	        print(f"System: {SYSTEM_PROMPT[:200]}...")
   515	        print(f"\nUser:\n{build_user_prompt(sample, sample_examples)[:600]}...")
   516	        print(f"\n--- End dry run ---")
   517	        return
   518	
   519	    # Generate patterns
   520	    print(f"\nModel: {args.model} | Workers: {args.workers}")
   521	    print(f"Running via: claude -p (Max subscription)\n")
   522	
   523	    results = generate_patterns(selected, ref_examples, args.model, args.workers)
   524	
   525	    if not results:
   526	        print("\nNo results generated. Check 'claude -p' works in your terminal.")
   527	        sys.exit(1)
   528	
   529	    # Apply results
   530	    print(f"\n--- Applying {len(results)} results ---")
   531	    updated, skipped = apply_results(selected, results)
   532	
   533	    # Summary
   534	    print(f"\n{'=' * 60}")
   535	    print(f"Summary:")
   536	    print(f"  Rules processed:  {len(selected)}")
   537	    print(f"  Patterns generated: {len(results)}")
   538	    print(f"  Rules updated:    {updated}")
   539	    print(f"  Skipped (no code pattern): {skipped}")
   540	    print(f"  Errors:           {len(selected) - len(results)}")
   541	    remaining = len(empty_rules) - updated
   542	    print(f"  Remaining empty:  {remaining}")
   543	    print(f"{'=' * 60}")
   544	
   545	    if updated > 0:
   546	        print(f"\nNext: run 'python3 scripts/rule-tester.py' to validate generated patterns")
   547	        print(f"Then: run 'python3 rag/indexer.py' to re-index the KB")
   548	
   549	
   550	if __name__ == "__main__":
   551	    main()

FILE scripts/cve-sync.py
     1	#!/usr/bin/env python3
     2	"""
     3	Sentinel CVE Sync — Synchronizes CVE data from NVD, OSV, GitHub Advisories, and EPSS.
     4	
     5	Usage:
     6	    python3 scripts/cve-sync.py              # Full sync (30 days on first run, since last_sync after)
     7	    python3 scripts/cve-sync.py --dry-run     # Preview without writing
     8	    python3 scripts/cve-sync.py --days 7      # Limit to last 7 days
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import argparse
    14	import json
    15	import os
    16	import sys
    17	import time
    18	from datetime import datetime, timedelta, timezone
    19	
    20	SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
    21	sys.path.insert(0, SCRIPT_DIR)
    22	from lib.http_client import api_request as _http_api_request  # noqa: E402
    23	
    24	PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
    25	CVE_FEED_DIR = os.path.join(PROJECT_ROOT, "knowledge-base", "cve-feed")
    26	STANDARDS_DIR = os.path.join(PROJECT_ROOT, "knowledge-base", "standards")
    27	CONFIG_PATH = os.path.join(CVE_FEED_DIR, "sync-config.json")
