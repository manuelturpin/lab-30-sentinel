jq -r '.synthese, \"\\nFINDINGS\", (.findings[] | \"[\\(.gravite)] \\(.territoire): \\(.resume)\\nCITATION: \\(.citation)\\nCONS: \\(.consequence_decisionnelle)\\n\")' fable5-plan-verdict-r1.json
