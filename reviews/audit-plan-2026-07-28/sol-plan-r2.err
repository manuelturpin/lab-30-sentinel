    96	def load_empty_rules(domain_filter=None):
    97	    """Load all CVE rules with empty detect.patterns across all domains."""
    98	    rules = []
    99	    pattern = os.path.join(DOMAINS_DIR, domain_filter or "*", "cve-rules.json")
   100	    for path in sorted(glob.glob(pattern)):
   101	        domain = os.path.basename(os.path.dirname(path))
   102	        with open(path) as f:
   103	            domain_rules = json.load(f)
   104	        for r in domain_rules:
   105	            if not r.get("detect", {}).get("patterns"):
   106	                # Skip rules that were already LLM-generated
   107	                if r.get("generated_by") == "llm":
   108	                    continue
   109	                r["_source_path"] = path
   110	                r["_domain"] = domain
   111	                rules.append(r)
   112	    return rules
