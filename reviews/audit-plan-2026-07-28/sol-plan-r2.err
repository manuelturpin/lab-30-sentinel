   181	# ---------------------------------------------------------------------------
   182	# OSV API
   183	# ---------------------------------------------------------------------------
   184	def _process_osv_vuln(vuln, existing_vulns):
   185	    """Process a single OSV vulnerability and add to existing_vulns. Returns 1 if added, 0 if skipped."""
   186	    vuln_id = vuln.get("id", "")
   187	    if not vuln_id or vuln_id in existing_vulns:
   188	        return 0
   189	
   190	    # Extract severity
   191	    severity_score = None
   192	    for sev in vuln.get("severity", []):
   193	        if sev.get("type") == "CVSS_V3":
   194	            severity_score = sev.get("score", "")
   195	
   196	    # Extract affected packages
   197	    affected_packages = []
   198	    for affected in vuln.get("affected", []):
   199	        pkg = affected.get("package", {})
   200	        affected_packages.append({
   201	            "name": pkg.get("name", ""),
   202	            "ecosystem": pkg.get("ecosystem", ""),
   203	            "versions": [
   204	                r.get("events", [{}])[0].get("introduced", "")
   205	                for r in affected.get("ranges", [])
   206	            ],
   207	        })
   208	
   209	    entry = {
   210	        "id": vuln_id,
   211	        "summary": vuln.get("summary", ""),
   212	        "details": vuln.get("details", "")[:500],
   213	        "severity": severity_score,
   214	        "affected_packages": affected_packages,
   215	        "published": vuln.get("published"),
   216	        "modified": vuln.get("modified"),
   217	        "aliases": vuln.get("aliases", []),
   218	        "source": "osv",
   219	    }
   220	    existing_vulns[vuln_id] = entry
   221	    return 1
   222	
   223	
   224	def sync_osv(config, start_date, dry_run=False):
   225	    """Fetch vulnerabilities from OSV API by querying popular ecosystems.
   226	
   227	    OSV /v1/query supports querying by ecosystem with a package name, or by
   228	    commit hash. To get broad coverage, we query popular ecosystems using
   229	    /v1/querybatch with well-known packages, and also fetch recent vulns
   230	    by querying popular packages from our NVD cache descriptions.
   231	    """
   232	    source = config["sync_sources"]["osv"]
   233	    if not source.get("enabled"):
   234	        print("  OSV: disabled, skipping")
   235	        return 0
   236	
   237	    api_url = source["api_url"]
   238	
   239	    cache = load_cache("osv-cache.json")
   240	    existing_vulns = {v["id"]: v for v in cache.get("vulnerabilities", [])}
   241	    added = 0
   242	
   243	    # Popular packages to query across ecosystems for broad CVE coverage
   244	    ecosystem_packages = [
   245	        ("npm", ["express", "lodash", "axios", "jsonwebtoken", "webpack",
   246	                  "react", "next", "dotenv", "mongoose", "cors", "body-parser",
   247	                  "cookie-parser", "helmet", "passport", "bcrypt", "sequelize",
   248	                  "pg", "mysql2", "redis", "socket.io", "nodemailer",
   249	                  "multer", "sharp", "cheerio", "handlebars", "ejs", "pug",
   250	                  "marked", "minimist", "qs", "tar", "node-fetch", "got",
   251	                  "underscore", "moment", "debug", "semver", "glob",
   252	                  "cross-spawn", "xml2js", "yaml", "fast-xml-parser"]),
   253	        ("PyPI", ["django", "flask", "requests", "numpy", "pandas",
   254	                   "pillow", "sqlalchemy", "jinja2", "cryptography",
   255	                   "pyyaml", "urllib3", "paramiko", "setuptools", "pip",
   256	                   "celery", "gunicorn", "boto3", "aiohttp", "fastapi",
   257	                   "werkzeug", "tornado", "scrapy", "lxml", "pydantic",
   258	                   "httpx", "starlette", "uvicorn", "black", "ruff"]),
   259	        ("Go", ["stdlib", "github.com/gin-gonic/gin",
   260	                 "github.com/gorilla/mux", "github.com/gorilla/websocket",
   261	                 "golang.org/x/crypto", "golang.org/x/net",
   262	                 "golang.org/x/text", "github.com/dgrijalva/jwt-go",
   263	                 "google.golang.org/grpc", "github.com/go-sql-driver/mysql"]),
   264	        ("RubyGems", ["rails", "rack", "nokogiri", "devise", "puma",
   265	                       "sidekiq", "activerecord", "actionpack"]),
   266	        ("crates.io", ["hyper", "tokio", "serde", "reqwest", "actix-web",
   267	                        "openssl", "rustls", "ring"]),
   268	        ("Maven", ["org.apache.logging.log4j:log4j-core",
   269	                    "org.springframework:spring-core",
   270	                    "com.fasterxml.jackson.core:jackson-databind",
   271	                    "org.apache.commons:commons-text",
   272	                    "org.apache.struts:struts2-core"]),
   273	    ]
   274	
   275	    # Build querybatch queries
   276	    all_queries = []
   277	    for ecosystem, packages in ecosystem_packages:
   278	        for pkg_name in packages:
   279	            all_queries.append({
   280	                "package": {"name": pkg_name, "ecosystem": ecosystem}
   281	            })
   282	
   283	    total_queries = len(all_queries)
   284	    batch_size = 1000  # OSV querybatch max
   285	    total_batches = (total_queries + batch_size - 1) // batch_size
   286	
   287	    print(f"  OSV: querying {total_queries} packages across {len(ecosystem_packages)} ecosystems ({total_batches} batches)...")
   288	
   289	    if dry_run:
   290	        print(f"  OSV: [dry-run] would query {total_queries} packages")
   291	        return 0
   292	
   293	    for i in range(0, total_queries, batch_size):
   294	        batch = all_queries[i : i + batch_size]
   295	        batch_num = i // batch_size + 1
   296	
   297	        payload = {"queries": batch}
   298	        resp = api_request(f"{api_url}/querybatch", method="POST", data=payload, timeout=120)
   299	
   300	        if resp is None:
   301	            # Fallback: query individually for this batch
   302	            print(f"  OSV: querybatch failed for batch {batch_num}, falling back to individual queries...")
   303	            for query in batch:
   304	                individual_resp = api_request(
   305	                    f"{api_url}/query", method="POST", data=query
   306	                )
   307	                if individual_resp is None:
   308	                    continue
   309	                for vuln in individual_resp.get("vulns", []):
   310	                    added += _process_osv_vuln(vuln, existing_vulns)
   311	                time.sleep(0.25)
   312	        else:
   313	            # Process batch results — response is {"results": [{"vulns": [...]}, ...]}
   314	            results = resp.get("results", [])
   315	            for result in results:
   316	                for vuln in result.get("vulns", []):
   317	                    added += _process_osv_vuln(vuln, existing_vulns)
   318	
   319	        print(f"  OSV: batch {batch_num}/{total_batches} done (+{added} so far)")
   320	        time.sleep(1)
   321	
   322	    if not dry_run:
   323	        cache["vulnerabilities"] = list(existing_vulns.values())
   324	        cache["last_modified"] = datetime.now(timezone.utc).isoformat()
   325	        save_cache("osv-cache.json", cache)
   326	
   327	    print(f"  OSV: +{added} new")
   328	    return added
   329	
   330	
   331	# ---------------------------------------------------------------------------
   332	# GitHub Security Advisories
   333	# ---------------------------------------------------------------------------
   334	def sync_github(config, start_date, dry_run=False):
   335	    """Fetch advisories from GitHub Security Advisories."""
   336	    source = config["sync_sources"]["github"]
   337	    if not source.get("enabled"):
   338	        print("  GitHub: disabled, skipping")
   339	        return 0
   340	
   341	    api_url = source["api_url"]
   342	    ecosystems = source.get("ecosystems", [])
   343	
   344	    # GitHub token for higher rate limits (optional)
   345	    headers = {"Accept": "application/vnd.github+json"}
   346	    gh_token = os.environ.get("GITHUB_TOKEN")
   347	    if gh_token:
   348	        headers["Authorization"] = f"Bearer {gh_token}"
   349	        print("  GitHub: using GITHUB_TOKEN")
   350	
   351	    cache = load_cache("github-advisories.json")
   352	    existing = {a["ghsa_id"]: a for a in cache.get("advisories", [])}
   353	    added = 0
   354	
   355	    # GitHub API uses range format: updated=YYYY-MM-DD..YYYY-MM-DD or >=YYYY-MM-DD
   356	    since_date = start_date.strftime("%Y-%m-%d")
   357	
   358	    max_pages = 10  # Cap pagination to avoid exhausting rate limit (10 pages × 100 = 1000 per ecosystem)
   359	
   360	    for ecosystem in ecosystems:
   361	        print(f"  GitHub: fetching {ecosystem}...")
   362	        if dry_run:
   363	            print(f"  GitHub: [dry-run] would fetch {ecosystem}")
   364	            continue
   365	
   366	        page = 1
   367	        while page <= max_pages:
   368	            url = f"{api_url}?ecosystem={ecosystem}&per_page=100&updated=>={since_date}&page={page}"
   369	            resp = api_request(url, headers=headers)
   370	            if resp is None:
   371	                print(f"  GitHub: failed for {ecosystem} (page {page}), continuing...")
   372	                break
   373	
   374	            if not isinstance(resp, list):
   375	                print(f"  GitHub: unexpected response for {ecosystem}")
   376	                break
   377	
   378	            if not resp:
   379	                break  # Empty page = no more results
   380	
   381	            for advisory in resp:
   382	                ghsa_id = advisory.get("ghsa_id", "")
   383	                if not ghsa_id:
   384	                    continue
   385	
   386	                entry = {
   387	                    "ghsa_id": ghsa_id,
   388	                    "cve_id": advisory.get("cve_id"),
   389	                    "summary": advisory.get("summary", ""),
   390	                    "severity": advisory.get("severity", ""),
   391	                    "cvss_score": (advisory.get("cvss", {}) or {}).get("score"),
   392	                    "cwes": [c.get("cwe_id", "") for c in (advisory.get("cwes", []) or [])],
   393	                    "ecosystem": ecosystem,
   394	                    "published_at": advisory.get("published_at"),
   395	                    "updated_at": advisory.get("updated_at"),
   396	                    "source": "github",
   397	                }
   398	
   399	                if ghsa_id in existing:
   400	                    existing[ghsa_id] = entry
   401	                else:
   402	                    existing[ghsa_id] = entry
   403	                    added += 1
   404	
   405	            # Next page if we got a full page of results
   406	            if len(resp) < 100:
   407	                break
   408	            page += 1
   409	            time.sleep(1)
   410	
   411	    if not dry_run:
   412	        cache["advisories"] = list(existing.values())
   413	        cache["last_modified"] = datetime.now(timezone.utc).isoformat()
   414	        save_cache("github-advisories.json", cache)
   415	
   416	    print(f"  GitHub: +{added} new")
   417	    return added
   418	
   419	
   420	# ---------------------------------------------------------------------------
   421	# EPSS (Exploit Prediction Scoring System)
   422	# ---------------------------------------------------------------------------
   423	def sync_epss(config, dry_run=False):
   424	    """Enrich cached CVEs with EPSS scores."""
   425	    source = config["sync_sources"]["epss"]
   426	    if not source.get("enabled"):
   427	        print("  EPSS: disabled, skipping")
   428	        return 0
   429	
   430	    api_url = source["api_url"]
   431	
   432	    # Collect all CVE IDs from NVD and GitHub caches
   433	    cve_ids = set()
   434	
   435	    nvd_cache = load_cache("nvd-cache.json")
   436	    for v in nvd_cache.get("vulnerabilities", []):
   437	        cve_id = v.get("cve_id", "")
   438	        if cve_id.startswith("CVE-"):
   439	            cve_ids.add(cve_id)
   440	
   441	    gh_cache = load_cache("github-advisories.json")
   442	    for a in gh_cache.get("advisories", []):
   443	        cve_id = a.get("cve_id", "")
   444	        if cve_id and cve_id.startswith("CVE-"):
   445	            cve_ids.add(cve_id)
   446	
   447	    if not cve_ids:
   448	        print("  EPSS: no CVE IDs to enrich")
   449	        return 0
   450	
   451	    print(f"  EPSS: enriching {len(cve_ids)} CVEs...")
   452	    if dry_run:
   453	        print(f"  EPSS: [dry-run] would fetch scores for {len(cve_ids)} CVEs")
   454	        return 0
   455	
   456	    # EPSS API accepts up to 100 CVEs per request
   457	    cve_list = list(cve_ids)
   458	    epss_scores = {}
   459	    batch_size = 100
   460	
   461	    for i in range(0, len(cve_list), batch_size):
   462	        batch = cve_list[i : i + batch_size]
   463	        cve_param = ",".join(batch)
   464	        url = f"{api_url}?cve={cve_param}"
   465	
   466	        resp = api_request(url)
   467	        if resp is None:
   468	            continue
   469	
   470	        for entry in resp.get("data", []):
   471	            cve_id = entry.get("cve", "")
   472	            if cve_id:
   473	                epss_scores[cve_id] = {
   474	                    "score": float(entry.get("epss", 0)),
   475	                    "percentile": float(entry.get("percentile", 0)),
   476	                }
   477	
   478	        time.sleep(1)
   479	
   480	    # Enrich NVD cache
   481	    enriched = 0
   482	    for v in nvd_cache.get("vulnerabilities", []):
   483	        cve_id = v.get("cve_id", "")
   484	        if cve_id in epss_scores:
   485	            v["epss"] = epss_scores[cve_id]
   486	            enriched += 1
   487	
   488	    save_cache("nvd-cache.json", nvd_cache)
   489	
   490	    # Enrich GitHub cache
   491	    for a in gh_cache.get("advisories", []):
   492	        cve_id = a.get("cve_id", "")
   493	        if cve_id and cve_id in epss_scores:
   494	            a["epss"] = epss_scores[cve_id]
   495	
   496	    save_cache("github-advisories.json", gh_cache)
   497	
   498	    print(f"  EPSS: enriched {enriched} CVEs with scores")
   499	    return enriched
   500	
   501	
   502	# ---------------------------------------------------------------------------
   503	# CISA Known Exploited Vulnerabilities (KEV)
   504	# ---------------------------------------------------------------------------
   505	def sync_kev(config, dry_run=False):
   506	    """Fetch CISA Known Exploited Vulnerabilities catalog and enrich NVD cache."""
   507	    source = config["sync_sources"]["kev"]
   508	    if not source.get("enabled"):
   509	        print("  KEV: disabled, skipping")
   510	        return 0
   511	
   512	    api_url = source["api_url"]
   513	
   514	    print(f"  KEV: fetching catalog...")
   515	    if dry_run:
   516	        print(f"  KEV: [dry-run] would fetch {api_url}")
   517	        return 0
   518	
   519	    resp = api_request(api_url)
   520	    if resp is None:
   521	        print("  KEV: API error, stopping KEV sync")
   522	        return 0
   523	
   524	    kev_vulns = resp.get("vulnerabilities", [])
   525	    if not kev_vulns:
   526	        print("  KEV: no vulnerabilities in catalog")
   527	        return 0
   528	
   529	    # Load existing caches
   530	    kev_cache = load_cache("kev-catalog.json")
   531	    nvd_cache = load_cache("nvd-cache.json")
   532	
   533	    # Index NVD entries by CVE ID for fast lookup
   534	    nvd_by_cve = {v["cve_id"]: v for v in nvd_cache.get("vulnerabilities", [])}
   535	
   536	    # Process KEV entries
   537	    added = 0
   538	    kev_entries = []
   539	    enriched_nvd = 0
   540	
   541	    for vuln in kev_vulns:
   542	        cve_id = vuln.get("cveID", "")
   543	        if not cve_id:
   544	            continue
   545	
   546	        entry = {
   547	            "cve_id": cve_id,
   548	            "vendor_project": vuln.get("vendorProject", ""),
   549	            "product": vuln.get("product", ""),
   550	            "vulnerability_name": vuln.get("vulnerabilityName", ""),
   551	            "date_added": vuln.get("dateAdded", ""),
   552	            "known_ransomware_campaign_use": vuln.get("knownRansomwareCampaignUse", False),
   553	            "required_action": vuln.get("requiredAction", ""),
   554	            "source": "cisa-kev",
   555	        }
   556	        kev_entries.append(entry)
   557	        added += 1
   558	
   559	        # Enrich NVD cache entry if it exists
   560	        if cve_id in nvd_by_cve:
   561	            nvd_by_cve[cve_id]["kev"] = True
   562	            enriched_nvd += 1
   563	
   564	    # Save KEV catalog
   565	    kev_cache["vulnerabilities"] = kev_entries
   566	    kev_cache["total"] = len(kev_entries)
   567	    kev_cache["last_modified"] = datetime.now(timezone.utc).isoformat()
   568	    save_cache("kev-catalog.json", kev_cache)
   569	
   570	    # Save enriched NVD cache
   571	    if enriched_nvd > 0:
   572	        nvd_cache["vulnerabilities"] = list(nvd_by_cve.values())
   573	        nvd_cache["last_modified"] = datetime.now(timezone.utc).isoformat()
   574	        save_cache("nvd-cache.json", nvd_cache)
   575	
   576	    print(f"  KEV: +{added} vulnerabilities, enriched {enriched_nvd} NVD entries")
   577	    return added
   578	
   579	
   580	# ---------------------------------------------------------------------------
   581	# OWASP/CWE Standards Auto-Sync
   582	# ---------------------------------------------------------------------------
   583	def sync_standards(config, dry_run=False):
   584	    """Check GitHub repos for OWASP/CWE standards updates."""
   585	    source = config["sync_sources"].get("owasp")
   586	    if not source or not source.get("enabled"):
   587	        print("  OWASP: disabled, skipping")
   588	        return 0
   589	
   590	    repos = source.get("repos", {})
   591	    if not repos:
   592	        print("  OWASP: no repos configured")
   593	        return 0
   594	
   595	    # GitHub token for higher rate limits (optional)
   596	    headers = {"Accept": "application/vnd.github+json"}
   597	    gh_token = os.environ.get("GITHUB_TOKEN")
   598	    if gh_token:
   599	        headers["Authorization"] = f"Bearer {gh_token}"
   600	        print("  OWASP: using GITHUB_TOKEN")
   601	
   602	    updates_found = []
   603	    checked = 0
   604	
   605	    for repo_key, repo_config in repos.items():
   606	        repo = repo_config.get("repo", "")
   607	        current_version = repo_config.get("current_version", "")
   608	        standards_file = repo_config.get("standards_file", "")
   609	
   610	        if not repo or not current_version or not standards_file:
   611	            print(f"  OWASP: {repo_key} missing required fields, skipping")
   612	            continue
   613	
   614	        print(f"  OWASP: checking {repo}...")
   615	        checked += 1
   616	
   617	        if dry_run:
   618	            print(f"  OWASP: [dry-run] would check {repo} releases")
   619	            continue
   620	
   621	        # Try to fetch latest release first
   622	        release_url = f"https://api.github.com/repos/{repo}/releases/latest"
   623	        resp = api_request(release_url, headers=headers)
   624	
   625	        latest_version = None
   626	        if resp is not None and "tag_name" in resp:
   627	            # Extract version from tag (e.g., "v2025" -> "2025", "2025" -> "2025")
   628	            tag = resp.get("tag_name", "")
   629	            latest_version = tag.lstrip("v")
   630	        else:
   631	            # Fallback: fetch latest tag
   632	            tags_url = f"https://api.github.com/repos/{repo}/tags?per_page=1"
   633	            resp = api_request(tags_url, headers=headers)
   634	            if resp is not None and isinstance(resp, list) and len(resp) > 0:
   635	                tag = resp[0].get("name", "")
   636	                latest_version = tag.lstrip("v")
   637	
   638	        if latest_version and latest_version != current_version:
   639	            updates_found.append({
   640	                "repo": repo,
   641	                "repo_key": repo_key,
   642	                "standards_file": standards_file,
   643	                "current_version": current_version,
   644	                "latest_version": latest_version,
   645	                "checked_at": datetime.now(timezone.utc).isoformat(),
   646	            })
   647	            print(f"  OWASP: {repo_key}: update available {current_version} → {latest_version}")
   648	        else:
   649	            print(f"  OWASP: {repo_key}: up-to-date ({current_version})")
   650	
   651	        time.sleep(1)
   652	
   653	    # Write pending updates to standards directory
   654	    if updates_found:
   655	        pending_path = os.path.join(STANDARDS_DIR, "pending-updates.json")
   656	        pending_data = {
   657	            "timestamp": datetime.now(timezone.utc).isoformat(),
   658	            "updates": updates_found,
   659	        }
   660	        if not dry_run:
   661	            with open(pending_path, "w") as f:
   662	                json.dump(pending_data, f, indent=2)
   663	                f.write("\n")
   664	            print(f"  OWASP: wrote {len(updates_found)} updates to pending-updates.json")
   665	
   666	    print(f"  OWASP: checked {checked} repos, {len(updates_found)} updates available")
   667	    return checked
   668	
   669	
   670	# ---------------------------------------------------------------------------
   671	# Main
   672	# ---------------------------------------------------------------------------
   673	def main():
   674	    parser = argparse.ArgumentParser(description="Sentinel CVE Sync")
   675	    parser.add_argument("--dry-run", action="store_true", help="Preview without writing")
   676	    parser.add_argument("--days", type=int, default=None, help="Number of days to look back (default: 30 on first run)")
   677	    args = parser.parse_args()
   678	
   679	    print("=" * 60)
   680	    print("Sentinel CVE Sync")
   681	    print("=" * 60)
   682	
   683	    config = load_config()
   684	
   685	    # Determine start date
   686	    last_sync = config.get("last_sync")
   687	    if args.days:
   688	        start_date = datetime.now(timezone.utc) - timedelta(days=args.days)
   689	        print(f"Looking back {args.days} days (--days override)")
   690	    elif last_sync:
   691	        start_date = datetime.fromisoformat(last_sync.replace("Z", "+00:00"))
   692	        print(f"Syncing since last run: {last_sync}")
   693	    else:
   694	        start_date = datetime.now(timezone.utc) - timedelta(days=30)
   695	        print("First run — fetching last 30 days")
   696	
   697	    if args.dry_run:
   698	        print("[DRY RUN — no files will be written]")
   699	
   700	    print()
   701	    totals = {}
   702	
   703	    # 1. NVD
   704	    print("[1/6] NVD API 2.0")
   705	    totals["nvd"] = sync_nvd(config, start_date, args.dry_run)
   706	
   707	    # 2. OSV
   708	    print("[2/6] OSV API")
   709	    totals["osv"] = sync_osv(config, start_date, args.dry_run)
   710	
   711	    # 3. GitHub Advisories
   712	    print("[3/6] GitHub Security Advisories")
   713	    totals["github"] = sync_github(config, start_date, args.dry_run)
   714	
   715	    # 4. EPSS
   716	    print("[4/6] EPSS Scores")
   717	    totals["epss"] = sync_epss(config, args.dry_run)
   718	
   719	    # 5. KEV
   720	    print("[5/6] CISA KEV Catalog")
   721	    totals["kev"] = sync_kev(config, args.dry_run)
   722	
   723	    # 6. Standards
   724	    print("[6/6] OWASP/CWE Standards")
   725	    totals["standards"] = sync_standards(config, args.dry_run)
   726	
   727	    # Update sync metadata
   728	    if not args.dry_run:
   729	        config["last_sync"] = datetime.now(timezone.utc).isoformat()
   730	        config["last_sync_status"] = {
   731	            "timestamp": datetime.now(timezone.utc).isoformat(),
   732	            "results": totals,
   733	            "success": True,
   734	        }
   735	        save_config(config)
   736	
   737	    # Summary
   738	    print()
   739	    print("=" * 60)
   740	    print("Summary:")
   741	    for source, count in totals.items():
   742	        print(f"  {source}: {count} entries processed")
   743	    total = sum(totals.values())
   744	    print(f"  Total: {total}")
   745	    print("=" * 60)
   746	
   747	    return 0
   748	
   749	
   750	if __name__ == "__main__":
   751	    sys.exit(main())

FILE scripts/feedback-loop.py
     1	#!/usr/bin/env python3
     2	"""
     3	Sentinel Feedback Loop — FP/TP ingestion, confidence scoring, cross-domain propagation.
     4	
     5	Processes scan feedback to improve rule quality over time.
     6	
     7	Subcommands:
     8	    ingest     Record TP/FP verdicts from scan results
     9	    seed       Auto-seed feedback from rule-tester.py results (Phase 3 data)
    10	    score      Recalculate confidence scores from accumulated feedback
    11	    propagate  Share validated patterns across domains with same CWE
    12	    report     Show feedback stats and confidence changes
    13	
    14	Usage:
    15	    python3 scripts/feedback-loop.py ingest --rule CVE-XXX --verdict tp --file src/app.js --line 42
    16	    python3 scripts/feedback-loop.py seed                    # Seed from Phase 3 test results
    17	    python3 scripts/feedback-loop.py score                   # Recalculate confidence
    18	    python3 scripts/feedback-loop.py score --dry-run         # Preview changes
    19	    python3 scripts/feedback-loop.py propagate               # Cross-domain propagation
    20	    python3 scripts/feedback-loop.py propagate --apply       # Apply propagation
    21	    python3 scripts/feedback-loop.py report                  # Show stats
    22	"""
    23	from __future__ import annotations
    24	
    25	
    26	import argparse
    27	import glob
    28	import json
    29	import os
    30	import re
    31	import sys
    32	from collections import Counter, defaultdict
    33	from datetime import datetime, timezone
    34	
    35	SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
    36	PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
    37	KB_DIR = os.path.join(PROJECT_ROOT, "knowledge-base")
    38	DOMAINS_DIR = os.path.join(KB_DIR, "domains")
    39	FEEDBACK_PATH = os.path.join(KB_DIR, "feedback", "feedback.json")
    40	FIXTURES_DIR = os.path.join(PROJECT_ROOT, "tests", "fixtures")
    41	VULN_APP_DIR = os.path.join(PROJECT_ROOT, "tests", "vulnerable-app", "src")
    42	
    43	# Confidence thresholds
    44	MIN_FEEDBACK_FOR_UPDATE = 3     # Minimum feedback entries before adjusting confidence
    45	DEMOTE_THRESHOLD = 0.3          # Demote to "needs-review" if confidence drops below this
    46	PROMOTE_THRESHOLD = 0.7         # Promote to "active" if confidence rises above this
    47	PROPAGATE_MIN_CONFIDENCE = 0.7  # Only propagate patterns from rules above this confidence
    48	
    49	
    50	# ===========================================================================
    51	# Feedback storage
    52	# ===========================================================================
    53	
    54	def load_feedback():
    55	    """Load feedback entries from disk."""
    56	    if not os.path.exists(FEEDBACK_PATH):
    57	        return {"version": 1, "entries": []}
    58	    with open(FEEDBACK_PATH) as f:
    59	        return json.load(f)
    60	
    61	
    62	def save_feedback(data):
    63	    """Save feedback entries to disk."""
    64	    os.makedirs(os.path.dirname(FEEDBACK_PATH), exist_ok=True)
    65	    with open(FEEDBACK_PATH, "w") as f:
    66	        json.dump(data, f, indent=2)
    67	        f.write("\n")
    68	
    69	
    70	# ===========================================================================
    71	# Rule loading
    72	# ===========================================================================
    73	
    74	def load_all_cve_rules():
    75	    """Load all CVE rules across all domains."""
    76	    rules = {}
    77	    for path in sorted(glob.glob(os.path.join(DOMAINS_DIR, "*", "cve-rules.json"))):
    78	        domain = os.path.basename(os.path.dirname(path))
    79	        with open(path) as f:
    80	            domain_rules = json.load(f)
    81	        for r in domain_rules:
    82	            r["_source_path"] = path
    83	            r["_domain"] = domain
    84	            rules[r["id"]] = r
    85	    return rules
    86	
    87	
    88	def load_domain_rules():
    89	    """Load curated domain rules (rules.json, not cve-rules.json)."""
    90	    rules = {}
    91	    for path in sorted(glob.glob(os.path.join(DOMAINS_DIR, "*", "rules.json"))):
    92	        domain = os.path.basename(os.path.dirname(path))
    93	        with open(path) as f:
    94	            domain_rules = json.load(f)
    95	        for r in domain_rules:
    96	            r["_source_path"] = path
    97	            r["_domain"] = domain
    98	            rules[r["id"]] = r
    99	    return rules
   100	
   101	
   102	def save_rules_to_file(path, rules_list):
   103	    """Save rules list back to a cve-rules.json file."""
   104	    # Strip internal fields
   105	    clean = []
   106	    for r in rules_list:
   107	        clean.append({k: v for k, v in r.items() if not k.startswith("_")})
   108	    with open(path, "w") as f:
   109	        json.dump(clean, f, indent=2)
   110	        f.write("\n")
   111	
   112	
   113	# ===========================================================================
   114	# Subcommand: ingest
   115	# ===========================================================================
   116	
   117	def cmd_ingest(args):
   118	    """Record a single TP/FP feedback entry."""
   119	    feedback = load_feedback()
   120	
   121	    entry = {
   122	        "rule_id": args.rule,
   123	        "verdict": args.verdict,
   124	        "file": args.file or "",
   125	        "line": args.line or 0,
   126	        "pattern": args.pattern or "",
   127	        "context": args.context or "",
   128	        "project": args.project or "",
   129	        "timestamp": datetime.now(timezone.utc).isoformat(),
   130	    }
   131	
   132	    feedback["entries"].append(entry)
   133	    save_feedback(feedback)
   134	
   135	    total = len(feedback["entries"])
   136	    print(f"Recorded {args.verdict.upper()} for {args.rule} ({total} total entries)")
   137	
   138	
   139	# ===========================================================================
   140	# Subcommand: seed
   141	# ===========================================================================
   142	
   143	def cmd_seed(args):
   144	    """Auto-seed feedback from rule-tester.py Phase 3 test results.
   145	
   146	    Re-runs the pattern matching against the test corpus and records
   147	    each match as TP (vulnerable corpus) or FP (safe corpus).
   148	    """
   149	    feedback = load_feedback()
   150	    existing_count = len(feedback["entries"])
   151	
   152	    rules = load_all_cve_rules()
   153	    now = datetime.now(timezone.utc).isoformat()
   154	
   155	    # Load corpus files
   156	    vuln_files = _load_files(os.path.join(FIXTURES_DIR, "vulnerable"))
   157	    vuln_files += _load_files(VULN_APP_DIR)
   158	    safe_files = _load_files(os.path.join(FIXTURES_DIR, "safe"))
   159	
   160	    added = 0
   161	    # Only seed for rules that have been tested (have test_precision)
   162	    for rule_id, rule in rules.items():
   163	        if "test_precision" not in rule:
   164	            continue
   165	
   166	        patterns = rule.get("detect", {}).get("patterns", [])
   167	        negative_patterns = rule.get("detect", {}).get("negative_patterns", [])
   168	        file_types = rule.get("detect", {}).get("file_types", [])
   169	
   170	        # Scan vulnerable files → TP
   171	        for file_info in vuln_files:
   172	            if not _file_matches(file_info["filename"], file_types):
   173	                continue
   174	            for line_num, line in enumerate(file_info["lines"], 1):
   175	                for pattern in patterns:
   176	                    try:
   177	                        if re.search(pattern, line) and not _is_mitigated(line, negative_patterns):
   178	                            feedback["entries"].append({
   179	                                "rule_id": rule_id,
   180	                                "verdict": "tp",
   181	                                "file": file_info["filename"],
   182	                                "line": line_num,
   183	                                "pattern": pattern,
   184	                                "context": line.strip()[:120],
   185	                                "project": "sentinel-fixtures",
   186	                                "timestamp": now,
   187	                            })
   188	                            added += 1
   189	                    except re.error:
   190	                        pass
   191	
   192	        # Scan safe files → FP
   193	        for file_info in safe_files:
   194	            if not _file_matches(file_info["filename"], file_types):
   195	                continue
   196	            for line_num, line in enumerate(file_info["lines"], 1):
   197	                for pattern in patterns:
   198	                    try:
   199	                        if re.search(pattern, line) and not _is_mitigated(line, negative_patterns):
   200	                            feedback["entries"].append({
   201	                                "rule_id": rule_id,
   202	                                "verdict": "fp",
   203	                                "file": file_info["filename"],
   204	                                "line": line_num,
   205	                                "pattern": pattern,
   206	                                "context": line.strip()[:120],
   207	                                "project": "sentinel-fixtures",
   208	                                "timestamp": now,
   209	                            })
   210	                            added += 1
   211	                    except re.error:
   212	                        pass
   213	
   214	    save_feedback(feedback)
   215	    print(f"Seeded {added} feedback entries from test corpus")
   216	    print(f"Total entries: {len(feedback['entries'])} (was {existing_count})")
   217	
   218	
   219	def _load_files(directory):
   220	    """Load source files from directory."""
   221	    files = []
   222	    if not os.path.isdir(directory):
   223	        return files
   224	    for root, _, filenames in os.walk(directory):
   225	        for fname in filenames:
   226	            fpath = os.path.join(root, fname)
   227	            try:
   228	                with open(fpath, encoding="utf-8", errors="replace") as f:
   229	                    content = f.read()
   230	                files.append({"filename": fname, "lines": content.splitlines()})
   231	            except IOError:
   232	                pass
   233	    return files
   234	
   235	
   236	def _file_matches(filename, file_types):
   237	    """Check if filename matches file_types globs."""
   238	    if not file_types:
   239	        return True
   240	    for ft in file_types:
   241	        if ft.startswith("*.") and filename.endswith(ft[1:]):
   242	            return True
   243	    return False
   244	
   245	
   246	def _is_mitigated(line, negative_patterns):
   247	    """Check if line matches any negative pattern."""
   248	    for neg in negative_patterns:
   249	        try:
   250	            if re.search(neg, line):
   251	                return True
   252	        except re.error:
   253	            pass
   254	    return False
   255	
   256	
   257	# ===========================================================================
   258	# Subcommand: score
   259	# ===========================================================================
   260	
   261	def cmd_score(args):
   262	    """Recalculate confidence scores from accumulated feedback."""
   263	    feedback = load_feedback()
   264	    rules = load_all_cve_rules()
   265	
   266	    if not feedback["entries"]:
   267	        print("No feedback entries. Run 'seed' or 'ingest' first.")
   268	        return
   269	
   270	    # Aggregate feedback per rule
   271	    rule_stats = defaultdict(lambda: {"tp": 0, "fp": 0, "patterns": defaultdict(lambda: {"tp": 0, "fp": 0})})
   272	
   273	    for entry in feedback["entries"]:
   274	        rid = entry["rule_id"]
   275	        verdict = entry["verdict"]
   276	        pattern = entry.get("pattern", "")
   277	
   278	        if verdict == "tp":
   279	            rule_stats[rid]["tp"] += 1
   280	            if pattern:
   281	                rule_stats[rid]["patterns"][pattern]["tp"] += 1
   282	        elif verdict == "fp":
   283	            rule_stats[rid]["fp"] += 1
   284	            if pattern:
   285	                rule_stats[rid]["patterns"][pattern]["fp"] += 1
   286	
   287	    # Calculate new confidence scores
   288	    updates = []
   289	    for rid, stats in sorted(rule_stats.items()):
   290	        if rid not in rules:
   291	            continue
   292	
   293	        rule = rules[rid]
   294	        old_confidence = rule.get("confidence", 0.5)
   295	        old_status = rule.get("status", "unknown")
   296	        tp = stats["tp"]
   297	        fp = stats["fp"]
   298	        total = tp + fp
   299	
   300	        if total < MIN_FEEDBACK_FOR_UPDATE:
   301	            continue
   302	
   303	        # Bayesian confidence: Laplace-smoothed precision weighted by base confidence
   304	        # factor = (tp + 1) / (tp + fp + 2)  → converges to precision with more data
   305	        bayesian_factor = (tp + 1) / (tp + fp + 2)
   306	
   307	        # Blend: 30% base confidence + 70% empirical
   308	        new_confidence = round(0.3 * old_confidence + 0.7 * bayesian_factor, 3)
   309	
   310	        # Determine status change
   311	        new_status = old_status
   312	        if new_confidence < DEMOTE_THRESHOLD and old_status == "active":
   313	            new_status = "needs-review"
   314	        elif new_confidence >= PROMOTE_THRESHOLD and old_status in ("needs-review", "no-matches"):
   315	            new_status = "active"
   316	
   317	        # Identify worst patterns (FP-heavy)
   318	        worst_patterns = []
   319	        for pat, pat_stats in stats["patterns"].items():
   320	            if pat_stats["fp"] > 0:
   321	                pat_prec = pat_stats["tp"] / (pat_stats["tp"] + pat_stats["fp"])
   322	                if pat_prec < 0.5:
   323	                    worst_patterns.append({
   324	                        "pattern": pat[:60],
   325	                        "tp": pat_stats["tp"],
   326	                        "fp": pat_stats["fp"],
   327	                        "precision": round(pat_prec, 2),
   328	                    })
   329	
   330	        updates.append({
   331	            "rule_id": rid,
   332	            "domain": rule.get("_domain"),
   333	            "old_confidence": old_confidence,
   334	            "new_confidence": new_confidence,
   335	            "old_status": old_status,
   336	            "new_status": new_status,
   337	            "tp": tp,
   338	            "fp": fp,
   339	            "precision": round(tp / total, 3),
   340	            "worst_patterns": worst_patterns,
   341	            "source_path": rule["_source_path"],
   342	        })
   343	
   344	    # Print results
   345	    print(f"\n{'Rule ID':24s} {'Domain':14s} {'TP':>4s} {'FP':>4s} {'Prec':>6s} "
   346	          f"{'Old Conf':>8s} {'New Conf':>8s} {'Status Change':20s}")
   347	    print("-" * 100)
   348	
   349	    for u in updates:
   350	        status_change = ""
   351	        if u["old_status"] != u["new_status"]:
   352	            status_change = f"{u['old_status']} → {u['new_status']}"
   353	
   354	        print(f"{u['rule_id']:24s} {u['domain']:14s} {u['tp']:4d} {u['fp']:4d} "
   355	              f"{u['precision']:6.1%} {u['old_confidence']:8.3f} {u['new_confidence']:8.3f} "
   356	              f"{status_change:20s}")
   357	
   358	        if u["worst_patterns"]:
   359	            for wp in u["worst_patterns"]:
   360	                print(f"  {'':24s} FP-heavy: {wp['pattern']} "
   361	                      f"(tp={wp['tp']}, fp={wp['fp']}, prec={wp['precision']:.0%})")
   362	
   363	    # Apply
   364	    if args.dry_run:
   365	        print(f"\n--- DRY RUN: no changes applied ---")
   366	        return
   367	
   368	    files_to_update = defaultdict(list)
   369	    for u in updates:
   370	        files_to_update[u["source_path"]].append(u)
   371	
   372	    for path, path_updates in files_to_update.items():
   373	        with open(path) as f:
   374	            all_rules = json.load(f)
   375	
   376	        updates_by_id = {u["rule_id"]: u for u in path_updates}
   377	        for i, r in enumerate(all_rules):
   378	            if r["id"] in updates_by_id:
   379	                u = updates_by_id[r["id"]]
   380	                all_rules[i]["confidence"] = u["new_confidence"]
   381	                if u["old_status"] != u["new_status"]:
   382	                    all_rules[i]["status"] = u["new_status"]
   383	                all_rules[i]["feedback_tp"] = u["tp"]
   384	                all_rules[i]["feedback_fp"] = u["fp"]
   385	                all_rules[i]["feedback_precision"] = u["precision"]
   386	                all_rules[i]["confidence_updated_at"] = datetime.now(timezone.utc).isoformat()
   387	
   388	        with open(path, "w") as f:
   389	            json.dump(all_rules, f, indent=2)
   390	            f.write("\n")
   391	
   392	        domain = os.path.basename(os.path.dirname(path))
   393	        print(f"  Updated {domain}/cve-rules.json: {len(path_updates)} rules")
   394	
   395	    changed_status = sum(1 for u in updates if u["old_status"] != u["new_status"])
   396	    print(f"\nApplied: {len(updates)} confidence updates, {changed_status} status changes")
   397	
   398	
   399	# ===========================================================================
   400	# Subcommand: propagate
   401	# ===========================================================================
   402	
   403	def cmd_propagate(args):
   404	    """Find validated patterns and propagate across domains sharing the same CWE."""
   405	    cve_rules = load_all_cve_rules()
   406	    domain_rules = load_domain_rules()
   407	    all_rules = {**domain_rules, **cve_rules}
   408	
   409	    # Step 1: Collect active rules grouped by CWE
   410	    cwe_patterns = defaultdict(list)  # CWE -> list of (rule_id, domain, patterns, confidence)
   411	
   412	    for rid, rule in all_rules.items():
   413	        if rule.get("status") not in ("active", None):
   414	            # Domain rules (rules.json) don't have status; CVE rules need "active"
   415	            if "_source_path" in rule and "cve-rules" in rule["_source_path"]:
   416	                continue
   417	
   418	        confidence = rule.get("confidence", 0.7)
   419	        if confidence < PROPAGATE_MIN_CONFIDENCE:
   420	            continue
   421	
   422	        patterns = rule.get("detect", {}).get("patterns", [])
   423	        if not patterns:
   424	            continue
   425	
   426	        cwes = [s for s in rule.get("standards", []) if s.startswith("CWE-")]
   427	        domain = rule.get("_domain", "unknown")
   428	
   429	        for cwe in cwes:
   430	            cwe_patterns[cwe].append({
   431	                "rule_id": rid,
   432	                "domain": domain,
   433	                "patterns": patterns,
   434	                "negative_patterns": rule.get("detect", {}).get("negative_patterns", []),
   435	                "file_types": rule.get("detect", {}).get("file_types", []),
   436	                "confidence": confidence,
   437	            })
   438	
   439	    # Step 2: Find propagation opportunities
   440	    # A CWE with rules in multiple domains where some domains have more patterns
   441	    suggestions = []
   442	
   443	    for cwe, sources in sorted(cwe_patterns.items()):
   444	        if len(sources) < 2:
   445	            continue
   446	
   447	        # Group by domain
   448	        by_domain = defaultdict(list)
   449	        for s in sources:
   450	            by_domain[s["domain"]].append(s)
   451	
   452	        if len(by_domain) < 2:
   453	            continue
   454	
   455	        # Find the richest source (most patterns, highest confidence)
   456	        domain_scores = {}
   457	        for domain, domain_sources in by_domain.items():
   458	            total_patterns = sum(len(s["patterns"]) for s in domain_sources)
   459	            max_confidence = max(s["confidence"] for s in domain_sources)
   460	            domain_scores[domain] = (total_patterns, max_confidence)
   461	
   462	        best_domain = max(domain_scores, key=lambda d: domain_scores[d])
   463	        best_sources = by_domain[best_domain]
   464	
   465	        # Collect all unique patterns from the best domain
   466	        best_patterns = set()
   467	        for s in best_sources:
   468	            best_patterns.update(s["patterns"])
   469	
   470	        # Check other domains for missing patterns
   471	        for target_domain, target_sources in by_domain.items():
   472	            if target_domain == best_domain:
   473	                continue
   474	
   475	            target_patterns = set()
   476	            for s in target_sources:
   477	                target_patterns.update(s["patterns"])
   478	
   479	            new_patterns = best_patterns - target_patterns
   480	            if new_patterns:
   481	                suggestions.append({
   482	                    "cwe": cwe,
   483	                    "source_domain": best_domain,
   484	                    "target_domain": target_domain,
   485	                    "target_rules": [s["rule_id"] for s in target_sources],
   486	                    "new_patterns": sorted(new_patterns),
   487	                    "source_confidence": domain_scores[best_domain][1],
   488	                })
   489	
   490	    # Print suggestions
   491	    if not suggestions:
   492	        print("No cross-domain propagation opportunities found.")
   493	        return
   494	
   495	    print(f"\n{'CWE':12s} {'From':14s} {'To':14s} {'New Patterns':>12s} {'Conf':>6s}")
   496	    print("-" * 64)
   497	
   498	    for s in suggestions:
   499	        print(f"{s['cwe']:12s} {s['source_domain']:14s} {s['target_domain']:14s} "
   500	              f"{len(s['new_patterns']):12d} {s['source_confidence']:6.2f}")
   501	        for p in s["new_patterns"][:5]:
   502	            print(f"  {'':12s} + {p[:70]}")
   503	        if len(s["new_patterns"]) > 5:
   504	            print(f"  {'':12s} ... and {len(s['new_patterns']) - 5} more")
   505	        print(f"  {'':12s} Target rules: {', '.join(s['target_rules'][:3])}")
   506	
   507	    print(f"\nTotal: {len(suggestions)} propagation opportunities, "
   508	          f"{sum(len(s['new_patterns']) for s in suggestions)} new patterns")
   509	
   510	    if not args.apply:
   511	        print("\n--- Preview only. Use --apply to propagate patterns ---")
   512	        return
   513	
   514	    # Apply propagation
   515	    applied = 0
   516	    files_modified = set()
   517	
   518	    for s in suggestions:
   519	        for target_rid in s["target_rules"]:
   520	            if target_rid not in all_rules:
   521	                continue
   522	            rule = all_rules[target_rid]
   523	            current_patterns = rule.get("detect", {}).get("patterns", [])
   524	            added = [p for p in s["new_patterns"] if p not in current_patterns]
   525	            if not added:
   526	                continue
   527	
   528	            rule["detect"]["patterns"].extend(added)
   529	            rule["propagated_from"] = s["source_domain"]
   530	            rule["propagated_at"] = datetime.now(timezone.utc).isoformat()
   531	            rule["propagated_patterns"] = added
   532	            files_modified.add(rule["_source_path"])
   533	            applied += len(added)
   534	
   535	    # Save modified files
   536	    for path in files_modified:
   537	        with open(path) as f:
   538	            all_file_rules = json.load(f)
   539	
   540	        for i, r in enumerate(all_file_rules):
   541	            if r["id"] in all_rules:
   542	                updated = all_rules[r["id"]]
   543	                if "propagated_from" in updated:
   544	                    all_file_rules[i]["detect"] = {k: v for k, v in updated["detect"].items()
   545	                                                    if not k.startswith("_")}
   546	                    all_file_rules[i]["propagated_from"] = updated["propagated_from"]
   547	                    all_file_rules[i]["propagated_at"] = updated["propagated_at"]
   548	                    all_file_rules[i]["propagated_patterns"] = updated["propagated_patterns"]
   549	
   550	        with open(path, "w") as f:
   551	            json.dump(all_file_rules, f, indent=2)
   552	            f.write("\n")
   553	
   554	        domain = os.path.basename(os.path.dirname(path))
   555	        print(f"  Updated {domain}/cve-rules.json")
   556	
   557	    print(f"\nApplied {applied} propagated patterns across {len(files_modified)} files")
   558	
   559	
   560	# ===========================================================================
   561	# Subcommand: report
   562	# ===========================================================================
   563	
   564	def cmd_report(args):
   565	    """Show feedback statistics and rule health."""
   566	    feedback = load_feedback()
   567	    rules = load_all_cve_rules()
   568	
   569	    entries = feedback.get("entries", [])
   570	    if not entries:
   571	        print("No feedback entries yet. Run 'seed' or 'ingest' first.")
   572	        return
   573	
   574	    # Overall stats
   575	    verdicts = Counter(e["verdict"] for e in entries)
   576	    projects = Counter(e.get("project", "unknown") for e in entries)
   577	    rules_with_feedback = Counter(e["rule_id"] for e in entries)
   578	
   579	    print("=" * 60)
   580	    print("Sentinel Feedback Report")
   581	    print("=" * 60)
   582	
   583	    print(f"\nTotal entries: {len(entries)}")
   584	    print(f"  True positives:  {verdicts.get('tp', 0)}")
   585	    print(f"  False positives: {verdicts.get('fp', 0)}")
   586	    overall_prec = verdicts["tp"] / (verdicts["tp"] + verdicts["fp"]) if verdicts["tp"] + verdicts["fp"] > 0 else 0
   587	    print(f"  Overall precision: {overall_prec:.1%}")
   588	
   589	    print(f"\nRules with feedback: {len(rules_with_feedback)}")
   590	    print(f"Projects: {', '.join(f'{p}={c}' for p, c in projects.most_common(5))}")
   591	
   592	    # Per-rule breakdown
   593	    print(f"\n{'Rule ID':24s} {'Domain':14s} {'TP':>4s} {'FP':>4s} {'Prec':>6s} {'Conf':>6s} {'Status':12s}")
   594	    print("-" * 80)
   595	
   596	    rule_stats = defaultdict(lambda: {"tp": 0, "fp": 0})
   597	    for e in entries:
   598	        rule_stats[e["rule_id"]][e["verdict"]] += 1
   599	
   600	    for rid, stats in sorted(rule_stats.items(), key=lambda x: -(x[1]["tp"] + x[1]["fp"])):
   601	        rule = rules.get(rid, {})
   602	        tp = stats.get("tp", 0)
   603	        fp = stats.get("fp", 0)
   604	        total = tp + fp
   605	        prec = tp / total if total > 0 else 0
   606	        conf = rule.get("confidence", 0)
   607	        domain = rule.get("_domain", "?")
   608	        status = rule.get("status", "?")
   609	
   610	        print(f"{rid:24s} {domain:14s} {tp:4d} {fp:4d} {prec:6.1%} {conf:6.2f} {status:12s}")
   611	
   612	    # Pattern-level stats (top FP patterns)
   613	    pattern_stats = defaultdict(lambda: {"tp": 0, "fp": 0, "rules": set()})
   614	    for e in entries:
   615	        if e.get("pattern"):
   616	            pat = e["pattern"][:80]
   617	            pattern_stats[pat][e["verdict"]] += 1
   618	            pattern_stats[pat]["rules"].add(e["rule_id"])
   619	
   620	    fp_heavy = [(pat, s) for pat, s in pattern_stats.items()
   621	                if s["fp"] > 0 and s["tp"] / (s["tp"] + s["fp"]) < 0.5]
   622	
   623	    if fp_heavy:
   624	        print(f"\n--- FP-Heavy Patterns (precision < 50%) ---")
   625	        for pat, s in sorted(fp_heavy, key=lambda x: x[1]["fp"], reverse=True)[:10]:
   626	            prec = s["tp"] / (s["tp"] + s["fp"])
   627	            print(f"  {pat[:60]:60s} tp={s['tp']} fp={s['fp']} prec={prec:.0%}")
   628	
   629	    print(f"\n{'=' * 60}")
   630	
   631	
   632	# ===========================================================================
   633	# Main
   634	# ===========================================================================
   635	
   636	def main():
   637	    parser = argparse.ArgumentParser(
   638	        description="Sentinel Feedback Loop — FP/TP ingestion, confidence scoring, cross-domain propagation")
   639	    subparsers = parser.add_subparsers(dest="command", help="Subcommand")
   640	
   641	    # ingest
   642	    p_ingest = subparsers.add_parser("ingest", help="Record a TP/FP feedback entry")
   643	    p_ingest.add_argument("--rule", required=True, help="Rule ID (e.g., CVE-2021-22054)")
   644	    p_ingest.add_argument("--verdict", required=True, choices=["tp", "fp"], help="True positive or false positive")
   645	    p_ingest.add_argument("--file", help="Source file where match occurred")
   646	    p_ingest.add_argument("--line", type=int, help="Line number")
   647	    p_ingest.add_argument("--pattern", help="The specific regex pattern that matched")
   648	    p_ingest.add_argument("--context", help="Matched line content")
   649	    p_ingest.add_argument("--project", help="Project name")
   650	
   651	    # seed
   652	    p_seed = subparsers.add_parser("seed", help="Auto-seed feedback from rule-tester.py results")
   653	
   654	    # score
   655	    p_score = subparsers.add_parser("score", help="Recalculate confidence from feedback")
