{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_SCRIPT_CAPS": "500"
  },
  "permissions": {
    "allow": [
      "ExitPlanMode",
      "EnterPlanMode",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "Bash",
      "Agent",
      "WebFetch",
      "WebSearch",
      "NotebookEdit",
      "mcp__claude-in-chrome__computer",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__form_input",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__claude-in-chrome__gif_creator",
      "mcp__claude-in-chrome__javascript_tool",
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__resize_window",
      "mcp__claude-in-chrome__shortcuts_execute",
      "mcp__claude-in-chrome__shortcuts_list",
      "mcp__claude-in-chrome__switch_browser",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "mcp__claude-in-chrome__upload_image",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__sentinel-scanner__scan-dependencies",
      "mcp__sentinel-scanner__scan-headers",
      "mcp__sentinel-scanner__generate-sbom"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "higgsfield-marketplace-cards": "off",
    "higgsfield-product-photoshoot": "off",
    "higgsfield-websites": "off",
    "higgsfield-soul-id": "off",
    "sentinel-rag": "off",
    "b974-photo-transform": "off",
    "video-production": "off",
    "skill-audit": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun /Users/manuelturpin/.claude/scripts/command-validator/src/cli.ts"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/manuelturpin/.claude/hooks/git-credential-guard.sh",
            "timeout": 10,
            "statusMessage": "Scanning for credentials..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '[ -f SESSION.md ] && echo \"SESSION.md present in this project — run /start to resume.\" || true'"
          },
          {
            "type": "command",
            "command": "sh -c '[ -f TODO.md ] && echo \"TODO.md présent — des actions sont en attente (voir lab/TODO.md).\" || true'"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date -u +%Y-%m-%dT%H:%M:%SZ)] STOP_FAILURE\" >> ~/.sentinel/reports/audit-trail.log"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date -u +%Y-%m-%dT%H:%M:%SZ)] TASK_CREATED\" >> ~/.sentinel/reports/audit-trail.log"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date -u +%Y-%m-%dT%H:%M:%SZ)] CONFIG_CHANGED\" >> ~/.sentinel/reports/audit-trail.log"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/manuelturpin/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "claude-hud@claude-hud": false,
    "playground@claude-plugins-official": false,
    "telegram@claude-plugins-official": false,
    "act@artchitech-framework": false,
    "claude-md-management@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-security@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "artchitech-framework": {
      "source": {
        "source": "github",
        "repo": "manuelturpin/ArtChiTech-framework"
      }
    }
  },
  "language": "Francais",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "fastModePerSessionOptIn": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
